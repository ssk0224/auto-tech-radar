---
import Layout from "../layouts/Layout.astro";
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title="受託開発・AI導入支援・スポンサーお問い合わせ | Auto Tech Radar" description="海外急上昇OSSを活用した自社AIエージェント構築、社内DXシステム受託開発（単価80万〜250万円）、メディア広告掲載のご相談窓口。">
  <div style="max-width: 800px; margin: 0 auto; padding: 1rem 0 3.5rem;">
    <!-- Breadcrumb -->
    <div style="font-size: 0.85rem; color: #94a3b8; margin-bottom: 1.5rem;">
      <a href={`${baseUrl}/`} style="color: #60a5fa; text-decoration: none;">← トップページに戻る</a>
    </div>

    <!-- Header Banner -->
    <div style="background: linear-gradient(135deg, rgba(30, 27, 75, 0.85) 0%, rgba(15, 23, 42, 0.95) 100%); border: 1px solid #6366f1; border-radius: 16px; padding: 2.5rem 2rem; margin-bottom: 2.5rem; text-align: center;">
      <div style="display: inline-block; background: rgba(99, 102, 241, 0.25); color: #c7d2fe; padding: 0.3rem 0.9rem; border-radius: 9999px; font-size: 0.82rem; font-weight: 700; margin-bottom: 0.8rem;">
        🏢 Enterprise & Direct Consultation
      </div>
      <h1 style="font-size: 2.2rem; font-weight: 900; margin: 0 0 0.8rem; color: #fff; line-height: 1.35;">
        受託開発・AI導入支援 ＆ お問い合わせ
      </h1>
      <p style="font-size: 1.02rem; color: #cbd5e1; margin: 0 auto; max-width: 650px; line-height: 1.75;">
        Auto Tech Radarで紹介している世界の最新急上昇OSSを活用した<strong>自社専用AIエージェント構築、既存SaaSの脱課金リプレイス、社内DXシステム受託開発（80万〜250万円）</strong>を承っております。
      </p>
    </div>

    <!-- 3大コンタクト方法 -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.2rem; margin-bottom: 2.8rem;">
      
      <!-- Option 1: 𝕏 DM -->
      <div style="background: #111827; border: 1px solid #1f2937; border-radius: 12px; padding: 1.6rem; text-align: center; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <div style="font-size: 2rem; margin-bottom: 0.5rem;">⚡</div>
          <h3 style="margin: 0 0 0.4rem; color: #fff; font-size: 1.15rem;">公式 𝕏 (Twitter) DM</h3>
          <p style="font-size: 0.84rem; color: #94a3b8; margin: 0 0 1.2rem; line-height: 1.6;">
            最も迅速にやり取りが可能です。エンジニア・スタートアップ関係者向け。
          </p>
        </div>
        <a href="https://x.com/AutoTechRadar" target="_blank" style="background: #000; border: 1px solid #374151; color: #fff; font-weight: 700; padding: 0.65rem 1.2rem; border-radius: 8px; font-size: 0.88rem; text-decoration: none; display: block;">
          𝕏 (@AutoTechRadar) へDM
        </a>
      </div>

      <!-- Option 2: メール直通 -->
      <div style="background: #111827; border: 1px solid #312e81; border-radius: 12px; padding: 1.6rem; text-align: center; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <div style="font-size: 2rem; margin-bottom: 0.5rem;">📩</div>
          <h3 style="margin: 0 0 0.4rem; color: #fff; font-size: 1.15rem;">公式メール直通</h3>
          <p style="font-size: 0.84rem; color: #94a3b8; margin: 0 0 1.2rem; line-height: 1.6;">
            件名・相談テンプレが自動入力された状態でメールソフトが起動します。
          </p>
        </div>
        <a href="mailto:contact@autotechradar.com?subject=%E3%80%90%E5%8F%97%E8%A8%97%E9%96%8B%E7%99%BA%E3%83%BB%E5%B0%8E%E5%85%A5%E7%9B%B8%E8%AB%87%E3%80%91Auto%20Tech%20Radar&body=%E2%96%A0%E8%B2%B4%E7%A4%BE%E5%90%8D%EF%BC%9A%0D%0A%E2%96%A0%E3%81%94%E6%8B%85%E5%BD%93%E8%80%85%E6%A7%98%E3%81%8A%E5%90%8D%E5%89%8D%EF%BC%9A%0D%0A%E2%96%A0%E3%81%94%E6%A4%9C%E8%A8%8E%E4%B8%AD%E3%81%AEOSS%EF%BC%8F%E3%83%86%E3%83%BC%E3%83%9E%EF%BC%9A%0D%0A%E2%96%A0%E6%83%B3%E5%AE%9A%E4%BA%88%E7%AE%97%E8%A6%8F%E6%A8%A1%EF%BC%88%E4%BE%8B%EF%BC%9A80%E4%B8%87%E3%80%9C250%E4%B8%87%E5%86%86%EF%BC%89%EF%BC%9A%0D%0A%E2%96%A0%E3%81%94%E7%9B%B8%E8%AB%87%E5%86%85%E5%AE%B9%EF%BC%9A" style="background: #2563eb; color: #fff; font-weight: 700; padding: 0.65rem 1.2rem; border-radius: 8px; font-size: 0.88rem; text-decoration: none; display: block;">
          メールソフトで送信
        </a>
      </div>

      <!-- Option 3: GitHub Issues -->
      <div style="background: #111827; border: 1px solid #1f2937; border-radius: 12px; padding: 1.6rem; text-align: center; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <div style="font-size: 2rem; margin-bottom: 0.5rem;">🐙</div>
          <h3 style="margin: 0 0 0.4rem; color: #fff; font-size: 1.15rem;">GitHub リポジトリ</h3>
          <p style="font-size: 0.84rem; color: #94a3b8; margin: 0 0 1.2rem; line-height: 1.6;">
            技術的なフィードバック、OSSの掲載推薦、パブリックなご相談向け。
          </p>
        </div>
        <a href="https://github.com/ssk0224/auto-tech-radar/issues" target="_blank" style="background: #1f2937; border: 1px solid #374151; color: #cbd5e1; font-weight: 700; padding: 0.65rem 1.2rem; border-radius: 8px; font-size: 0.88rem; text-decoration: none; display: block;">
          GitHub Issuesを開く
        </a>
      </div>

    </div>

    <!-- Webコンタクトフォーム -->
    <section style="background: #111827; border: 1px solid #1f2937; border-radius: 14px; padding: 2.2rem; margin-bottom: 3rem;">
      <h2 style="font-size: 1.35rem; font-weight: 800; color: #f1f5f9; margin: 0 0 0.6rem;">
        📝 オンラインお問い合わせフォーム
      </h2>
      <p style="font-size: 0.88rem; color: #94a3b8; margin: 0 0 1.6rem;">
        以下のフォームより送信いただけます。原則1営業日以内にご返信いたします。（機密保持契約 / NDA対応可能）
      </p>

      <form id="contact-form" style="display: flex; flex-direction: column; gap: 1.2rem;">
        <div>
          <label style="display: block; font-size: 0.84rem; font-weight: 700; color: #cbd5e1; margin-bottom: 0.4rem;">
            貴社名・組織名 <span style="color: #ef4444;">*</span>
          </label>
          <input type="text" id="form-company" required placeholder="例: 株式会社〇〇" style="width: 100%; background: #030712; border: 1px solid #374151; border-radius: 8px; padding: 0.7rem 1rem; color: #fff; font-size: 0.92rem; outline: none;" />
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
          <div>
            <label style="display: block; font-size: 0.84rem; font-weight: 700; color: #cbd5e1; margin-bottom: 0.4rem;">
              ご担当者様お名前 <span style="color: #ef4444;">*</span>
            </label>
            <input type="text" id="form-name" required placeholder="例: 山田 太郎" style="width: 100%; background: #030712; border: 1px solid #374151; border-radius: 8px; padding: 0.7rem 1rem; color: #fff; font-size: 0.92rem; outline: none;" />
          </div>
          <div>
            <label style="display: block; font-size: 0.84rem; font-weight: 700; color: #cbd5e1; margin-bottom: 0.4rem;">
              メールアドレス <span style="color: #ef4444;">*</span>
            </label>
            <input type="email" id="form-email" required placeholder="name@company.com" style="width: 100%; background: #030712; border: 1px solid #374151; border-radius: 8px; padding: 0.7rem 1rem; color: #fff; font-size: 0.92rem; outline: none;" />
          </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
          <div>
            <label style="display: block; font-size: 0.84rem; font-weight: 700; color: #cbd5e1; margin-bottom: 0.4rem;">
              ご相談種別
            </label>
            <select id="form-type" style="width: 100%; background: #030712; border: 1px solid #374151; border-radius: 8px; padding: 0.7rem 1rem; color: #fff; font-size: 0.92rem; outline: none;">
              <option value="受託開発・自社専用AI構築">🤖 受託開発・自社専用AIエージェント構築</option>
              <option value="SaaS代替・オンプレミス導入">🚀 商用SaaS代替・脱課金セルフホスト導入</option>
              <option value="ローカル推論基盤・インフラ構築">⚡ ローカル推論基盤・GPUインフラ構築</option>
              <option value="スポンサーシップ・広告掲載">📢 メディア広告・スポンサーシップ掲載</option>
              <option value="その他">💡 その他・技術相談</option>
            </select>
          </div>
          <div>
            <label style="display: block; font-size: 0.84rem; font-weight: 700; color: #cbd5e1; margin-bottom: 0.4rem;">
              想定予算規模
            </label>
            <select id="form-budget" style="width: 100%; background: #030712; border: 1px solid #374151; border-radius: 8px; padding: 0.7rem 1rem; color: #fff; font-size: 0.92rem; outline: none;">
              <option value="80万〜150万円">80万円 〜 150万円</option>
              <option value="150万〜250万円">150万円 〜 250万円</option>
              <option value="250万円以上">250万円以上</option>
              <option value="要相談・見積もり希望">要相談・見積もり希望</option>
            </select>
          </div>
        </div>

        <div>
          <label style="display: block; font-size: 0.84rem; font-weight: 700; color: #cbd5e1; margin-bottom: 0.4rem;">
            ご相談内容・対象リポジトリ詳細 <span style="color: #ef4444;">*</span>
          </label>
          <textarea id="form-message" rows="5" required placeholder="検討されているリポジトリ名（例: pinvou-agent）、解決したい業務課題、現在の開発環境などをご記入ください。" style="width: 100%; background: #030712; border: 1px solid #374151; border-radius: 8px; padding: 0.8rem 1rem; color: #fff; font-size: 0.92rem; outline: none; line-height: 1.6;"></textarea>
        </div>

        <button type="submit" id="form-submit-btn" style="background: linear-gradient(135deg, #2563eb, #3b82f6); color: #fff; border: none; padding: 0.85rem 1.8rem; border-radius: 8px; font-weight: 800; font-size: 1rem; cursor: pointer; transition: opacity 0.15s; margin-top: 0.5rem;">
          ✉️ お問い合わせを送信する（即時受付）
        </button>
      </form>

      <div id="form-success-msg" style="display: none; background: rgba(16, 185, 129, 0.15); border: 1px solid #10b981; border-radius: 8px; padding: 1.2rem; text-align: center; color: #6ee7b7; font-weight: 700; margin-top: 1rem;">
        ✓ お問い合わせを受け付けました。ご記入いただいたメールアドレス宛に、担当者より1営業日以内にご返信いたします。
      </div>
    </section>

    <!-- 法人向け提供体制 ＆ 保証 -->
    <section style="background: #0b0f19; border: 1px solid #1f2937; border-radius: 14px; padding: 2rem;">
      <h3 style="margin: 0 0 1.2rem; font-size: 1.2rem; font-weight: 800; color: #f3f4f6;">🛡️ 法人向け開発・導入支援の安心ポリシー</h3>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.2rem; font-size: 0.88rem; color: #94a3b8; line-height: 1.65;">
        <div>
          <h4 style="color: #93c5fd; margin: 0 0 0.4rem; font-size: 0.95rem;">🔒 秘密保持契約 (NDA) 完備</h4>
          <p style="margin: 0;">商談前のNDA締結に対応しております。貴社独自の業務データや機密仕様を外部に漏らすことは一切ありません。</p>
        </div>
        <div>
          <h4 style="color: #93c5fd; margin: 0 0 0.4rem; font-size: 0.95rem;">📋 適格請求書 (インボイス) 対応</h4>
          <p style="margin: 0;">銀行振込・適格請求書発行に対応。法人経費・開発外注費としてスムーズに会計処理いただけます。</p>
        </div>
        <div>
          <h4 style="color: #93c5fd; margin: 0 0 0.4rem; font-size: 0.95rem;">🚀 納品後1ヶ月の無償サポート</h4>
          <p style="margin: 0;">環境構築・デプロイ後も、実機動作の安定稼働とマイナーアップデートを1ヶ月間無償で伴走支援します。</p>
        </div>
      </div>
    </section>
  </div>

  <script is:inline>
    const form = document.getElementById('contact-form');
    const successMsg = document.getElementById('form-success-msg');
    const submitBtn = document.getElementById('form-submit-btn');

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const company = document.getElementById('form-company').value;
        const name = document.getElementById('form-name').value;
        const email = document.getElementById('form-email').value;
        const type = document.getElementById('form-type').value;
        const budget = document.getElementById('form-budget').value;
        const message = document.getElementById('form-message').value;

        submitBtn.disabled = true;
        submitBtn.textContent = '送信中...';

        // mailtoのフォールバック生成
        const subject = encodeURIComponent(`【受託開発・導入相談】${company}様（${name}様）`);
        const body = encodeURIComponent(
          `■ 貴社名: ${company}\n` +
          `■ お名前: ${name}\n` +
          `■ メールアドレス: ${email}\n` +
          `■ ご相談種別: ${type}\n` +
          `■ 想定予算規模: ${budget}\n\n` +
          `■ ご相談内容:\n${message}\n`
        );

        // クライアント側での安全な送信処理
        setTimeout(() => {
          form.style.display = 'none';
          if (successMsg) successMsg.style.display = 'block';
          // メーラーの自動起動トリガー（フォールバック）
          window.location.href = `mailto:contact@autotechradar.com?subject=${subject}&body=${body}`;
        }, 800);
      });
    }
  </script>
</Layout>
