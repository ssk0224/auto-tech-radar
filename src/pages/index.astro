---
import Layout from "../layouts/Layout.astro";
const postModules = import.meta.glob("./radar/*.md", { eager: true });
const posts = Object.values(postModules) as any[];
---
<Layout title="Auto Tech Radar | 海外急上昇OSS徹底解剖メディア">
  <!-- Hero Section -->
  <section style="margin-bottom: 2.5rem; text-align: center; padding: 2.5rem 1rem; background: radial-gradient(circle at 50% 0%, rgba(59, 130, 246, 0.18) 0%, transparent 75%); border-radius: 16px; border: 1px solid rgba(59, 130, 246, 0.2);">
    <div style="display: inline-block; background: rgba(59, 130, 246, 0.2); color: #93c5fd; padding: 0.25rem 0.8rem; border-radius: 9999px; font-size: 0.78rem; font-weight: 700; margin-bottom: 0.8rem; letter-spacing: 0.05em;">
      🔥 毎朝6:00 JST 自動更新・世界最先端オープンソースインテリジェンス
    </div>
    <h2 style="font-size: 2.3rem; font-weight: 900; margin: 0 0 0.8rem; line-height: 1.3; color: #fff;">
      世界の急上昇OSSを<br/><span style="background: linear-gradient(135deg, #60a5fa, #38bdf8); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">毎朝最速で日本語解剖 ＆ 収益化指南</span>
    </h2>
    <p style="font-size: 1.05rem; color: #94a3b8; max-width: 680px; margin: 0 auto 1.8rem; line-height: 1.75;">
      GitHub Trendingの一次情報をGemini 3.8が毎朝自動クロール。技術仕様の徹底分析から、受託開発（単価50〜100万円）への提案法、自社SaaS構築のマネタイズ実践法までお届けします。
    </p>

    <!-- Key Metrics Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1rem; max-width: 720px; margin: 0 auto 1.5rem;">
      <div style="background: #111827; border: 1px solid #1f2937; padding: 0.8rem 1rem; border-radius: 10px;">
        <div style="font-size: 1.5rem; font-weight: 900; color: #38bdf8;">毎朝 6:00</div>
        <div style="font-size: 0.75rem; color: #64748b; font-weight: 600;">自動巡回 ＆ 生成 (JST)</div>
      </div>
      <div style="background: #111827; border: 1px solid #1f2937; padding: 0.8rem 1rem; border-radius: 10px;">
        <div style="font-size: 1.5rem; font-weight: 900; color: #10b981;">100% 一次ソース</div>
        <div style="font-size: 0.75rem; color: #64748b; font-weight: 600;">GitHub公式API直結</div>
      </div>
      <div style="background: #111827; border: 1px solid #1f2937; padding: 0.8rem 1rem; border-radius: 10px;">
        <div style="font-size: 1.5rem; font-weight: 900; color: #a855f7;">商用SaaS手順</div>
        <div style="font-size: 0.75rem; color: #64748b; font-weight: 600;">受託・マネタイズ分析付</div>
      </div>
      <div style="background: #111827; border: 1px solid #1f2937; padding: 0.8rem 1rem; border-radius: 10px;">
        <div style="font-size: 1.5rem; font-weight: 900; color: #f59e0b;">{posts.length}+ 本</div>
        <div style="font-size: 0.75rem; color: #64748b; font-weight: 600;">技術解剖アーカイブ</div>
      </div>
    </div>
  </section>

  <!-- 🏆 今週の急上昇OSS 殿堂入りピックアップ (Top 3 Spotlight) -->
  {posts.length >= 3 && (
    <section style="margin-bottom: 2.5rem; background: linear-gradient(135deg, rgba(30, 27, 75, 0.4) 0%, rgba(15, 23, 42, 0.6) 100%); border: 1px solid #4338ca; border-radius: 14px; padding: 1.5rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.2rem; flex-wrap: wrap; gap: 0.5rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <span style="font-size: 1.3rem;">🏆</span>
          <h3 style="margin: 0; font-size: 1.2rem; font-weight: 800; color: #e0e7ff;">今週の急上昇OSS 殿堂入りピックアップ</h3>
          <span style="font-size: 0.72rem; background: #4338ca; color: #c7d2fe; padding: 0.15rem 0.5rem; border-radius: 9999px; font-weight: 700;">PRO推奨</span>
        </div>
        <span style="font-size: 0.82rem; color: #a5b4fc;">※ 週間スター急増 ＆ 商用価値最高ランク</span>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem;">
        {posts.slice(0, 3).map((featPost, idx) => (
          <div style="background: rgba(15, 23, 42, 0.85); border: 1px solid #312e81; border-radius: 10px; padding: 1.2rem; display: flex; flex-direction: column; justify-content: space-between; position: relative;">
            <div style="position: absolute; top: 10px; right: 12px; font-size: 0.75rem; font-weight: 800; color: #f59e0b; background: rgba(245, 158, 11, 0.15); padding: 0.1rem 0.45rem; border-radius: 4px;">
              RANK #{idx + 1}
            </div>
            <div>
              <div style="font-size: 0.75rem; color: #94a3b8; font-family: 'JetBrains Mono', monospace; margin-bottom: 0.4rem;">
                {featPost.frontmatter?.tags ? featPost.frontmatter.tags[0] : 'OSS'}
              </div>
              <h4 style="margin: 0 0 0.5rem; font-size: 1.05rem; font-weight: 700; line-height: 1.4;">
                <a href={featPost.url} style="color: #f8fafc; text-decoration: none;">
                  {featPost.frontmatter?.title?.slice(0, 45) || featPost.file}...
                </a>
              </h4>
              <p style="margin: 0; font-size: 0.84rem; color: #94a3b8; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                {featPost.frontmatter?.description}
              </p>
            </div>
            <a href={featPost.url} style="margin-top: 1rem; font-size: 0.85rem; font-weight: 700; color: #60a5fa; text-decoration: none; display: inline-flex; align-items: center; gap: 0.2rem;">
              解剖レポートを見る →
            </a>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Real-time Filter & Search Box -->
  <section style="margin-bottom: 2rem;">
    <div style="background: #111827; border: 1px solid #1f2937; border-radius: 12px; padding: 1.2rem; display: flex; flex-direction: column; gap: 0.8rem;">
      <div style="display: flex; gap: 0.8rem; align-items: center;">
        <span style="font-size: 1.2rem;">🔍</span>
        <input 
          type="text" 
          id="search-input" 
          placeholder="リポジトリ名やキーワードで瞬時に検索... (例: AI, agent, Python, CLI)" 
          style="width: 100%; background: #030712; border: 1px solid #374151; color: #fff; padding: 0.65rem 1rem; border-radius: 8px; font-size: 0.92rem; outline: none;"
        />
      </div>
      <!-- One-click Category Quick Filters -->
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
        <span style="font-size: 0.78rem; color: #64748b; font-weight: 700;">人気カテゴリ:</span>
        <button class="cat-pill active" data-cat="" style="background: #2563eb; color: #fff; border: none; padding: 0.2rem 0.65rem; border-radius: 9999px; font-size: 0.78rem; font-weight: 600; cursor: pointer;">すべて</button>
        <button class="cat-pill" data-cat="ai" style="background: #1f2937; color: #94a3b8; border: 1px solid #374151; padding: 0.2rem 0.65rem; border-radius: 9999px; font-size: 0.78rem; font-weight: 600; cursor: pointer;">🤖 AI / Agent</button>
        <button class="cat-pill" data-cat="llm" style="background: #1f2937; color: #94a3b8; border: 1px solid #374151; padding: 0.2rem 0.65rem; border-radius: 9999px; font-size: 0.78rem; font-weight: 600; cursor: pointer;">⚡ LLM / 高速推論</button>
        <button class="cat-pill" data-cat="cli" style="background: #1f2937; color: #94a3b8; border: 1px solid #374151; padding: 0.2rem 0.65rem; border-radius: 9999px; font-size: 0.78rem; font-weight: 600; cursor: pointer;">🛠️ 開発者ツール / CLI</button>
        <button class="cat-pill" data-cat="python" style="background: #1f2937; color: #94a3b8; border: 1px solid #374151; padding: 0.2rem 0.65rem; border-radius: 9999px; font-size: 0.78rem; font-weight: 600; cursor: pointer;">🐍 Python</button>
      </div>
    </div>
  </section>

  <!-- Feed Section -->
  <section>
    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1.2rem; border-bottom: 1px solid #1f2937; padding-bottom: 0.6rem;">
      <h3 style="margin: 0; font-size: 1.3rem; font-weight: 800; color: #f3f4f6;">📡 最新レーダー速報</h3>
      <span style="font-size: 0.85rem; color: #64748b;" id="post-count">全 {posts.length} 本の技術レポート</span>
    </div>

    <div id="posts-container">
      {posts.length === 0 ? (
        <div style="text-align: center; padding: 3rem 1rem; background: #111827; border-radius: 12px; border: 1px solid #1f2937;">
          <p style="color: #94a3b8; margin-bottom: 0.5rem;">毎朝6時の定時クロールで自動インデックスされます。</p>
          <p style="font-size: 0.85rem; color: #64748b;">※ GitHub Actionsによる完全無人自動運用中</p>
        </div>
      ) : (
        posts.reverse().map((post) => (
          <article class="post-card" data-title={(post.frontmatter?.title || "").toLowerCase()} data-desc={(post.frontmatter?.description || "").toLowerCase()}>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 0.4rem;">
              <h3 style="margin: 0;"><a href={post.url}>{post.frontmatter?.title || post.file}</a></h3>
              <span class="meta-tag">{post.frontmatter?.pubDate || "本日公開"}</span>
            </div>
            <p>{post.frontmatter?.description}</p>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.9rem; flex-wrap: wrap; gap: 0.5rem; font-size: 0.88rem;">
              <a href={post.url} style="font-weight: 700; display: inline-flex; align-items: center; gap: 0.2rem;">
                日本語レポートを読む →
              </a>
              <div style="display: flex; gap: 0.4rem; align-items: center;">
                <button 
                  onclick={`navigator.clipboard.writeText('【注目OSS】' + '${(post.frontmatter?.title || '').replace(/'/g, "\\'")}' + ' \\nhttps://ssk0224.github.io' + '${post.url}'); alert('社内Slack/Discord用テキストをコピーしました！');`}
                  style="background: #1f2937; border: 1px solid #374151; color: #94a3b8; padding: 0.25rem 0.6rem; border-radius: 6px; font-size: 0.78rem; cursor: pointer; transition: background 0.15s;"
                  onmouseover="this.style.background='#374151'"
                  onmouseout="this.style.background='#1f2937'"
                  title="社内SlackやDiscordでチームに共有"
                >
                  💬 Slack/Discordに共有
                </button>
                <a 
                  href={`https://twitter.com/intent/tweet?text=${encodeURIComponent('世界の注目OSS解体新書: ' + (post.frontmatter?.title || '') + '\nhttps://ssk0224.github.io' + post.url + '\n#OSS #AutoTechRadar')}`}
                  target="_blank"
                  style="background: #000; border: 1px solid #374151; color: #fff; padding: 0.25rem 0.6rem; border-radius: 6px; font-size: 0.78rem; text-decoration: none;"
                >
                  𝕏 ポスト
                </a>
              </div>
            </div>
          </article>
        ))
      )}
    </div>
  </section>

  <!-- FAQ / Value Proposition (権威性と成約率アップ) -->
  <section style="margin-top: 3.5rem; background: #111827; border: 1px solid #1f2937; border-radius: 14px; padding: 2rem;">
    <h3 style="margin: 0 0 1.2rem; font-size: 1.3rem; font-weight: 800; color: #f3f4f6;">💡 よくあるご質問 & Auto Tech Radar の強み</h3>
    
    <div style="display: flex; flex-direction: column; gap: 1.2rem;">
      <div>
        <h4 style="margin: 0 0 0.3rem; color: #93c5fd; font-size: 1rem;">Q. 一般のテックニュースやまとめ記事と何が違うのですか？</h4>
        <p style="margin: 0; color: #9ca3af; font-size: 0.92rem; line-height: 1.7;">
          単なる機能紹介にとどまらず、「受託開発でクライアントにどう提案するか（想定単価：数十万〜百万円）」や「自社SaaSとしてどう収益化するか」という実用的なビジネス・マネタイズ設計まで深掘りしている点です。一次情報の英語コードをAIが直接解析して解説します。
        </p>
      </div>

      <div>
        <h4 style="margin: 0 0 0.3rem; color: #93c5fd; font-size: 1rem;">Q. note メンバーシップと単発買い切りのどちらがお得ですか？</h4>
        <p style="margin: 0; color: #9ca3af; font-size: 0.92rem; line-height: 1.7;">
          1本だけ特定リポジトリの商用利用を深掘りしたい場合は「Stripe単発買い切り（980円）」、日々の技術キャッチアップや新規事業のネタ帳としてストックしたい場合は「note メンバーシップ（月額1,980円・全記事読み放題）」が圧倒的にお得です。
        </p>
      </div>

      <div>
        <h4 style="margin: 0 0 0.3rem; color: #93c5fd; font-size: 1rem;">Q. 企業向けのスポンサーや開発相談は受け付けていますか？</h4>
        <p style="margin: 0; color: #9ca3af; font-size: 0.92rem; line-height: 1.7;">
          はい。レポート対象OSSを活用した自社プロダクトの掲載スポンサーや、社内システム導入・AIエージェント開発支援（10万円〜）も承っております。ページ下部のGitHubリンクよりお気軽にお問い合わせください。
        </p>
      </div>
    </div>
  </section>

  <!-- Client-side Search & Category Filter Script -->
  <script is:inline>
    const searchInput = document.getElementById("search-input");
    const cards = document.querySelectorAll(".post-card");
    const countEl = document.getElementById("post-count");
    const catPills = document.querySelectorAll(".cat-pill");

    function applyFilter(query) {
      let visibleCount = 0;
      cards.forEach((card) => {
        const title = card.getAttribute("data-title") || "";
        const desc = card.getAttribute("data-desc") || "";
        if (!query || title.includes(query) || desc.includes(query)) {
          card.style.display = "";
          visibleCount++;
        } else {
          card.style.display = "none";
        }
      });
      if (countEl) countEl.textContent = `表示中: ${visibleCount} 本の技術レポート`;
    }

    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        applyFilter(e.target.value.toLowerCase().trim());
      });
    }

    catPills.forEach((pill) => {
      pill.addEventListener("click", () => {
        catPills.forEach((p) => {
          p.style.background = "#1f2937";
          p.style.color = "#94a3b8";
          p.style.border = "1px solid #374151";
        });
        pill.style.background = "#2563eb";
        pill.style.color = "#fff";
        pill.style.border = "none";

        const cat = pill.getAttribute("data-cat") || "";
        if (searchInput) searchInput.value = cat;
        applyFilter(cat);
      });
    });
  </script>
</Layout>
