---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../config/site.js";
import { SITE_DESCRIPTION } from "../utils/site_copy.js";
import { getArticles, hrefOf } from "../utils/articles.js";
import { dateLabel } from "../utils/dates.js";
import { ellipsis } from "../utils/article_page.js";
import { ogpPathFor } from "../utils/ogp.js";
import Cadence from "../components/Cadence.astro";
import { categoryOf, TOPIC_CATEGORIES, UNCATEGORIZED } from "../utils/categories.js";
// ノイズ除外・pubDate 降順は getArticles 側で済んでいる
const posts = getArticles() as any[];
// 絞り込みのボタン: 分類の定義そのもの（タグの完全一致。当てはまらない記事は「未分類」）。手で書いた分類名を出さない
const categoryPills = [...TOPIC_CATEGORIES.map((c) => ({ key: c.key, label: c.label })), { key: "none", label: UNCATEGORIZED }];
---
<Layout title="Auto Tech Radar | 海外急上昇OSS徹底解剖メディア">
  <!-- Hero Section -->
  <section style="margin-bottom: 2.5rem; text-align: center; padding: 2.5rem 1rem; background: radial-gradient(circle at 50% 0%, rgba(59, 130, 246, 0.18) 0%, transparent 75%); border-radius: 16px; border: 1px solid rgba(59, 130, 246, 0.2);">
    <div style="display: inline-block; background: rgba(59, 130, 246, 0.2); color: #93c5fd; padding: 0.25rem 0.8rem; border-radius: 9999px; font-size: 0.78rem; font-weight: 700; margin-bottom: 0.8rem; letter-spacing: 0.05em;">
      🔥 <Cadence />
    </div>
    <h1 style="font-size: 2.3rem; font-weight: 900; margin: 0 0 0.8rem; line-height: 1.3; color: #fff;">
      世界の急上昇OSSを<br/><span style="background: linear-gradient(135deg, #60a5fa, #38bdf8); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">README の原文で紹介</span>
    </h1>
    <p style="font-size: 1.05rem; color: #94a3b8; max-width: 680px; margin: 0 auto 1.8rem; line-height: 1.75;">
      {SITE_DESCRIPTION}ソースコードの解析や動作検証は行っていません。
    </p>

    <!-- Key Metrics Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1rem; max-width: 720px; margin: 0 auto 1.5rem;">
      <div style="background: #111827; border: 1px solid #1f2937; padding: 0.8rem 1rem; border-radius: 10px;">
        <Cadence variant="metric" />
      </div>
      <div style="background: #111827; border: 1px solid #1f2937; padding: 0.8rem 1rem; border-radius: 10px;">
        <div style="font-size: 1.5rem; font-weight: 900; color: #10b981;">README 準拠</div>
        <div style="font-size: 0.75rem; color: #64748b; font-weight: 600;">GitHub 公式 API で取得</div>
      </div>
      <div style="background: #111827; border: 1px solid #1f2937; padding: 0.8rem 1rem; border-radius: 10px;">
        <div style="font-size: 1.5rem; font-weight: 900; color: #a855f7;">ライセンス確認</div>
        <div style="font-size: 0.75rem; color: #64748b; font-weight: 600;">LICENSE ファイルから判定</div>
      </div>
      <div style="background: #111827; border: 1px solid #1f2937; padding: 0.8rem 1rem; border-radius: 10px;">
        <div id="archive-count" style="font-size: 1.5rem; font-weight: 900; color: #f59e0b;">{posts.length} 本</div>
        <div style="font-size: 0.75rem; color: #64748b; font-weight: 600;">技術解剖アーカイブ</div>
      </div>
    </div>

    <!-- Lead Magnet Banner -->
    <div style="margin-top: 1.5rem; display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap;">
      <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/cheatsheet/`} style="display: inline-flex; align-items: center; gap: 0.6rem; background: linear-gradient(135deg, rgba(16, 185, 129, 0.2) 0%, rgba(59, 130, 246, 0.2) 100%); border: 1px solid rgba(16, 185, 129, 0.5); padding: 0.75rem 1.4rem; border-radius: 9999px; color: #6ee7b7; font-weight: 700; font-size: 0.92rem; text-decoration: none; box-shadow: 0 4px 15px rgba(16, 185, 129, 0.15);">
        <span>📊 全OSS商用化チートシート</span>
        <span style="background: #10b981; color: #000; font-size: 0.75rem; padding: 0.15rem 0.5rem; border-radius: 9999px; font-weight: 800;">CSV/Markdown</span>
      </a>
      <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/estimate/`} style="display: inline-flex; align-items: center; gap: 0.6rem; background: linear-gradient(135deg, rgba(37, 99, 235, 0.2) 0%, rgba(139, 92, 246, 0.2) 100%); border: 1px solid rgba(59, 130, 246, 0.5); padding: 0.75rem 1.4rem; border-radius: 9999px; color: #93c5fd; font-weight: 700; font-size: 0.92rem; text-decoration: none; box-shadow: 0 4px 15px rgba(37, 99, 235, 0.15);">
        <span>⚡ 開発費用の目安を試算（概算）</span>
      </a>
    </div>
  </section>

  <!-- 📬 ByteByteGo / TLDR スタイル: 無料インテリジェンス購読 ＆ 新着プッシュ通知枠 -->
  <section style="margin-bottom: 2.5rem; background: radial-gradient(circle at 50% 0%, rgba(30, 58, 138, 0.4) 0%, rgba(15, 23, 42, 0.8) 100%); border: 1px solid #2563eb; border-radius: 14px; padding: 1.8rem; text-align: center;">
    <div style="max-width: 680px; margin: 0 auto;">
      <div style="display: inline-block; background: rgba(59, 130, 246, 0.25); color: #93c5fd; font-size: 0.75rem; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 9999px; margin-bottom: 0.6rem;">
        ⚡ <Cadence />
      </div>
      <h3 style="font-size: 1.35rem; font-weight: 800; color: #fff; margin: 0 0 0.5rem;">
        新しい記事を受け取る
      </h3>
      <p style="font-size: 0.92rem; color: #94a3b8; margin: 0 0 1.2rem; line-height: 1.6;">
        新しい記事は RSS フィードで受け取れます。note メンバーシップ（月額1,980円）では、メンバーシップ特典に追加した有料記事を読めます（すべての記事が対象ではありません）。
      </p>
      <div style="display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap;">
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/rss.xml`} target="_blank" rel="noopener noreferrer" style="background: #f97316; color: #fff; padding: 0.6rem 1.2rem; border-radius: 8px; font-weight: 700; font-size: 0.88rem; text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem;">
          📡 RSSリーダーに追加
        </a>
        <a href={siteConfig.noteMembershipUrl} target="_blank" rel="noopener noreferrer" style="background: #2cb696; color: #fff; padding: 0.6rem 1.2rem; border-radius: 8px; font-weight: 700; font-size: 0.88rem; text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem;">
          ⚡ note メンバーシップ
        </a>
      </div>
    </div>
  </section>

  <!-- 🏆 新着ピックアップ (Top 3 Spotlight) -->
  {posts.length >= 3 && (
    <section style="margin-bottom: 2.5rem; background: linear-gradient(135deg, rgba(30, 27, 75, 0.4) 0%, rgba(15, 23, 42, 0.6) 100%); border: 1px solid #4338ca; border-radius: 14px; padding: 1.5rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.2rem; flex-wrap: wrap; gap: 0.5rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <span style="font-size: 1.3rem;">🏆</span>
          <h3 style="margin: 0; font-size: 1.2rem; font-weight: 800; color: #e0e7ff;">新着ピックアップ</h3>
                  </div>
        <span style="font-size: 0.82rem; color: #a5b4fc;">※ 公開日の新しい順に3件を表示</span>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem;">
        {posts.slice(0, 3).map((featPost, idx) => {
          const featSlug = featPost.url.replace(/\/$/, '').split('/').pop();
          return (
            <div style="background: rgba(15, 23, 42, 0.85); border: 1px solid #312e81; border-radius: 12px; padding: 1.2rem; display: flex; flex-direction: column; justify-content: space-between; position: relative; overflow: hidden;">
              <div style="position: absolute; top: 10px; right: 12px; font-size: 0.75rem; font-weight: 800; color: #f59e0b; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(8px); border: 1px solid rgba(245, 158, 11, 0.4); padding: 0.15rem 0.5rem; border-radius: 6px; z-index: 2;">
                新着 #{idx + 1}
              </div>
              <div>
                <a href={hrefOf(featPost)} style="text-decoration: none; display: block; margin-bottom: 0.8rem; border-radius: 8px; overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.08); background: #0b0f19;">
                  <img 
                    src={`${import.meta.env.BASE_URL.replace(/\/$/, "")}${ogpPathFor(featSlug)}`} 
                    alt={featPost.frontmatter?.title || featPost.file} 
                    loading="lazy"
                    style="width: 100%; aspect-ratio: 1200 / 630; object-fit: cover; display: block;"
                    onerror="this.style.display='none'"
                  />
                </a>
                <div style="font-size: 0.75rem; color: #94a3b8; font-family: 'JetBrains Mono', monospace; margin-bottom: 0.4rem;">
                  {featPost.frontmatter?.tags ? featPost.frontmatter.tags[0] : 'OSS'}
                </div>
                <h4 style="margin: 0 0 0.5rem; font-size: 1.05rem; font-weight: 700; line-height: 1.4;">
                  <a href={hrefOf(featPost)} style="color: #f8fafc; text-decoration: none;">
                    {ellipsis(featPost.frontmatter?.title || featPost.file, 45)}
                  </a>
                </h4>
                <p style="margin: 0; font-size: 0.84rem; color: #94a3b8; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                  {featPost.frontmatter?.description}
                </p>
              </div>
              <a href={hrefOf(featPost)} style="margin-top: 1rem; font-size: 0.85rem; font-weight: 700; color: #60a5fa; text-decoration: none; display: inline-flex; align-items: center; gap: 0.2rem;">
                解剖レポートを見る →
              </a>
            </div>
          );
        })}
      </div>
    </section>
  )}

  <!-- Real-time Filter & Search Box -->
  <section style="margin-bottom: 2rem;">
    <div style="background: #111827; border: 1px solid #1f2937; border-radius: 12px; padding: 1.2rem; display: flex; flex-direction: column; gap: 0.8rem;">
      <div style="display: flex; gap: 0.8rem; align-items: center;">
        <span style="font-size: 1.2rem;">🔍</span>
        <input 
          type="text" 
          id="search-input" 
          aria-label="記事をキーワードで検索" 
          placeholder="リポジトリ名やキーワードで検索 (例: AI, agent, Python, CLI)" 
          style="width: 100%; background: #030712; border: 1px solid #374151; color: #fff; padding: 0.65rem 1rem; border-radius: 8px; font-size: 0.92rem; outline: none;"
        />
      </div>
      <!-- One-click Category Quick Filters -->
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
        <span style="font-size: 0.78rem; color: #64748b; font-weight: 700;">タグによる分類:</span>
        <button class="cat-pill active" data-cat="" style="background: #2563eb; color: #fff; border: none; padding: 0.2rem 0.65rem; border-radius: 9999px; font-size: 0.78rem; font-weight: 600; cursor: pointer;">すべて</button>
        {categoryPills.map((c) => (
          <button class="cat-pill" data-cat={c.key} style="background: #1f2937; color: #94a3b8; border: 1px solid #374151; padding: 0.2rem 0.65rem; border-radius: 9999px; font-size: 0.78rem; font-weight: 600; cursor: pointer;">{c.label}</button>
        ))}
      </div>
    </div>
  </section>

  <!-- Feed Section -->
  <section>
    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1.2rem; border-bottom: 1px solid #1f2937; padding-bottom: 0.6rem;">
      <h3 style="margin: 0; font-size: 1.3rem; font-weight: 800; color: #f3f4f6;">📡 掲載中の記事</h3>
      <span style="font-size: 0.85rem; color: #64748b;" id="post-count">全 {posts.length} 本の技術レポート</span>
    </div>

    <div id="posts-container">
      {posts.length === 0 ? (
        <div style="text-align: center; padding: 3rem 1rem; background: #111827; border-radius: 12px; border: 1px solid #1f2937;">
          <p style="color: #94a3b8; margin-bottom: 0.5rem;">掲載中の記事はまだありません。</p>
        </div>
      ) : (
        posts.map((post) => {
          const slug = post.url.replace(/\/$/, '').split('/').pop();
          const tags = Array.isArray(post.frontmatter?.tags) ? post.frontmatter.tags : ['Tech'];
          const title = post.frontmatter?.title || post.file;
          return (
            <article class="post-card" data-category={categoryOf(post.frontmatter?.tags).key} data-title={title.toLowerCase()} data-desc={(post.frontmatter?.description || "").toLowerCase()} data-tags={tags.join(' ').toLowerCase()}>
              <div class="post-card-inner">
                <div class="post-card-thumb">
                  <a href={hrefOf(post)} tabindex="-1" aria-hidden="true">
                    <img 
                      src={`${import.meta.env.BASE_URL.replace(/\/$/, "")}${ogpPathFor(slug)}`} 
                      alt={title} 
                      loading="lazy" 
                      width="320" 
                      height="168"
                      class="post-thumb-img"
                      onerror="this.style.display='none'"
                    />
                  </a>
                </div>
                <div class="post-card-content">
                  <div>
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.8rem; margin-bottom: 0.4rem; flex-wrap: wrap;">
                      <h3 style="margin: 0;"><a href={hrefOf(post)}>{title}</a></h3>
                      {dateLabel(post.frontmatter?.pubDate) && <span class="meta-tag">{dateLabel(post.frontmatter?.pubDate)}</span>}
                    </div>
                    <p style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">{post.frontmatter?.description}</p>
                    
                    <div style="display: flex; gap: 0.4rem; margin: 0.5rem 0 0.7rem; flex-wrap: wrap;">
                      {tags.map((tg: string) => (
                        <span style="background: #111827; border: 1px solid #1f2937; color: #94a3b8; font-size: 0.72rem; padding: 0.1rem 0.4rem; border-radius: 4px; font-family: 'JetBrains Mono', monospace;">
                          #{tg}
                        </span>
                      ))}
                    </div>
                  </div>

                  <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.6rem; flex-wrap: wrap; gap: 0.5rem; font-size: 0.88rem; border-top: 1px solid rgba(31, 41, 55, 0.6); padding-top: 0.6rem;">
                    <a href={hrefOf(post)} style="font-weight: 700; color: #60a5fa; display: inline-flex; align-items: center; gap: 0.2rem; text-decoration: none;">
                      記事を読む →
                    </a>
                    <div style="display: flex; gap: 0.4rem; align-items: center;">
                      <button 
                        class="slack-share-btn"
                        data-title={title}
                        data-url={hrefOf(post)}
                        style="background: #1f2937; border: 1px solid #374151; color: #94a3b8; padding: 0.25rem 0.6rem; border-radius: 6px; font-size: 0.78rem; cursor: pointer; transition: background 0.15s;"
                        onmouseover="this.style.background='#374151'"
                        onmouseout="this.style.background='#1f2937'"
                        title="社内SlackやDiscordでチームに共有"
                      >
                        💬 Slack共有
                      </button>
                      <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent('世界の注目OSS解体新書: ' + title + '\nhttps://ssk0224.github.io' + hrefOf(post) + '\n#OSS #AutoTechRadar')}`}
                        target="_blank" rel="noopener noreferrer"
                        style="background: #000; border: 1px solid #374151; color: #fff; padding: 0.25rem 0.6rem; border-radius: 6px; font-size: 0.78rem; text-decoration: none;"
                      >
                        𝕏 ポスト
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </article>
          );
        })
      )}
    </div>
  </section>

  <!-- 🏢 法人・企業様向け受託開発 ＆ AIエージェント導入バナー -->
  <section style="margin-top: 3rem; background: linear-gradient(135deg, rgba(15, 23, 42, 0.95) 0%, rgba(30, 27, 75, 0.9) 100%); border: 1px solid #3b82f6; border-radius: 14px; padding: 2rem; display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; flex-wrap: wrap;">
    <div style="flex: 1 1 280px; min-width: 0;">
      <div style="display: inline-block; background: rgba(59, 130, 246, 0.2); color: #93c5fd; padding: 0.2rem 0.7rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 700; margin-bottom: 0.5rem;">
        🏢 法人・開発責任者・新規事業担当者様へ
      </div>
      <h3 style="margin: 0 0 0.5rem; font-size: 1.35rem; font-weight: 800; color: #fff;">
        海外最先端OSSを活用した自社専用AIの導入支援
      </h3>
      <p style="margin: 0; font-size: 0.92rem; color: #94a3b8; line-height: 1.6;">
        紹介した OSS の環境構築や API 連携などのご相談は、お問い合わせフォームから受け付けています（個人で運営しているため、ご返信までお時間をいただく場合があります）。
      </p>
    </div>
    <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/contact/`} style="background: linear-gradient(135deg, #2563eb, #3b82f6); color: #fff; font-weight: 700; font-size: 0.95rem; padding: 0.85rem 1.6rem; border-radius: 8px; text-decoration: none; max-width: 100%; text-align: center; box-shadow: 0 4px 15px rgba(37, 99, 235, 0.35);">
      📩 お問い合わせフォーム →
    </a>
  </section>

  <!-- FAQ / Value Proposition (権威性と成約率アップ) -->
  <section style="margin-top: 2.5rem; background: #111827; border: 1px solid #1f2937; border-radius: 14px; padding: 2rem;">
    <h3 style="margin: 0 0 1.2rem; font-size: 1.3rem; font-weight: 800; color: #f3f4f6;">💡 よくあるご質問 & Auto Tech Radar の強み</h3>
    
    <div style="display: flex; flex-direction: column; gap: 1.2rem;">
      <div>
        <h4 style="margin: 0 0 0.3rem; color: #93c5fd; font-size: 1rem;">Q. 一般のテックニュースやまとめ記事と何が違うのですか？</h4>
        <p style="margin: 0; color: #9ca3af; font-size: 0.92rem; line-height: 1.7;">
          GitHub でスター数が伸びている OSS を選定基準に沿って選び、README の文を訳さずに原文のまま抜き出し、README からの転記のインストール手順と、LICENSE ファイルから判定したライセンスの確認先を、決まった形でまとめている点です。ソースコードの解析や実機での動作検証は行っていません。
          各記事の導入提案書テンプレート（Markdown）と工数・見積表は、note の有料記事（単発980円）で提供しています。
        </p>
      </div>

      <div>
        <h4 style="margin: 0 0 0.3rem; color: #93c5fd; font-size: 1rem;">Q. note メンバーシップと単発の記事は何が違いますか？</h4>
        <p style="margin: 0; color: #9ca3af; font-size: 0.92rem; line-height: 1.7;">
          単発記事（980円）はその記事の有料部分を読めます。note メンバーシップ（月額1,980円）では、メンバーシップ特典に追加した有料記事を読めます（すべての記事が対象ではありません）。読みたい記事が特典の対象かどうかは、メンバーシップページでご確認ください。
        </p>
      </div>

      <div>
        <h4 style="margin: 0 0 0.3rem; color: #93c5fd; font-size: 1rem;">Q. 企業向けのスポンサーや受託開発相談は受け付けていますか？</h4>
        <p style="margin: 0; color: #9ca3af; font-size: 0.92rem; line-height: 1.7;">
          受託開発・導入支援のご相談は<a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/contact/`} style="color: #60a5fa; font-weight: 700; text-decoration: underline;">お問い合わせ窓口</a>から受け付けています。スポンサー枠は読者数を公開した後に募集します。
        </p>
      </div>
    </div>
  </section>

  <!-- Client-side Search & Category Filter Script -->
  <script is:inline>
    // Slack共有ボタン（タイトル・URLは data 属性から読むため、文字列組み立てによるエスケープ不備が起きない）
    document.querySelectorAll(".slack-share-btn").forEach((btn) => {
      const orig = btn.innerText;
      let timer = null;
      btn.addEventListener("click", () => {
        const text = "【注目OSS】" + (btn.getAttribute("data-title") || "") + " \nhttps://ssk0224.github.io" + (btn.getAttribute("data-url") || "");
        navigator.clipboard.writeText(text).then(() => {
          if (timer) clearTimeout(timer);
          btn.innerText = "✓ コピー完了！";
          timer = setTimeout(() => { btn.innerText = orig; }, 2000);
        }).catch(() => {
          prompt('以下のテキストをコピーしてください:', text);
        });
      });
    });

    const searchInput = document.getElementById("search-input");
    const cards = document.querySelectorAll(".post-card");
    const countEl = document.getElementById("post-count");
    const catPills = document.querySelectorAll(".cat-pill");

    // 検索語（部分一致）と分類（カードの data-category の完全一致）の両方で絞り込む
    let activeCat = "";
    function applyFilter(query) {
      let visibleCount = 0;
      cards.forEach((card) => {
        const title = card.getAttribute("data-title") || "";
        const desc = card.getAttribute("data-desc") || "";
        const tags = card.getAttribute("data-tags") || "";
        const catOk = !activeCat || card.getAttribute("data-category") === activeCat;
        const queryOk = !query || title.includes(query) || desc.includes(query) || tags.includes(query);
        if (catOk && queryOk) {
          card.style.display = "";
          visibleCount++;
        } else {
          card.style.display = "none";
        }
      });
      if (countEl) countEl.textContent = `表示中: ${visibleCount} 本の技術レポート`;
    }

    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        applyFilter(e.target.value.toLowerCase().trim());
      });
    }

    catPills.forEach((pill) => {
      pill.addEventListener("click", () => {
        catPills.forEach((p) => {
          p.style.background = "#1f2937";
          p.style.color = "#94a3b8";
          p.style.border = "1px solid #374151";
        });
        pill.style.background = "#2563eb";
        pill.style.color = "#fff";
        pill.style.border = "none";

        activeCat = pill.getAttribute("data-cat") || "";
        applyFilter(searchInput ? searchInput.value.toLowerCase().trim() : "");
      });
    });
  </script>
</Layout>
