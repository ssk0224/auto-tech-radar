---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../config/site.js";
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title="メディア広告・スポンサーシップ掲載（メディアキット） | Auto Tech Radar" description="急上昇OSSを解説する技術メディア「Auto Tech Radar」のスポンサー掲載（PR表記つき）のご案内。">
  <div style="max-width: 800px; margin: 0 auto; padding: 1rem 0 3rem;">
    <!-- Breadcrumb -->
    <div style="font-size: 0.85rem; color: #94a3b8; margin-bottom: 1.5rem;">
      <a href={`${baseUrl}/`} style="color: #60a5fa; text-decoration: none;">← トップページに戻る</a>
    </div>

    <!-- Header Banner -->
    <div style="background: linear-gradient(135deg, rgba(30, 27, 75, 0.85) 0%, rgba(15, 23, 42, 0.95) 100%); border: 1px solid #6366f1; border-radius: 14px; padding: 2.4rem 2rem; margin-bottom: 2.5rem; text-align: center;">
      <div style="display: inline-block; background: rgba(99, 102, 241, 0.2); color: #a5b4fc; padding: 0.3rem 0.9rem; border-radius: 9999px; font-size: 0.82rem; font-weight: 700; margin-bottom: 0.8rem;">
        📢 B2B Media Kit & Sponsorship
      </div>
      <h1 style="font-size: 2.1rem; font-weight: 900; margin: 0 0 0.8rem; color: #fff; line-height: 1.35;">
        急上昇OSSを追うエンジニアへ届ける<br/>
        <span style="background: linear-gradient(135deg, #a5b4fc, #38bdf8); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">オフィシャル・スポンサーシップのご案内</span>
      </h1>
      <p style="font-size: 1rem; color: #cbd5e1; margin: 0 auto; max-width: 650px; line-height: 1.75;">
        Auto Tech Radarは、世界の急上昇OSSの一次情報を、<strong>エンジニア、アーキテクト、開発責任者</strong>に向けて発信しています。開発者向けSaaS、クラウドサービス、AI製品、テック採用のPRに最適な場を提供します。
      </p>
    </div>

    <!-- Disclosure -->
    <section style="margin-bottom: 2.5rem;">
      <h2 style="font-size: 1.35rem; font-weight: 800; color: #f1f5f9; border-left: 4px solid #3b82f6; padding-left: 0.8rem; margin-bottom: 1.2rem;">
        📋 掲載の前提
      </h2>
      <ul style="font-size: 0.9rem; color: #cbd5e1; line-height: 1.8; margin: 0; padding-left: 1.2rem;">
        <li>協賛記事・バナーには「PR」「広告」と明記します（景品表示法のステルスマーケティング規制に従います）。</li>
        <li>協賛リンクには <code>rel="sponsored"</code> を付けます（検索順位を目的とした被リンクの販売は行いません）。</li>
        <li>読者数・読者属性の数値は計測体制が整うまで掲載していません。ご相談時に現時点で分かる範囲をお伝えします。</li>
      </ul>
    </section>

    <!-- Sponsorship Menu & Pricing -->
    <section style="margin-bottom: 2.8rem;">
      <h2 style="font-size: 1.35rem; font-weight: 800; color: #f1f5f9; border-left: 4px solid #10b981; padding-left: 0.8rem; margin-bottom: 1.2rem;">
        💎 スポンサーシップ・メニュー
      </h2>
      <div style="display: grid; gap: 1.3rem;">
        
        <!-- Plan 1 -->
        <div style="background: #111827; border: 1px solid #312e81; border-radius: 12px; padding: 1.6rem; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.6rem; flex-wrap: wrap;">
              <h3 style="margin: 0; color: #e0e7ff; font-size: 1.25rem; font-weight: 800;">① メイン・タイアップ協賛（ディープダイブ特集）</h3>
              <div style="font-size: 1.4rem; font-weight: 900; color: #38bdf8;">¥300,000 <span style="font-size: 0.82rem; color: #94a3b8; font-weight: normal;">/ 1記事パッケージ</span></div>
            </div>
            <p style="font-size: 0.92rem; color: #cbd5e1; line-height: 1.65; margin-bottom: 1rem;">
              貴社のOSSプロダクトや開発者向けSaaSのアーキテクチャ・導入メリットを、専門エンジニア視点で徹底解剖する専用タイアップレポートを執筆・掲載します（「PR」表記つき）。
            </p>
            <ul style="list-style: none; padding: 0; margin: 0 0 1rem; font-size: 0.88rem; color: #94a3b8; line-height: 1.8;">
              <li>✓ 本サイトでの単独特集記事（PR表記つき）</li>
              <li>✓ 公式 𝕏 での記事紹介ポスト（PR表記つき）</li>
              <li>✓ 貴社サイトへのリンク（rel="sponsored"）</li>
            </ul>
          </div>
          <div style="display: flex; gap: 0.8rem; align-items: center; margin-top: 0.8rem; flex-wrap: wrap;">
            <a href={`${baseUrl}/contact/?plan=sponsor-tieup&price=300000`} style="background: linear-gradient(135deg, #2563eb, #3b82f6); color: #fff; font-weight: 700; padding: 0.65rem 1.4rem; border-radius: 8px; font-size: 0.9rem; text-decoration: none; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);">📝 タイアップ特集を申し込む（無料相談） →</a>
            <a href="https://x.com/AutoTechRadar" target="_blank" rel="noopener noreferrer" style="background: #000; color: #cbd5e1; font-weight: 600; padding: 0.65rem 1.1rem; border-radius: 8px; font-size: 0.85rem; text-decoration: none; border: 1px solid #374151;">💬 𝕏のDMで相談</a>
          </div>
        </div>

        <!-- Plan 2 -->
        <div style="background: #111827; border: 1px solid #1f2937; border-radius: 12px; padding: 1.6rem; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.6rem; flex-wrap: wrap;">
              <h3 style="margin: 0; color: #e0e7ff; font-size: 1.25rem; font-weight: 800;">② 月間メディアスポンサー（記事末尾のバナー掲載）</h3>
              <div style="font-size: 1.4rem; font-weight: 900; color: #10b981;">¥100,000 <span style="font-size: 0.82rem; color: #94a3b8; font-weight: normal;">/ 月</span></div>
            </div>
            <p style="font-size: 0.92rem; color: #cbd5e1; line-height: 1.65; margin-bottom: 1rem;">
              記事末尾に「PR」表記つきで貴社ロゴとリンクバナーを1ヶ月間掲載します。掲載位置・形式はご相談のうえ決定します。
            </p>
            <ul style="list-style: none; padding: 0; margin: 0 0 1rem; font-size: 0.88rem; color: #94a3b8; line-height: 1.8;">
              <li>✓ 掲載期間中に公開される記事を含む全記事ページでの掲載</li>
              <li>✓ お支払い方法・請求書の形式はご相談時にご案内します</li>
            </ul>
          </div>
          <div style="display: flex; gap: 0.8rem; align-items: center; margin-top: 0.8rem; flex-wrap: wrap;">
            <a href={`${baseUrl}/contact/?plan=sponsor-monthly&price=100000`} style="background: linear-gradient(135deg, #10b981, #059669); color: #fff; font-weight: 700; padding: 0.65rem 1.4rem; border-radius: 8px; font-size: 0.9rem; text-decoration: none; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);">📝 月間スポンサー枠を予約・相談 →</a>
            <a href="https://x.com/AutoTechRadar" target="_blank" rel="noopener noreferrer" style="background: #000; color: #cbd5e1; font-weight: 600; padding: 0.65rem 1.1rem; border-radius: 8px; font-size: 0.85rem; text-decoration: none; border: 1px solid #374151;">💬 𝕏のDMで相談</a>
          </div>
        </div>

      </div>
    </section>

    <!-- Contact Box -->
    <div style="text-align: center; background: #0b0f19; border: 1px solid #1f2937; border-radius: 12px; padding: 2.2rem;">
      <h3 style="margin: 0 0 0.6rem; color: #fff; font-size: 1.3rem;">掲載のご相談・空き枠のお問い合わせ</h3>
      <p style="margin: 0 auto 1.4rem; color: #94a3b8; font-size: 0.92rem; max-width: 540px; line-height: 1.65;">
        読者にとって有益なテクノロジー製品であることを掲載の条件としています。掲載開始日はご相談のうえ決定します。
      </p>
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href={`${baseUrl}/contact/`} style="background: linear-gradient(135deg, #2563eb, #3b82f6); color: #fff; font-weight: 700; padding: 0.75rem 1.6rem; border-radius: 8px; text-decoration: none; box-shadow: 0 4px 15px rgba(37, 99, 235, 0.3);">📝 オンラインフォームで相談</a>
        <a href="https://x.com/AutoTechRadar" target="_blank" rel="noopener noreferrer" style="background: #000; color: #fff; font-weight: 700; padding: 0.75rem 1.6rem; border-radius: 8px; text-decoration: none; border: 1px solid #374151;">💬 公式𝕏 (@AutoTechRadar) へDM</a>
        <a href={`mailto:${siteConfig.contactEmail}?subject=${encodeURIComponent("【スポンサー掲載相談】Auto Tech Radar")}`} style="background: #1f2937; color: #cbd5e1; font-weight: 700; padding: 0.75rem 1.6rem; border-radius: 8px; text-decoration: none; border: 1px solid #374151;">📩 メールで相談</a>
      </div>
    </div>
  </div>
</Layout>
