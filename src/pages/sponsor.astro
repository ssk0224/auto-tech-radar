---
import Layout from "../layouts/Layout.astro";
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
// スポンサー枠の価格は出さない。読者数・読者属性のデータを公開していない段階で価格を提示しない（2026-10-21）。
// ページ自体とフッターのリンクは残す（オーナー判断）
---

<Layout title="広告・スポンサー掲載について | Auto Tech Radar" description="技術メディア「Auto Tech Radar」の広告・スポンサー掲載についてのご案内。スポンサー枠は読者数を公開した後に募集します。">
  <div style="max-width: 800px; margin: 0 auto; padding: 1rem 0 3rem;">
    <!-- Breadcrumb -->
    <div style="font-size: 0.85rem; color: #94a3b8; margin-bottom: 1.5rem;">
      <a href={`${baseUrl}/`} style="color: #60a5fa; text-decoration: none;">← トップページに戻る</a>
    </div>

    <!-- Header Banner -->
    <div style="background: linear-gradient(135deg, rgba(30, 27, 75, 0.85) 0%, rgba(15, 23, 42, 0.95) 100%); border: 1px solid #6366f1; border-radius: 14px; padding: 2.4rem 2rem; margin-bottom: 2.5rem; text-align: center;">
      <div style="display: inline-block; background: rgba(99, 102, 241, 0.2); color: #a5b4fc; padding: 0.3rem 0.9rem; border-radius: 9999px; font-size: 0.82rem; font-weight: 700; margin-bottom: 0.8rem;">
        📢 Sponsorship
      </div>
      <h1 style="font-size: 2.1rem; font-weight: 900; margin: 0 0 0.8rem; color: #fff; line-height: 1.35;">
        広告・スポンサー掲載について
      </h1>
      <p style="font-size: 1rem; color: #cbd5e1; margin: 0 auto; max-width: 650px; line-height: 1.75;">
        Auto Tech Radar は、GitHub で注目されている OSS を README などの公開情報をもとに日本語で解説しています。
      </p>
    </div>

    <!-- 募集の状況 -->
    <section style="margin-bottom: 2.5rem; background: #111827; border: 1px solid #1f2937; border-radius: 12px; padding: 1.8rem; text-align: center;">
      <h2 style="font-size: 1.35rem; font-weight: 800; color: #f1f5f9; margin: 0 0 0.8rem;">募集の状況</h2>
      <p id="sponsor-status" style="font-size: 0.98rem; color: #e2e8f0; line-height: 1.8; margin: 0;">
        スポンサー枠は読者数を公開した後に募集します。ご関心のある方は <a href={`${baseUrl}/contact/`} style="color: #60a5fa; font-weight: 700; text-decoration: underline;">お問い合わせ</a> からご連絡ください。
      </p>
    </section>

    <!-- Disclosure -->
    <section style="margin-bottom: 2.5rem;">
      <h2 style="font-size: 1.35rem; font-weight: 800; color: #f1f5f9; border-left: 4px solid #3b82f6; padding-left: 0.8rem; margin-bottom: 1.2rem;">
        📋 掲載する場合の前提
      </h2>
      <ul style="font-size: 0.9rem; color: #cbd5e1; line-height: 1.8; margin: 0; padding-left: 1.2rem;">
        <li>協賛記事・バナーには「PR」「広告」と明記します（景品表示法のステルスマーケティング規制に従います）。</li>
        <li>協賛リンクには <code>rel="sponsored"</code> を付けます（検索順位を目的とした被リンクの販売は行いません）。</li>
        <li>現在、当サイトに広告・スポンサー掲載はありません。掲載を始めた後も、記事の内容やスター数区分をスポンサーの有無で変えることはありません。</li>
      </ul>
    </section>
  </div>
</Layout>
