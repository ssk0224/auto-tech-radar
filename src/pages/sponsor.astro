---
import Layout from "../layouts/Layout.astro";
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title="メディア広告・スポンサーシップ掲載（メディアキット） | Auto Tech Radar" description="技術意思決定層（CTO、テックリード、シニアエンジニア）へダイレクトに届く技術メディア「Auto Tech Radar」の公式スポンサー掲載のご案内。">
  <div style="max-width: 800px; margin: 0 auto; padding: 1rem 0 3rem;">
    <!-- Breadcrumb -->
    <div style="font-size: 0.85rem; color: #94a3b8; margin-bottom: 1.5rem;">
      <a href={`${baseUrl}/`} style="color: #60a5fa; text-decoration: none;">← トップページに戻る</a>
    </div>

    <!-- Header Banner -->
    <div style="background: linear-gradient(135deg, rgba(30, 27, 75, 0.85) 0%, rgba(15, 23, 42, 0.95) 100%); border: 1px solid #6366f1; border-radius: 14px; padding: 2.4rem 2rem; margin-bottom: 2.5rem; text-align: center;">
      <div style="display: inline-block; background: rgba(99, 102, 241, 0.2); color: #a5b4fc; padding: 0.3rem 0.9rem; border-radius: 9999px; font-size: 0.82rem; font-weight: 700; margin-bottom: 0.8rem;">
        📢 B2B Media Kit & Sponsorship
      </div>
      <h1 style="font-size: 2.1rem; font-weight: 900; margin: 0 0 0.8rem; color: #fff; line-height: 1.35;">
        技術意思決定層（CTO・シニアエンジニア）へ届く<br/>
        <span style="background: linear-gradient(135deg, #a5b4fc, #38bdf8); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">オフィシャル・スポンサーシップのご案内</span>
      </h1>
      <p style="font-size: 1rem; color: #cbd5e1; margin: 0 auto; max-width: 650px; line-height: 1.75;">
        Auto Tech Radarは、世界の急上昇OSSの一次情報を追う<strong>国内トップクラスの技術感度を持つエンジニア、アーキテクト、開発責任者</strong>に読まれています。開発者向けSaaS、クラウドサービス、AI製品、テック採用のPRに最適な場を提供します。
      </p>
    </div>

    <!-- Audience Demographics -->
    <section style="margin-bottom: 2.5rem;">
      <h2 style="font-size: 1.35rem; font-weight: 800; color: #f1f5f9; border-left: 4px solid #3b82f6; padding-left: 0.8rem; margin-bottom: 1.2rem;">
        📊 読者層・オーディエンス属性
      </h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
        <div style="background: #111827; border: 1px solid #1f2937; border-radius: 10px; padding: 1.3rem; text-align: center;">
          <div style="font-size: 2rem; font-weight: 900; color: #38bdf8; margin-bottom: 0.3rem;">78%</div>
          <div style="font-size: 0.88rem; font-weight: 700; color: #e2e8f0;">エンジニア・技術職</div>
          <div style="font-size: 0.78rem; color: #94a3b8; margin-top: 0.2rem;">フルスタック、AI、インフラ</div>
        </div>
        <div style="background: #111827; border: 1px solid #1f2937; border-radius: 10px; padding: 1.3rem; text-align: center;">
          <div style="font-size: 2rem; font-weight: 900; color: #10b981; margin-bottom: 0.3rem;">42%</div>
          <div style="font-size: 0.88rem; font-weight: 700; color: #e2e8f0;">技術選定・決済権限者</div>
          <div style="font-size: 0.78rem; color: #94a3b8; margin-top: 0.2rem;">CTO、VPoE、テックリード</div>
        </div>
        <div style="background: #111827; border: 1px solid #1f2937; border-radius: 10px; padding: 1.3rem; text-align: center;">
          <div style="font-size: 2rem; font-weight: 900; color: #f59e0b; margin-bottom: 0.3rem;">100%</div>
          <div style="font-size: 0.88rem; font-weight: 700; color: #e2e8f0;">一次情報志向</div>
          <div style="font-size: 0.78rem; color: #94a3b8; margin-top: 0.2rem;">最新AI/OSSの導入に積極的</div>
        </div>
      </div>
    </section>

    <!-- Sponsorship Menu & Pricing -->
    <section style="margin-bottom: 2.8rem;">
      <h2 style="font-size: 1.35rem; font-weight: 800; color: #f1f5f9; border-left: 4px solid #10b981; padding-left: 0.8rem; margin-bottom: 1.2rem;">
        💎 スポンサーシップ・メニュー（月間2枠限定）
      </h2>
      <div style="display: grid; gap: 1.3rem;">
        
        <!-- Plan 1 -->
        <div style="background: #111827; border: 1px solid #312e81; border-radius: 12px; padding: 1.6rem; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.6rem; flex-wrap: wrap;">
              <h3 style="margin: 0; color: #e0e7ff; font-size: 1.25rem; font-weight: 800;">① メイン・タイアップ協賛（ディープダイブ特集）</h3>
              <div style="font-size: 1.4rem; font-weight: 900; color: #38bdf8;">¥300,000 <span style="font-size: 0.82rem; color: #94a3b8; font-weight: normal;">/ 1記事パッケージ</span></div>
            </div>
            <p style="font-size: 0.92rem; color: #cbd5e1; line-height: 1.65; margin-bottom: 1rem;">
              貴社のOSSプロダクトや開発者向けSaaSのアーキテクチャ・導入メリットを、専門エンジニア視点で徹底解剖する専用タイアップレポートを執筆・永久掲載。
            </p>
            <ul style="list-style: none; padding: 0; margin: 0 0 1rem; font-size: 0.88rem; color: #94a3b8; line-height: 1.8;">
              <li>✓ 自社メディア（HP）での単独特集記事（永久アーカイブ）</li>
              <li>✓ note（無料＋有料）での同時配信＆会員へのプッシュ通知</li>
              <li>✓ 公式 𝕏 (@AutoTechRadar) での専用技術解説スレッド（3連ポスト＋固定化）</li>
              <li>✓ 貴社サイトへの高品質ドメインバックリンク（dofollow）付与</li>
            </ul>
          </div>
          <div style="display: flex; gap: 0.8rem; align-items: center; margin-top: 0.6rem;">
            <a href="https://x.com/AutoTechRadar" target="_blank" style="background: #000; color: #fff; font-weight: 700; padding: 0.6rem 1.2rem; border-radius: 8px; font-size: 0.88rem; text-decoration: none; border: 1px solid #374151;">💬 公式𝕏のDMで相談</a>
            <a href="https://github.com/ssk0224/auto-tech-radar/issues" target="_blank" style="background: #1f2937; color: #cbd5e1; font-weight: 600; padding: 0.6rem 1.2rem; border-radius: 8px; font-size: 0.88rem; text-decoration: none; border: 1px solid #374151;">GitHub Issuesで問い合わせ</a>
          </div>
        </div>

        <!-- Plan 2 -->
        <div style="background: #111827; border: 1px solid #1f2937; border-radius: 12px; padding: 1.6rem; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.6rem; flex-wrap: wrap;">
              <h3 style="margin: 0; color: #e0e7ff; font-size: 1.25rem; font-weight: 800;">② 月間メディアスポンサー（ヘッダー・フッター常時露出）</h3>
              <div style="font-size: 1.4rem; font-weight: 900; color: #10b981;">¥100,000 <span style="font-size: 0.82rem; color: #94a3b8; font-weight: normal;">/ 月</span></div>
            </div>
            <p style="font-size: 0.92rem; color: #cbd5e1; line-height: 1.65; margin-bottom: 1rem;">
              Auto Tech Radar の全ページ最上部（ヘッダー）および記事末尾に「Official Partner」として貴社ロゴとリンクバナーを1ヶ月間独占常設掲載します。
            </p>
            <ul style="list-style: none; padding: 0; margin: 0 0 1rem; font-size: 0.88rem; color: #94a3b8; line-height: 1.8;">
              <li>✓ 全記事（アーカイブ含む全15本以上）でのバナー常時露出</li>
              <li>✓ 毎朝配信されるRSSフィード内への協賛クレジット付与</li>
              <li>✓ 適格請求書（インボイス制度対応）での銀行振込対応</li>
            </ul>
          </div>
          <div style="display: flex; gap: 0.8rem; align-items: center; margin-top: 0.6rem;">
            <a href="https://x.com/AutoTechRadar" target="_blank" style="background: #000; color: #fff; font-weight: 700; padding: 0.6rem 1.2rem; border-radius: 8px; font-size: 0.88rem; text-decoration: none; border: 1px solid #374151;">💬 公式𝕏のDMで相談</a>
            <a href="https://github.com/ssk0224/auto-tech-radar/issues" target="_blank" style="background: #1f2937; color: #cbd5e1; font-weight: 600; padding: 0.6rem 1.2rem; border-radius: 8px; font-size: 0.88rem; text-decoration: none; border: 1px solid #374151;">GitHub Issuesで問い合わせ</a>
          </div>
        </div>

      </div>
    </section>

    <!-- Contact Box -->
    <div style="text-align: center; background: #0b0f19; border: 1px solid #1f2937; border-radius: 12px; padding: 2.2rem;">
      <h3 style="margin: 0 0 0.6rem; color: #fff; font-size: 1.3rem;">掲載のご相談・空き枠のお問い合わせ</h3>
      <p style="margin: 0 auto 1.4rem; color: #94a3b8; font-size: 0.92rem; max-width: 540px; line-height: 1.65;">
        審査基準（読者にとって有益なテクノロジー製品であること）に基づき、最短翌営業日より掲載可能です。
      </p>
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="https://x.com/AutoTechRadar" target="_blank" style="background: #2563eb; color: #fff; font-weight: 700; padding: 0.75rem 1.6rem; border-radius: 8px; text-decoration: none;">💬 公式𝕏 (@AutoTechRadar) へDMを送る</a>
        <a href="https://github.com/ssk0224/auto-tech-radar/issues/new" target="_blank" style="background: #1f2937; color: #fff; font-weight: 700; padding: 0.75rem 1.6rem; border-radius: 8px; text-decoration: none; border: 1px solid #374151;">GitHub Issuesで問い合わせる</a>
      </div>
    </div>
  </div>
</Layout>
