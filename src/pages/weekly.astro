---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../config/site.js";
import { getArticles, pubTime } from "../utils/articles.js";

// 直近7日（ビルド時点）に公開された記事のみ。pubDate 降順・ノイズ除外は getArticles 側
const WEEK_MS = 7 * 24 * 60 * 60 * 1000;
const nowMs = Date.now();
const topPosts = (getArticles() as any[])
  .filter((p) => {
    const t = pubTime(p);
    return t !== null && nowMs - t <= WEEK_MS && t <= nowMs + 24 * 60 * 60 * 1000;
  })
  .slice(0, 7);
---

<Layout
  title="【今週の新着OSS】週間テックレーダー白書 | Auto Tech Radar"
  description="直近7日間に当サイトで取り上げたOSSの一覧。各記事へのリンクと概要をまとめた週間ダイジェストです。"
>
  <div style="max-width: 860px; margin: 0 auto; padding-bottom: 3rem;">
    <!-- ヘッダー -->
    <div style="background: linear-gradient(135deg, rgba(30, 27, 75, 0.4) 0%, rgba(15, 23, 42, 0.9) 100%); border: 1px solid #4338ca; border-radius: 16px; padding: 2.2rem 1.5rem; text-align: center; margin-bottom: 2rem;">
      <div style="display: inline-block; background: rgba(99, 102, 241, 0.25); color: #c7d2fe; padding: 0.25rem 0.8rem; border-radius: 9999px; font-size: 0.8rem; font-weight: 700; margin-bottom: 0.8rem;">
        ⚡ Weekly Tech Radar Executive Whitepaper
      </div>
      <h1 style="font-size: 2.2rem; font-weight: 900; margin: 0 0 0.8rem; color: #fff; line-height: 1.3;">
        GitHub急上昇の<br/>
        <span style="background: linear-gradient(135deg, #a5b4fc, #38bdf8); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">今週取り上げたOSS（週間ダイジェスト）</span>
      </h1>
      <p style="font-size: 1rem; color: #94a3b8; max-width: 680px; margin: 0 auto 1.5rem; line-height: 1.7;">
        直近7日間に当サイトで取り上げたオープンソースの一覧です。詳細は各記事をご覧ください。
      </p>

      <div style="display: flex; gap: 0.6rem; justify-content: center; flex-wrap: wrap;">
        <button onclick="window.print()" style="background: #4338ca; color: #fff; border: none; padding: 0.6rem 1.2rem; border-radius: 8px; font-weight: 700; font-size: 0.88rem; cursor: pointer;">
          🖨️ A4白書として印刷 / PDF保存
        </button>
        <button id="copy-summary-btn" style="background: #1e293b; border: 1px solid #334155; color: #93c5fd; padding: 0.6rem 1.2rem; border-radius: 8px; font-weight: 700; font-size: 0.88rem; cursor: pointer;">
          📋 社内チャット・週報用にコピー
        </button>
        <a href="https://x.com/AutoTechRadar" target="_blank" style="background: #000; border: 1px solid #374151; color: #fff; padding: 0.6rem 1.2rem; border-radius: 8px; font-weight: 700; font-size: 0.88rem; text-decoration: none;">
          𝕏 @AutoTechRadar 速報
        </a>
      </div>
    </div>

    <!-- 直近7日の新着OSS カード一覧 -->
    {topPosts.length === 0 && (
      <div style="background: #111827; border: 1px solid #1f2937; border-radius: 12px; padding: 2rem 1.5rem; text-align: center; color: #94a3b8; font-size: 0.95rem; line-height: 1.7;">
        直近7日間に公開された記事はまだありません。過去の記事は<a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/`} style="color: #60a5fa;">トップページ</a>からご覧いただけます。
      </div>
    )}
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      {topPosts.map((post, idx) => {
        const slug = post.url.replace(/\/$/, '').split('/').pop();
        // スター数が無い記事は表示しない（仮の数値を出さない）
        const stars = Number(post.frontmatter?.stars) || 0;
        const lang = (post.frontmatter?.tags && post.frontmatter.tags[0]) || 'AI';
        const title = (post.frontmatter?.title || slug).split(' - ')[0].trim();
        const desc = post.frontmatter?.description || '';

        return (
          <div style="background: #111827; border: 1px solid #1f2937; border-radius: 12px; padding: 1.5rem; display: flex; flex-direction: column; gap: 0.8rem; position: relative;">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
              <div style="display: flex; align-items: center; gap: 0.6rem;">
                <span style="background: #2563eb; color: #fff; font-size: 0.78rem; font-weight: 800; padding: 0.2rem 0.6rem; border-radius: 6px;">
                  NEW #{idx + 1}
                </span>
                <h3 style="margin: 0; font-size: 1.25rem; font-weight: 800; color: #fff;">
                  <a href={post.url} style="color: #fff; text-decoration: none;">{title}</a>
                </h3>
              </div>
              <div style="display: flex; gap: 0.5rem; align-items: center;">
                {stars > 0 && <span style="font-size: 0.8rem; color: #fbbf24; font-family: 'JetBrains Mono', monospace; font-weight: 700;">★ {stars.toLocaleString()}</span>}
                <span style="font-size: 0.75rem; background: #1f2937; color: #94a3b8; padding: 0.15rem 0.5rem; border-radius: 4px;">{lang}</span>
              </div>
            </div>

            <p style="margin: 0; font-size: 0.92rem; color: #cbd5e1; line-height: 1.65;">
              {desc}
            </p>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.8rem; background: #0b0f19; border: 1px solid #1f2937; padding: 0.8rem 1rem; border-radius: 8px; font-size: 0.82rem;">
              <div>
                <span style="color: #64748b;">公開日:</span> <strong style="color: #38bdf8;">{post.frontmatter?.pubDate}</strong>
              </div>
              <div style="text-align: right;">
                <a href={post.url} style="color: #60a5fa; font-weight: 700; text-decoration: none;">完全解剖レポートを読む →</a>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <!-- フッターCTA -->
    <div style="margin-top: 2.5rem; background: #1e293b; border: 1px solid #334155; border-radius: 12px; padding: 1.5rem; text-align: center;">
      <h3 style="margin: 0 0 0.5rem; color: #fff; font-size: 1.2rem;">社内DX・AIエージェントの受託開発・導入をご検討の企業様へ</h3>
      <p style="color: #94a3b8; font-size: 0.9rem; margin: 0 0 1.2rem;">
        本ページに掲載のOSSを用いた社内導入・クラウド配備・UIカスタマイズなどについて、導入支援のご相談を受け付けています。
      </p>
      <div style="display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap;">
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/estimate/`} style="background: #10b981; color: #042f2e; padding: 0.6rem 1.2rem; border-radius: 8px; font-weight: 800; font-size: 0.88rem; text-decoration: none;">
          ⚡ 開発費用の即時試算シミュレーター
        </a>
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/contact/`} style="background: #2563eb; color: #fff; padding: 0.6rem 1.2rem; border-radius: 8px; font-weight: 700; font-size: 0.88rem; text-decoration: none;">
          📩 受託開発・AI導入の無料相談
        </a>
      </div>
    </div>
  </div>

  <script is:inline>
    const copyBtn = document.getElementById('copy-summary-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        let text = `【今週取り上げたOSS（週間ダイジェスト）】\n\n`;
        document.querySelectorAll('h3 a').forEach((a, idx) => {
          text += `${idx + 1}. ${a.textContent.trim()} - ${a.href}\n`;
        });
        text += `\n▼ 詳細レポート・商用化チートシート\nhttps://ssk0224.github.io/auto-tech-radar/weekly/\n`;
        navigator.clipboard.writeText(text).then(() => {
          copyBtn.textContent = '✓ 週報テキストをコピー完了！';
          copyBtn.style.color = '#10b981';
          setTimeout(() => {
            copyBtn.textContent = '📋 社内チャット・週報用にコピー';
            copyBtn.style.color = '#93c5fd';
          }, 2500);
        });
      });
    }
  </script>
</Layout>
