    <meta name="twitter:site" content="@AutoTechRadar" />
    <meta name="twitter:creator" content="@AutoTechRadar" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={`https://ssk0224.github.io${Astro.url.pathname}`} />
