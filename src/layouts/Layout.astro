    <!-- UX & Reading Performance Script -->
    <script is:inline>
      // Runtime URL & Path Helpers (Zero ReferenceError guarantee)
      const baseUrl = window.location.pathname.startsWith('/auto-tech-radar') ? '/auto-tech-radar' : '';
      const currentSlug = window.location.pathname.split('/').filter(Boolean).pop() || '';

      // innerHTML のテンプレートに入れる文字列は必ずエスケープする
      const esc = (v) => String(v).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

      // Reading progress bar & Sticky action bar trigger
      window.addEventListener('scroll', () => {
        const winScroll = document.documentElement.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = (winScroll / height) * 100;
        const bar = document.getElementById('reading-progress');
        if (bar) bar.style.width = scrolled + '%';

        // 35%以上スクロールでフワッと出現、最下部付近でも維持
        const stickyBar = document.getElementById('sticky-bar');
        if (stickyBar) {
          if (scrolled > 30) {
            stickyBar.style.bottom = '0px';
          } else {
            stickyBar.style.bottom = '-80px';
          }
        }
      });

      // Code blocks 1-click copy button
      document.querySelectorAll('pre').forEach((pre) => {
        if (
          pre.querySelector('code.language-mermaid') || 
          pre.classList.contains('mermaid') || 
          pre.classList.contains('mermaid-container') ||
          pre.getAttribute('data-language') === 'mermaid'
        ) return;
        const wrapper = document.createElement('div');
        wrapper.style.position = 'relative';
        pre.parentNode.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);

        const btn = document.createElement('button');
        btn.textContent = 'コピー';
        btn.style.position = 'absolute';
        btn.style.top = '8px';
        btn.style.right = '8px';
        btn.style.background = '#1f2937';
        btn.style.color = '#94a3b8';
        btn.style.border = '1px solid #374151';
        btn.style.borderRadius = '4px';
        btn.style.padding = '2px 8px';
        btn.style.fontSize = '12px';
        btn.style.cursor = 'pointer';
        btn.style.zIndex = '5';

        btn.addEventListener('click', () => {
          const codeEl = pre.querySelector('code');
          const codeText = codeEl ? codeEl.innerText : pre.innerText;
          navigator.clipboard.writeText(codeText.trim()).then(() => {
            btn.textContent = '完了！';
            btn.style.color = '#10b981';
            setTimeout(() => {
              btn.textContent = 'コピー';
              btn.style.color = '#94a3b8';
            }, 2000);
          });
        });
        wrapper.appendChild(btn);
      });

      // Automatic Table of Contents (目次) & Reading Time calculation
      // 記事本文のコンテナ（Layout が isArticle のときだけ #article-body を出力する）
      const article = document.getElementById('article-body');
      if (article) {
        const headings = article.querySelectorAll('h2, h3');
        if (headings.length >= 2) {
          const tocBox = document.createElement('div');
          tocBox.id = 'toc-box';
          const tocTitle = document.createElement('h4');
          tocTitle.textContent = '📑 目次 (クイックナビゲーション)';
          const list = document.createElement('ul');
          tocBox.appendChild(tocTitle);
          tocBox.appendChild(list);

          headings.forEach((h, idx) => {
            const id = h.id || ('heading-' + idx);
            h.id = id;
            const li = document.createElement('li');
            li.style.marginLeft = h.tagName === 'H3' ? '1rem' : '0';
            const link = document.createElement('a');
            link.setAttribute('href', '#' + id);
            link.textContent = h.textContent;
            li.appendChild(link);
            list.appendChild(li);
          });

          // 読了時間バッジ & クイック共有バー
          const textLength = article.innerText.length;
          const readMinutes = Math.max(1, Math.ceil(textLength / 600)); // 日本語約600字/分
          const articleTitle = document.title.split('|')[0].trim();
          const pageUrl = window.location.href;
          const mainEl = document.querySelector('main');
          const ringLabel = esc(mainEl ? (mainEl.getAttribute('data-ring') || 'TRIAL') : 'TRIAL');
          const ringColor = esc(mainEl ? (mainEl.getAttribute('data-ring-color') || '#60a5fa') : '#60a5fa');
          const ringBg = esc(mainEl ? (mainEl.getAttribute('data-ring-bg') || 'rgba(59, 130, 246, 0.18)') : 'rgba(59, 130, 246, 0.18)');
          const ringBorder = esc(mainEl ? (mainEl.getAttribute('data-ring-border') || 'rgba(59, 130, 246, 0.4)') : 'rgba(59, 130, 246, 0.4)');

          // はてなブックマークの https ページ用 URL 形式: /entry/s/<host+path>
          const hatenaUrl = 'https://b.hatena.ne.jp/entry/' + (window.location.protocol === 'https:' ? 's/' : '') + window.location.host + window.location.pathname;

          const metaBar = document.createElement('div');
          metaBar.className = 'reading-meta-bar';
          metaBar.innerHTML = `
            <div style="display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap;">
              <a href="${esc(baseUrl)}/radar-map/" title="ThoughtWorksモデル技術成熟度判定" style="text-decoration: none; display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.76rem; font-weight: 800; color: ${ringColor}; background: ${ringBg}; border: 1px solid ${ringBorder}; padding: 0.18rem 0.55rem; border-radius: 9999px;">
                <span>●</span>
                <span>ThoughtWorks: ${ringLabel}</span>
              </a>
              <span class="reading-badge">⏱️ 読了目安: 約 ${readMinutes} 分</span>
              <span>文字数: 約 ${textLength.toLocaleString()} 文字</span>
              <span style="color: #10b981; font-weight: 600;">✓ 商用・マネタイズ分析付き</span>
            </div>
            <div style="margin-left: auto; display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap;">
              <button id="print-article-btn" onclick="window.print()" style="background: rgba(168, 85, 247, 0.15); border: 1px solid rgba(168, 85, 247, 0.4); color: #c084fc; padding: 0.2rem 0.55rem; border-radius: 6px; font-size: 0.76rem; cursor: pointer; font-weight: 700;">
                🖨️ A4印刷/PDF
              </button>
              <button id="copy-proposal-btn" style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); color: #34d399; padding: 0.2rem 0.55rem; border-radius: 6px; font-size: 0.76rem; cursor: pointer; font-weight: 700;">
                📋 提案書ドラフトをコピー
              </button>
              <button id="copy-url-btn" style="background: #1f2937; border: 1px solid #374151; color: #94a3b8; padding: 0.2rem 0.55rem; border-radius: 6px; font-size: 0.76rem; cursor: pointer;">
                🔗 URLコピー
              </button>
              <a href="${esc(hatenaUrl)}" target="_blank" rel="noopener" style="background: rgba(0, 164, 222, 0.15); border: 1px solid rgba(0, 164, 222, 0.4); color: #38bdf8; padding: 0.2rem 0.55rem; border-radius: 6px; font-size: 0.76rem; text-decoration: none; display: inline-flex; align-items: center; font-weight: 700;">
                🅱️ はてブ
              </a>
              <a href="https://twitter.com/intent/tweet?text=${encodeURIComponent(articleTitle + '\n' + pageUrl + '\n#OSS #AutoTechRadar')}" target="_blank" rel="noopener" style="background: #000; border: 1px solid #374151; color: #fff; padding: 0.2rem 0.55rem; border-radius: 6px; font-size: 0.76rem; text-decoration: none; display: inline-flex; align-items: center;">
                𝕏 ポスト
              </a>
            </div>
          `;

          const copyBtn = metaBar.querySelector('#copy-url-btn');
          if (copyBtn) {
            copyBtn.addEventListener('click', () => {
              navigator.clipboard.writeText(pageUrl).then(() => {
                copyBtn.textContent = '完了！';
                copyBtn.style.color = '#10b981';
                setTimeout(() => {
                  copyBtn.textContent = '🔗 URLコピー';
                  copyBtn.style.color = '#94a3b8';
                }, 2000);
              });
            });
          }

          // 1クリック提案書・稟議ドラフト生成
          const copyPropBtn = metaBar.querySelector('#copy-proposal-btn');
          if (copyPropBtn) {
            copyPropBtn.addEventListener('click', () => {
              const proposalText = `# 【社内稟議・提案書】${articleTitle} の導入および商用活用について\n\n` +
                `■ 案件名: ${articleTitle} を活用した業務自動化・DX基盤構築\n` +
                `■ 提案目的: 海外で注目されているOSSを活用し、商用SaaSへの依存を減らしながら自社基盤/顧客システムを構築する。\n` +
                `■ 想定予算規模: （要件定義後に工数から算出して記入）\n` +
                `■ 期待される効果（導入前に自社環境で検証して記入）:\n` +
                `  1. 既存商用SaaSのライセンス費用の削減\n` +
                `  2. ベンダーロックインの低減とオンプレミス/プライベートクラウド運用\n` +
                `  3. AI/エージェント技術の内製化による業務工数の削減\n\n` +
                `■ 詳細技術仕様・商用手順書:\n` +
                `  ${pageUrl}\n`;
              navigator.clipboard.writeText(proposalText).then(() => {
                copyPropBtn.textContent = '✓ 提案書コピー完了！';
                copyPropBtn.style.background = '#065f46';
                setTimeout(() => {
                  copyPropBtn.textContent = '📋 提案書ドラフトをコピー';
                  copyPropBtn.style.background = 'rgba(16, 185, 129, 0.15)';
                }, 2500);
              });
            });
          }

          const firstH1 = article.querySelector('h1');
          
          // ⚡ 30秒エグゼクティブ・サマリー（Executive Summary Box）
          const firstP = article.querySelector('p');
          const summaryText = esc(firstP ? firstP.textContent.slice(0, 240) + '...' : '');
          // 記事のリポジトリURL（frontmatter の repoUrl）。タイトルからは所有者名が分からないため使わない
          const cloneUrlRaw = document.querySelector('main')?.dataset.repoUrl || '';
          const cloneUrl = esc(cloneUrlRaw);
          const summaryBox = document.createElement('div');
          summaryBox.style.cssText = 'background: rgba(30, 41, 59, 0.7); border: 1px solid #3b82f6; border-left: 4px solid #3b82f6; border-radius: 8px; padding: 1.1rem 1.3rem; margin: 1.5rem 0;';
          summaryBox.innerHTML = `
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem; color: #60a5fa; font-weight: 700; font-size: 0.92rem;">
              <span>⚡ 30秒エグゼクティブ・サマリー（結論 ＆ 商用要点）</span>
            </div>
            <p style="margin: 0; font-size: 0.92rem; color: #e2e8f0; line-height: 1.65;">
              ${summaryText}
            </p>
            <div style="display: flex; gap: 1rem; margin-top: 0.8rem; font-size: 0.8rem; color: #94a3b8; flex-wrap: wrap;">
              <span>🎯 活用領域: 受託開発 / 自社SaaS基盤</span>
              <span>💡 ライセンス: 本文の「商用利用可否 & ライセンス考察」参照</span>
            </div>
            <div style="margin-top: 0.9rem; display: flex; flex-direction: column; gap: 0.5rem;">
              <div style="padding: 0.55rem 0.8rem; background: #030712; border: 1px solid #1e293b; border-radius: 6px; display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; font-family: 'JetBrains Mono', monospace; font-size: 0.78rem; flex-wrap: wrap;">
                <div style="color: #cbd5e1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                  <span style="color: #10b981; font-weight: 700;">⚡ 3秒検証:</span> <span style="color: #93c5fd;">git clone ${cloneUrl}</span>
                </div>
                <div style="display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap;">
                  <button id="quick-run-copy-btn" style="background: #1f2937; border: 1px solid #374151; color: #94a3b8; padding: 0.2rem 0.55rem; border-radius: 4px; cursor: pointer; white-space: nowrap; font-size: 0.74rem;">
                    コピー
                  </button>
                  <a rel="noopener" href="https://twitter.com/intent/tweet?text=${encodeURIComponent('【海外急上昇OSS解体新書】' + (document.title.split(' - ')[0] || '').trim() + ' のアーキテクチャ解説👇\n')}&url=${encodeURIComponent(window.location.href)}&via=AutoTechRadar" target="_blank" style="background: #000; border: 1px solid #38bdf8; color: #38bdf8; padding: 0.2rem 0.6rem; border-radius: 4px; text-decoration: none; font-size: 0.74rem; font-weight: 700; display: inline-flex; align-items: center; gap: 0.25rem;">
                    🐦 𝕏 でシェア
                  </a>
                </div>
              </div>

              <div style="padding: 0.55rem 0.8rem; background: rgba(30, 27, 75, 0.45); border: 1px solid rgba(139, 92, 246, 0.35); border-radius: 6px; display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; font-family: 'JetBrains Mono', monospace; font-size: 0.78rem; flex-wrap: wrap;">
                <div style="color: #c4b5fd; display: flex; align-items: center; gap: 0.4rem;">
                  <span style="color: #a78bfa; font-weight: 700;">⚡ 2026最新規格:</span>
                  <span>Claude / Cursor / Windsurf 向け即時開発キット</span>
                </div>
                <div style="display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap;">
                  <button id="copy-cursor-btn" style="background: rgba(56, 189, 248, 0.2); border: 1px solid #38bdf8; color: #bae6fd; padding: 0.2rem 0.6rem; border-radius: 4px; cursor: pointer; font-size: 0.74rem; font-weight: 700; display: inline-flex; align-items: center; gap: 0.3rem;">
                    🤖 .cursorrules コピー
                  </button>
                </div>
              </div>
            </div>
          `;

          const quickRunBtn = summaryBox.querySelector('#quick-run-copy-btn');
          if (quickRunBtn) {
            quickRunBtn.addEventListener('click', () => {
              const cmd = `git clone ${cloneUrlRaw}`;
              navigator.clipboard.writeText(cmd).then(() => {
                quickRunBtn.textContent = '完了！';
                quickRunBtn.style.color = '#10b981';
                setTimeout(() => {
                  quickRunBtn.textContent = 'コピー';
                  quickRunBtn.style.color = '#94a3b8';
                }, 2000);
              });
            });
          }

          const copyCursorBtn = summaryBox.querySelector('#copy-cursor-btn');
          if (copyCursorBtn) {
            copyCursorBtn.addEventListener('click', () => {
              const slug = window.location.pathname.split('/').filter(Boolean).pop() || 'oss';
              const cursorRules = `# Cursor Rules & AI Agent System Prompt: ${articleTitle}\n\n` +
                `## Role & Objective\n` +
                `You are a Senior Solutions Architect specialized in production integration of ${slug}.\n\n` +
                `## Implementation Guidelines\n` +
                `- Strictly adhere to official clean-room architecture and zero-trust standards.\n` +
                `- Implement robust error boundaries, structured logging, and containerized deployment (Docker/Compose).\n` +
                `- Avoid hardcoded credentials; enforce environment variables (.env.example).\n` +
                `- Optimize for low-latency, deterministic execution, and enterprise security compliance.\n`;
              navigator.clipboard.writeText(cursorRules).then(() => {
                copyCursorBtn.textContent = '✓ Rulesコピー完了！';
                copyCursorBtn.style.color = '#38bdf8';
                copyCursorBtn.style.borderColor = '#38bdf8';
                setTimeout(() => {
                  copyCursorBtn.textContent = '🤖 .cursorrules コピー';
                  copyCursorBtn.style.color = '#bae6fd';
                  copyCursorBtn.style.borderColor = '#38bdf8';
                }, 2500);
              });
            });
          }

          if (firstH1) {
            // 動的インフォグラフィック・アイキャッチカード（ByteByteGoスタイル）
            const slug = window.location.pathname.split('/').filter(Boolean).pop();
            if (slug && slug !== 'auto-tech-radar' && !slug.includes('.')) {
              const infographDiv = document.createElement('div');
              infographDiv.style.cssText = 'margin: 1.5rem 0 2rem; border-radius: 12px; overflow: hidden; border: 1px solid #1e293b; background: #030712; box-shadow: 0 10px 30px -10px rgba(0,0,0,0.7); text-align: center;';
              infographDiv.innerHTML = `
                <img src="${esc(baseUrl)}/ogp/${esc(slug)}.svg" 
                     alt="${esc(articleTitle)} アーキテクチャ・商用分析インフォグラフィック" 
                     style="width: 100%; max-height: 420px; object-fit: cover; display: block;" 
                     onerror="this.parentElement.style.display='none';" />
                <div style="padding: 0.5rem 1rem; background: rgba(15, 23, 42, 0.95); font-size: 0.76rem; color: #94a3b8; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #1e293b;">
                  <span>📐 システム構成・商用指標インフォグラフィック</span>
                  <span style="color: #38bdf8; font-weight: 600;">Auto Tech Radar Intelligence</span>
                </div>
              `;
              firstH1.insertAdjacentElement('afterend', infographDiv);
              infographDiv.insertAdjacentElement('afterend', metaBar);
            } else {
              firstH1.insertAdjacentElement('afterend', metaBar);
            }
            metaBar.insertAdjacentElement('afterend', summaryBox);
            summaryBox.insertAdjacentElement('afterend', tocBox);
          } else {
            article.insertBefore(metaBar, article.firstChild);
            metaBar.insertAdjacentElement('afterend', summaryBox);
            summaryBox.insertAdjacentElement('afterend', tocBox);
          }
        }

      }
    </script>

    <!-- ByteByteGoモデル: Mermaid.js 動的アーキテクチャ図解レンダラー -->
    <script type="module" is:inline>
      import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10.9.8/dist/mermaid.esm.min.mjs';
      try {
        mermaid.initialize({
          startOnLoad: false,
          theme: 'dark',
          themeVariables: {
            darkMode: true,
            background: '#0f172a',
            primaryColor: '#3b82f6',
            primaryTextColor: '#f8fafc',
            primaryBorderColor: '#60a5fa',
            lineColor: '#93c5fd',
            secondaryColor: '#1e293b',
            tertiaryColor: '#111827'
          }
        });

        // pre code.language-mermaid および pre[data-language="mermaid"] を検出してSVGダイアグラムに変換
        const mermaidBlocks = document.querySelectorAll('pre code.language-mermaid, pre.mermaid, pre[data-language="mermaid"]');
        if (mermaidBlocks.length > 0) {
          for (let i = 0; i < mermaidBlocks.length; i++) {
            const block = mermaidBlocks[i];
            const pre = block.tagName === 'PRE' ? block : block.closest('pre');
            const code = block.textContent;
            const container = document.createElement('div');
            container.className = 'mermaid-container';
            container.style.cssText = 'background: #0f172a; border: 1px solid #1e293b; border-radius: 10px; padding: 1.5rem; margin: 1.8rem 0; overflow-x: auto; text-align: center;';
            const { svg } = await mermaid.render('mermaid-svg-' + i, code);
            container.innerHTML = svg;
            if (pre && pre.parentNode) {
              pre.parentNode.replaceChild(container, pre);
            }
          }
        }
      } catch (err) {
        console.warn('Mermaid rendering notice:', err);
      }
    </script>
  </body>
</html>
