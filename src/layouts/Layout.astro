---
import { siteConfig } from "../config/site.js";
import { isNoise } from "../../scripts/utils/noise_filter.mjs";
import { getArticles } from "../utils/articles.js";
import noteUrls from "../../scripts/note_urls.json";
const { title, description, frontmatter } = Astro.props;
const pageTitle = title || frontmatter?.title || "Auto Tech Radar | 海外急上昇OSS徹底解剖メディア";
const pageDesc = description || frontmatter?.description || "世界のGitHubトレンドから急上昇OSSを毎朝AIが自動検出し、日本語技術アーキテクチャ解説と受託・SaaSマネタイズ実践法をお届けします。";
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

// 関連記事（Read Next）の推薦ロジック
// 質問応答の構造化データは出さない: 全OSSに同じ回答（商用利用可否・成熟度）を返す形では根拠データが無いため
const isArticle = !!frontmatter;
let relatedPosts: any[] = [];
if (isArticle) {
  const allPosts = getArticles() as any[];
  const currentTags = Array.isArray(frontmatter.tags) ? frontmatter.tags.map((t: string) => t.toLowerCase()) : [];
  const currentTitle = (frontmatter.title || "").toLowerCase();

  // 自記事を除外し、タグ一致スコアまたは最新順でスコアリング
  relatedPosts = allPosts
    .filter(p => p.frontmatter && (p.frontmatter.title || "") !== frontmatter.title)
    .map(p => {
      const pTags = Array.isArray(p.frontmatter?.tags) ? p.frontmatter.tags.map((t: string) => t.toLowerCase()) : [];
      let score = 0;
      currentTags.forEach(ct => {
        if (pTags.includes(ct)) score += 2;
      });
      return { post: p, score };
    })
    .sort((a, b) => b.score - a.score)
    .slice(0, 3)
    .map(item => item.post);
}

// 動的OGP画像（Twitter/SNSクローラーの100%描画のためPNGを完全指定）
const currentSlug = Astro.url.pathname.split('/').filter(Boolean).pop() || '';
const ogImage = (isArticle && currentSlug && currentSlug !== 'auto-tech-radar') 
  ? `https://ssk0224.github.io/auto-tech-radar/ogp/${currentSlug}.png` 
  : "https://ssk0224.github.io/auto-tech-radar/og-card.png";

// 🎯 ThoughtWorks 成熟度リング自動判定 (ADOPT / TRIAL / ASSESS / HOLD)
const starsCount = Number(frontmatter?.stars) || 0;
// この記事の有料版（note）。note に公開済みで対応が取れた記事だけ単発購入を案内する（scripts/sync_note_urls.mjs）
const noteItem = isArticle ? (noteUrls as Record<string, { url: string; price: number | null }>)[currentSlug] : undefined;
const notePriceLabel = noteItem?.price ? `¥${noteItem.price.toLocaleString()}` : "";
// 有料版に実際に含まれる項目（暗号化時に有料部分の見出しから作る。本文は含まない）
const paidSummaries = import.meta.glob("../../note_drafts/*_note.paid.json", { eager: true, import: "default" }) as Record<string, { chars: number; features: string[] }>;
const paidSummary = paidSummaries[`../../note_drafts/${currentSlug}_note.paid.json`];
let ringLabel = "TRIAL";
let ringBadgeColor = "#60a5fa";
let ringBadgeBg = "rgba(59, 130, 246, 0.18)";
let ringBadgeBorder = "rgba(59, 130, 246, 0.4)";
if (starsCount >= 15000) {
  ringLabel = "ADOPT";
  ringBadgeColor = "#34d399";
  ringBadgeBg = "rgba(16, 185, 129, 0.18)";
  ringBadgeBorder = "rgba(16, 185, 129, 0.4)";
} else if (starsCount >= 5000) {
  ringLabel = "TRIAL";
  ringBadgeColor = "#60a5fa";
  ringBadgeBg = "rgba(59, 130, 246, 0.18)";
  ringBadgeBorder = "rgba(59, 130, 246, 0.4)";
} else if (starsCount >= 1000) {
  ringLabel = "ASSESS";
  ringBadgeColor = "#fbbf24";
  ringBadgeBg = "rgba(245, 158, 11, 0.18)";
  ringBadgeBorder = "rgba(245, 158, 11, 0.4)";
} else {
  ringLabel = "HOLD";
  ringBadgeColor = "#94a3b8";
  ringBadgeBg = "rgba(148, 163, 184, 0.18)";
  ringBadgeBorder = "rgba(148, 163, 184, 0.4)";
}
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Auto Tech Radar" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={`https://ssk0224.github.io${Astro.url.pathname}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@AutoTechRadar" />
    <meta name="twitter:creator" content="@AutoTechRadar" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={`https://ssk0224.github.io${Astro.url.pathname}`} />
    <link rel="alternate" type="application/rss+xml" title="Auto Tech Radar RSS Feed" href="https://ssk0224.github.io/auto-tech-radar/rss.xml" />
    <link rel="manifest" href={`${baseUrl}/manifest.json`} />
    <meta name="theme-color" content="#030712" />
    {isArticle && isNoise(currentSlug) && <meta name="robots" content="noindex" />}
    {isArticle ? (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "TechArticle",
        "headline": pageTitle,
        "description": pageDesc,
        "url": `https://ssk0224.github.io${Astro.url.pathname}`,
        "datePublished": frontmatter?.pubDate || "2026-10-09",
        "isAccessibleForFree": true,
        "author": {
          "@type": "Organization",
          "name": "Auto Tech Radar",
          "url": "https://ssk0224.github.io/auto-tech-radar/"
        },
        "publisher": {
          "@type": "Organization",
          "name": "Auto Tech Radar",
          "logo": {
            "@type": "ImageObject",
            "url": "https://ssk0224.github.io/auto-tech-radar/og-card.png"
          }
        },
        "keywords": (frontmatter?.tags || ["OSS", "Tech"]).join(", ")
      })} />
    ) : (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "NewsMediaOrganization",
        "name": "Auto Tech Radar",
        "url": "https://ssk0224.github.io/auto-tech-radar/",
        "sameAs": [
          "https://x.com/AutoTechRadar",
          "https://note.com/vast_ixora7005",
          "https://github.com/ssk0224/auto-tech-radar"
        ],
        "description": "世界の急上昇オープンソースを毎朝自動インデックス化・日本語技術解説とマネタイズ指南"
      })} />
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=JetBrains+Mono:wght@400;600&family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet">
    <style>
      :root {
        --color-primary: #3b82f6;
        --color-primary-hover: #2563eb;
        --color-accent: #10b981;
        --color-purple: #8b5cf6;
        --color-bg: #0b0f19;
        --color-card: #111827;
        --color-card-border: #1f2937;
        --color-text: #f3f4f6;
        --color-text-muted: #9ca3af;
        --color-border: #1f2937;
      }
      * { box-sizing: border-box; }
      body {
        font-family: 'Inter', 'Noto Sans JP', -apple-system, BlinkMacSystemFont, sans-serif;
        line-height: 1.75;
        max-width: 920px;
        margin: 0 auto;
        padding: 1.5rem 1.2rem;
        color: var(--color-text);
        background: var(--color-bg);
      }
      a { color: var(--color-primary); text-decoration: none; transition: color 0.15s; }
      a:hover { color: #60a5fa; text-decoration: underline; }

      /* Global Header */
      header {
        border-bottom: 1px solid var(--color-border);
        margin-bottom: 2rem;
        padding-bottom: 1.2rem;
      }
      .brand-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        background: rgba(59, 130, 246, 0.15);
        color: #60a5fa;
        padding: 0.2rem 0.6rem;
        border-radius: 9999px;
        border: 1px solid rgba(59, 130, 246, 0.3);
        margin-bottom: 0.4rem;
      }
      header .site-title {
        margin: 0;
        font-size: 1.85rem;
        font-weight: 900;
        letter-spacing: -0.02em;
        background: linear-gradient(135deg, #ffffff 40%, #93c5fd 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      header p { margin: 0.3rem 0 0; color: var(--color-text-muted); font-size: 0.92rem; }
      .nav-links { display: flex; gap: 0.5rem; align-items: center; margin-top: 0.5rem; flex-wrap: wrap; }
      .pill-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.4rem 0.85rem;
        border-radius: 8px;
        font-size: 0.82rem;
        font-weight: 600;
        text-decoration: none !important;
        transition: transform 0.1s, opacity 0.15s;
      }
      .pill-btn:hover { transform: translateY(-1px); opacity: 0.9; }
      .btn-x { background: #000; color: #fff !important; border: 1px solid #374151; }
      .btn-note { background: #2cb696; color: #fff !important; }
      .btn-gh { background: #1f2937; color: #e5e7eb !important; border: 1px solid #374151; }

      /* Post Card & Feed (ByteByteGo / TLDR / Substack High-CTR Design) */
      .post-card {
        background: var(--color-card);
        padding: 1.3rem;
        border-radius: 14px;
        border: 1px solid var(--color-card-border);
        margin-bottom: 1.4rem;
        transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s, box-shadow 0.2s;
      }
      .post-card:hover {
        transform: translateY(-2px);
        border-color: rgba(59, 130, 246, 0.5);
        box-shadow: 0 10px 30px -10px rgba(37, 99, 235, 0.2);
      }
      .post-card-inner {
        display: flex;
        gap: 1.4rem;
        align-items: stretch;
      }
      .post-card-thumb {
        flex-shrink: 0;
        width: 250px;
        position: relative;
        border-radius: 10px;
        overflow: hidden;
        background: #0b0f19;
        border: 1px solid rgba(255, 255, 255, 0.08);
      }
      .post-thumb-img {
        width: 100%;
        height: 100%;
        min-height: 135px;
        object-fit: cover;
        display: block;
        transition: transform 0.3s ease;
      }
      .post-card:hover .post-thumb-img {
        transform: scale(1.04);
      }
      .post-thumb-price {
        position: absolute;
        bottom: 8px;
        left: 8px;
        background: rgba(10, 15, 30, 0.88);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(16, 185, 129, 0.5);
        color: #6ee7b7;
        font-size: 0.7rem;
        font-weight: 800;
        padding: 0.15rem 0.5rem;
        border-radius: 6px;
        font-family: 'JetBrains Mono', monospace;
      }
      .post-card-content {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      @media (max-width: 720px) {
        .post-card-inner {
          flex-direction: column;
          gap: 1rem;
        }
        .post-card-thumb {
          width: 100%;
          max-height: 200px;
        }
      }
      .post-card h3 { margin-top: 0; font-size: 1.25rem; font-weight: 700; margin-bottom: 0.4rem; line-height: 1.4; }
      .post-card h3 a { color: #f9fafb; text-decoration: none; }
      .post-card h3 a:hover { color: #60a5fa; text-decoration: underline; }
      .post-card p { margin: 0 0 0.6rem; color: #9ca3af; font-size: 0.92rem; line-height: 1.6; }
      .meta-tag {
        font-size: 0.78rem;
        background: #1f2937;
        color: #cbd5e1;
        padding: 0.2rem 0.5rem;
        border-radius: 6px;
        font-family: 'JetBrains Mono', monospace;
      }

      /* Article Markdown Content */
      article {
        background: var(--color-card);
        border: 1px solid var(--color-card-border);
        border-radius: 14px;
        padding: 2.2rem;
        margin-bottom: 2.5rem;
      }
      article h1 { font-size: 1.85rem; font-weight: 800; border-bottom: 1px solid var(--color-border); padding-bottom: 0.8rem; margin-top: 0; color: #fff; }
      article h2 { font-size: 1.4rem; font-weight: 700; border-left: 4px solid var(--color-primary); padding-left: 0.8rem; margin-top: 2rem; color: #e2e8f0; }
      article h3 { font-size: 1.18rem; font-weight: 700; margin-top: 1.5rem; color: #cbd5e1; }
      article p { color: #d1d5db; font-size: 1rem; line-height: 1.8; }
      article pre {
        background: #030712;
        color: #e5e7eb;
        padding: 1.2rem;
        border-radius: 8px;
        overflow-x: auto;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.88rem;
        border: 1px solid #1f2937;
      }
      article code {
        background: #1f2937;
        color: #93c5fd;
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.88em;
      }
      article pre code { background: transparent; padding: 0; color: inherit; }
      article blockquote {
        border-left: 4px solid #3b82f6;
        background: rgba(59, 130, 246, 0.05);
        margin: 1.5rem 0;
        padding: 0.8rem 1.2rem;
        color: #93c5fd;
        border-radius: 0 8px 8px 0;
      }
      article table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5rem 0;
        font-size: 0.92rem;
        display: block;
        overflow-x: auto;
        max-width: 100%;
        -webkit-overflow-scrolling: touch;
      }
      article th, article td {
        border: 1px solid var(--color-card-border);
        padding: 0.7rem 0.9rem;
        text-align: left;
      }
      article th { background: #1e293b; color: #f1f5f9; white-space: nowrap; }
      article td { background: #0f172a; }

      /* Visual Paywall & Content Lock */
      .paywall-divider {
        position: relative;
        text-align: center;
        margin: 3rem 0 2rem;
      }
      .paywall-divider::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, #6366f1, transparent);
      }
      .paywall-badge {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: #1e1b4b;
        color: #a5b4fc;
        border: 1px solid #4338ca;
        padding: 0.4rem 1.2rem;
        border-radius: 9999px;
        font-size: 0.85rem;
        font-weight: 700;
        box-shadow: 0 4px 15px rgba(67, 56, 202, 0.4);
      }

      /* World-Class Freemium Content Gate */
      .atr-locked-preview {
        position: relative;
        max-height: 240px;
        overflow: hidden;
        filter: blur(4px);
        opacity: 0.55;
        user-select: none;
        pointer-events: none;
        -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.7) 35%, transparent 100%);
        mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.7) 35%, transparent 100%);
        transition: filter 0.3s ease, opacity 0.3s ease, max-height 0.3s ease;
      }
      .atr-locked-preview.unlocked {
        max-height: none !important;
        overflow: visible !important;
        filter: none !important;
        opacity: 1 !important;
        -webkit-mask-image: none !important;
        mask-image: none !important;
        user-select: auto !important;
        pointer-events: auto !important;
      }
      .atr-paywall-gate {
        position: relative;
        margin: -40px 0 2.5rem;
        background: linear-gradient(135deg, rgba(30, 27, 75, 0.98) 0%, rgba(15, 23, 42, 0.99) 100%);
        border: 2px solid #6366f1;
        border-radius: 16px;
        padding: 2.2rem 1.8rem;
        text-align: center;
        box-shadow: 0 20px 45px -5px rgba(99, 102, 241, 0.4);
        z-index: 10;
      }

      /* Monetization Offer Card */
      .monetization-box {
        background: linear-gradient(135deg, #1e1b4b 0%, #0f172a 100%);
        border: 1px solid #4338ca;
        border-radius: 14px;
        padding: 2rem 1.8rem;
        margin: 2.5rem 0;
        text-align: center;
        box-shadow: 0 10px 25px -5px rgba(67, 56, 202, 0.25);
      }
      .monetization-box h3 { margin: 0 0 0.5rem; color: #e0e7ff; font-size: 1.35rem; font-weight: 800; }
      .monetization-box p { margin: 0 auto 1.4rem; font-size: 0.95rem; color: #a5b4fc; max-width: 600px; }
      .pricing-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.2rem;
        margin-top: 1.2rem;
        text-align: left;
      }
      .price-card {
        background: #0f172a;
        border: 1px solid #312e81;
        border-radius: 10px;
        padding: 1.3rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      .price-card.featured {
        border-color: #6366f1;
        background: rgba(30, 27, 75, 0.6);
        position: relative;
      }
      .badge-rec {
        position: absolute;
        top: -10px;
        right: 12px;
        background: #6366f1;
        color: #fff;
        font-size: 0.7rem;
        padding: 0.15rem 0.5rem;
        border-radius: 9999px;
        font-weight: 700;
      }
      .price-card h4 { margin: 0 0 0.4rem; font-size: 1.05rem; color: #fff; }
      .price-val { font-size: 1.6rem; font-weight: 800; color: #38bdf8; margin-bottom: 0.6rem; }
      .price-val span { font-size: 0.85rem; color: #94a3b8; font-weight: normal; }
      .feature-list { list-style: none; padding: 0; margin: 0 0 1.2rem; font-size: 0.85rem; color: #cbd5e1; }
      .feature-list li { margin-bottom: 0.4rem; display: flex; align-items: center; gap: 0.4rem; }
      .cta-btn {
        display: block;
        text-align: center;
        padding: 0.75rem 1rem;
        border-radius: 8px;
        font-weight: 700;
        font-size: 0.92rem;
        text-decoration: none !important;
        transition: transform 0.1s, filter 0.15s;
      }
      .cta-btn:hover { transform: translateY(-1px); filter: brightness(1.1); }
      .cta-primary { background: #635bff; color: #fff !important; }
      .cta-note { background: #2cb696; color: #fff !important; }

      footer {
        margin-top: 4rem;
        font-size: 0.88rem;
        color: var(--color-text-muted);
        border-top: 1px solid var(--color-border);
        padding-top: 1.8rem;
        text-align: center;
      }
      /* Reading progress bar */
      #reading-progress {
        position: fixed;
        top: 0;
        left: 0;
        height: 3px;
        background: linear-gradient(90deg, #3b82f6, #10b981);
        width: 0%;
        z-index: 9999;
        transition: width 0.1s ease;
      }
      /* Reading time badge & Table of Contents */
      .reading-meta-bar {
        display: flex;
        gap: 0.8rem;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 0.8rem;
        border-bottom: 1px solid var(--color-border);
        font-size: 0.82rem;
        color: var(--color-text-muted);
        flex-wrap: wrap;
      }
      .reading-badge {
        background: rgba(59, 130, 246, 0.15);
        color: #93c5fd;
        padding: 0.2rem 0.5rem;
        border-radius: 6px;
        font-weight: 600;
      }
      #toc-box {
        background: rgba(17, 24, 39, 0.7);
        border: 1px solid #1f2937;
        border-radius: 10px;
        padding: 1.2rem 1.4rem;
        margin: 1.5rem 0 2rem;
      }
      #toc-box h4 {
        margin: 0 0 0.8rem;
        font-size: 0.95rem;
        color: #e2e8f0;
        display: flex;
        align-items: center;
        gap: 0.4rem;
      }
      #toc-box ul {
        margin: 0;
        padding-left: 1.2rem;
        font-size: 0.88rem;
        color: #94a3b8;
      }
      #toc-box li { margin-bottom: 0.35rem; }
      #toc-box a { color: #93c5fd; text-decoration: none; }
      #toc-box a:hover { text-decoration: underline; color: #60a5fa; }

      /* Mobile Responsive Optimization for Conversion Elements */
      @media (max-width: 640px) {
        #sticky-bar {
          padding: 0.6rem 0.8rem !important;
          gap: 0.5rem !important;
        }
        .sticky-text {
          display: none !important;
        }
        #sticky-bar > div:last-child {
          width: 100% !important;
          display: flex !important;
          gap: 0.5rem !important;
        }
        #sticky-bar a {
          flex: 1 !important;
          text-align: center !important;
          padding: 0.65rem 0.4rem !important;
          font-size: 0.82rem !important;
          min-height: 44px;
          display: inline-flex !important;
          align-items: center;
          justify-content: center;
        }
      }

      /* A4資料・PDF保存用の完全印刷スタイル（ByteByteGoホワイトペーパースタイル） */
      @media print {
        body { background: #fff !important; color: #000 !important; font-size: 11pt; }
        header, .nav-links, footer, .reading-meta-bar button, .reading-meta-bar a,
        #reading-progress, .paywall-divider, .monetization-box,
        .btn-gh, .btn-x, .btn-note, #copy-cheatsheet-url, #copy-cheatsheet-md,
        #export-cheatsheet-csv, #filter-search, #print-pdf-btn {
          display: none !important;
        }
        main { max-width: 100% !important; margin: 0 !important; padding: 0 !important; }
