---
const { title, description, frontmatter } = Astro.props;
const pageTitle = title || frontmatter?.title || "Auto Tech Radar | 海外急上昇OSS徹底解剖メディア";
const pageDesc = description || frontmatter?.description || "世界のGitHubトレンドから急上昇OSSを毎朝AIが自動検出し、日本語技術アーキテクチャ解説と受託・SaaSマネタイズ実践法をお届けします。";
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Auto Tech Radar" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@AutoTechRadar" />
    <meta name="twitter:creator" content="@AutoTechRadar" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <link rel="canonical" href="https://ssk0224.github.io/auto-tech-radar/" />
    <link rel="alternate" type="application/rss+xml" title="Auto Tech Radar RSS Feed" href="https://ssk0224.github.io/auto-tech-radar/rss.xml" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "NewsMediaOrganization",
      "name": "Auto Tech Radar",
      "url": "https://ssk0224.github.io/auto-tech-radar/",
      "sameAs": [
        "https://x.com/AutoTechRadar",
        "https://note.com/vast_ixora7005",
        "https://github.com/ssk0224/auto-tech-radar"
      ],
      "description": "世界の急上昇オープンソースを毎朝自動インデックス化・日本語技術解説とマネタイズ指南"
    })} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=JetBrains+Mono:wght@400;600&family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet">
    <style>
      :root {
        --color-primary: #3b82f6;
        --color-primary-hover: #2563eb;
        --color-accent: #10b981;
        --color-purple: #8b5cf6;
        --color-bg: #0b0f19;
        --color-card: #111827;
        --color-card-border: #1f2937;
        --color-text: #f3f4f6;
        --color-text-muted: #9ca3af;
        --color-border: #1f2937;
      }
      * { box-sizing: border-box; }
      body {
        font-family: 'Inter', 'Noto Sans JP', -apple-system, BlinkMacSystemFont, sans-serif;
        line-height: 1.75;
        max-width: 920px;
        margin: 0 auto;
        padding: 1.5rem 1.2rem;
        color: var(--color-text);
        background: var(--color-bg);
      }
      a { color: var(--color-primary); text-decoration: none; transition: color 0.15s; }
      a:hover { color: #60a5fa; text-decoration: underline; }

      /* Global Header */
      header {
        border-bottom: 1px solid var(--color-border);
        margin-bottom: 2rem;
        padding-bottom: 1.2rem;
      }
      .brand-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        background: rgba(59, 130, 246, 0.15);
        color: #60a5fa;
        padding: 0.2rem 0.6rem;
        border-radius: 9999px;
        border: 1px solid rgba(59, 130, 246, 0.3);
        margin-bottom: 0.4rem;
      }
      header h1 {
        margin: 0;
        font-size: 1.85rem;
        font-weight: 900;
        letter-spacing: -0.02em;
        background: linear-gradient(135deg, #ffffff 40%, #93c5fd 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      header p { margin: 0.3rem 0 0; color: var(--color-text-muted); font-size: 0.92rem; }
      .nav-links { display: flex; gap: 0.5rem; align-items: center; margin-top: 0.5rem; flex-wrap: wrap; }
      .pill-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.4rem 0.85rem;
        border-radius: 8px;
        font-size: 0.82rem;
        font-weight: 600;
        text-decoration: none !important;
        transition: transform 0.1s, opacity 0.15s;
      }
      .pill-btn:hover { transform: translateY(-1px); opacity: 0.9; }
      .btn-x { background: #000; color: #fff !important; border: 1px solid #374151; }
      .btn-note { background: #2cb696; color: #fff !important; }
      .btn-gh { background: #1f2937; color: #e5e7eb !important; border: 1px solid #374151; }

      /* Post Card & Feed */
      .post-card {
        background: var(--color-card);
        padding: 1.6rem;
        border-radius: 12px;
        border: 1px solid var(--color-card-border);
        margin-bottom: 1.2rem;
        transition: transform 0.15s, border-color 0.15s;
      }
      .post-card:hover {
        transform: translateY(-2px);
        border-color: #3b82f6;
      }
      .post-card h3 { margin-top: 0; font-size: 1.35rem; font-weight: 700; margin-bottom: 0.5rem; }
      .post-card h3 a { color: #f9fafb; }
      .post-card p { margin: 0 0 0.8rem; color: #9ca3af; font-size: 0.95rem; }
      .meta-tag {
        font-size: 0.78rem;
        background: #1f2937;
        color: #cbd5e1;
        padding: 0.2rem 0.5rem;
        border-radius: 6px;
        font-family: 'JetBrains Mono', monospace;
      }

      /* Article Markdown Content */
      article {
        background: var(--color-card);
        border: 1px solid var(--color-card-border);
        border-radius: 14px;
        padding: 2.2rem;
        margin-bottom: 2.5rem;
      }
      article h1 { font-size: 1.85rem; font-weight: 800; border-bottom: 1px solid var(--color-border); padding-bottom: 0.8rem; margin-top: 0; color: #fff; }
      article h2 { font-size: 1.4rem; font-weight: 700; border-left: 4px solid var(--color-primary); padding-left: 0.8rem; margin-top: 2rem; color: #e2e8f0; }
      article h3 { font-size: 1.18rem; font-weight: 700; margin-top: 1.5rem; color: #cbd5e1; }
      article p { color: #d1d5db; font-size: 1rem; line-height: 1.8; }
      article pre {
        background: #030712;
        color: #e5e7eb;
        padding: 1.2rem;
        border-radius: 8px;
        overflow-x: auto;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.88rem;
        border: 1px solid #1f2937;
      }
      article code {
        background: #1f2937;
        color: #93c5fd;
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.88em;
      }
      article pre code { background: transparent; padding: 0; color: inherit; }
      article blockquote {
        border-left: 4px solid #3b82f6;
        background: rgba(59, 130, 246, 0.05);
        margin: 1.5rem 0;
        padding: 0.8rem 1.2rem;
        color: #93c5fd;
        border-radius: 0 8px 8px 0;
      }
      article table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5rem 0;
        font-size: 0.92rem;
      }
      article th, article td {
        border: 1px solid var(--color-card-border);
        padding: 0.7rem 0.9rem;
        text-align: left;
      }
      article th { background: #1e293b; color: #f1f5f9; }
      article td { background: #0f172a; }

      /* Visual Paywall & Content Lock */
      .paywall-divider {
        position: relative;
        text-align: center;
        margin: 3rem 0 2rem;
      }
      .paywall-divider::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, #6366f1, transparent);
      }
      .paywall-badge {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: #1e1b4b;
        color: #a5b4fc;
        border: 1px solid #4338ca;
        padding: 0.4rem 1.2rem;
        border-radius: 9999px;
        font-size: 0.85rem;
        font-weight: 700;
        box-shadow: 0 4px 15px rgba(67, 56, 202, 0.4);
      }

      /* Monetization Offer Card */
      .monetization-box {
        background: linear-gradient(135deg, #1e1b4b 0%, #0f172a 100%);
        border: 1px solid #4338ca;
        border-radius: 14px;
        padding: 2rem 1.8rem;
        margin: 2.5rem 0;
        text-align: center;
        box-shadow: 0 10px 25px -5px rgba(67, 56, 202, 0.25);
      }
      .monetization-box h3 { margin: 0 0 0.5rem; color: #e0e7ff; font-size: 1.35rem; font-weight: 800; }
      .monetization-box p { margin: 0 auto 1.4rem; font-size: 0.95rem; color: #a5b4fc; max-width: 600px; }
      .pricing-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.2rem;
        margin-top: 1.2rem;
        text-align: left;
      }
      .price-card {
        background: #0f172a;
        border: 1px solid #312e81;
        border-radius: 10px;
        padding: 1.3rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      .price-card.featured {
        border-color: #6366f1;
        background: rgba(30, 27, 75, 0.6);
        position: relative;
      }
      .badge-rec {
        position: absolute;
        top: -10px;
        right: 12px;
        background: #6366f1;
        color: #fff;
        font-size: 0.7rem;
        padding: 0.15rem 0.5rem;
        border-radius: 9999px;
        font-weight: 700;
      }
      .price-card h4 { margin: 0 0 0.4rem; font-size: 1.05rem; color: #fff; }
      .price-val { font-size: 1.6rem; font-weight: 800; color: #38bdf8; margin-bottom: 0.6rem; }
      .price-val span { font-size: 0.85rem; color: #94a3b8; font-weight: normal; }
      .feature-list { list-style: none; padding: 0; margin: 0 0 1.2rem; font-size: 0.85rem; color: #cbd5e1; }
      .feature-list li { margin-bottom: 0.4rem; display: flex; align-items: center; gap: 0.4rem; }
      .cta-btn {
        display: block;
        text-align: center;
        padding: 0.75rem 1rem;
        border-radius: 8px;
        font-weight: 700;
        font-size: 0.92rem;
        text-decoration: none !important;
        transition: transform 0.1s, filter 0.15s;
      }
      .cta-btn:hover { transform: translateY(-1px); filter: brightness(1.1); }
      .cta-primary { background: #635bff; color: #fff !important; }
      .cta-note { background: #2cb696; color: #fff !important; }

      footer {
        margin-top: 4rem;
        font-size: 0.88rem;
        color: var(--color-text-muted);
        border-top: 1px solid var(--color-border);
        padding-top: 1.8rem;
        text-align: center;
      }
      /* Reading progress bar */
      #reading-progress {
        position: fixed;
        top: 0;
        left: 0;
        height: 3px;
        background: linear-gradient(90deg, #3b82f6, #10b981);
        width: 0%;
        z-index: 9999;
        transition: width 0.1s ease;
      }
      /* Reading time badge & Table of Contents */
      .reading-meta-bar {
        display: flex;
        gap: 0.8rem;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 0.8rem;
        border-bottom: 1px solid var(--color-border);
        font-size: 0.82rem;
        color: var(--color-text-muted);
        flex-wrap: wrap;
      }
      .reading-badge {
        background: rgba(59, 130, 246, 0.15);
        color: #93c5fd;
        padding: 0.2rem 0.5rem;
        border-radius: 6px;
        font-weight: 600;
      }
      #toc-box {
        background: rgba(17, 24, 39, 0.7);
        border: 1px solid #1f2937;
        border-radius: 10px;
        padding: 1.2rem 1.4rem;
        margin: 1.5rem 0 2rem;
      }
      #toc-box h4 {
        margin: 0 0 0.8rem;
        font-size: 0.95rem;
        color: #e2e8f0;
        display: flex;
        align-items: center;
        gap: 0.4rem;
      }
      #toc-box ul {
        margin: 0;
        padding-left: 1.2rem;
        font-size: 0.88rem;
        color: #94a3b8;
      }
      #toc-box li { margin-bottom: 0.35rem; }
      #toc-box a { color: #93c5fd; text-decoration: none; }
      #toc-box a:hover { text-decoration: underline; color: #60a5fa; }
    </style>
  </head>
  <body>
    <div id="reading-progress"></div>
    <header>
      <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
        <div>
          <div class="brand-badge">⚡ Global OSS Intelligence</div>
          <h1><a href={`${baseUrl}/`}>📡 Auto Tech Radar</a></h1>
          <p>世界の急上昇オープンソースを毎朝自動インデックス化・日本語技術解説 ＆ マネタイズ分析</p>
        </div>
        <div class="nav-links">
          <a href="https://x.com/AutoTechRadar" target="_blank" class="pill-btn btn-x">𝕏 @AutoTechRadar</a>
          <a href="https://note.com/vast_ixora7005" target="_blank" class="pill-btn btn-note">note 公式ページ</a>
          <a href={`${baseUrl}/rss.xml`} target="_blank" class="pill-btn" style="background: #f97316; color: #fff !important;">📡 RSS購読</a>
          <a href="https://github.com/ssk0224/auto-tech-radar" target="_blank" class="pill-btn btn-gh">GitHub</a>
        </div>
      </div>
    </header>

    <main>
      <slot />

      <!-- ビジュアル・ペイウォール境界線（ここから先は有料会員限定） -->
      <div class="paywall-divider">
        <span class="paywall-badge">🔒 ここから先は Auto Tech Radar PRO 会員限定エリア</span>
      </div>

      <!-- 最適化マネタイズ導線（買い切り＋定期購読の二段構え） -->
      <section class="monetization-box">
        <h3>🔓 Auto Tech Radar PRO（商用活用 ＆ 実践レポート）</h3>
        <p>最先端OSSのアーキテクチャ詳細解説、受託開発（単価50〜100万円）への提案法、SaaS化マネタイズ実践ガイドの完全版を即時アンロック。</p>
        
        <div class="pricing-grid">
          <div class="price-card">
            <div>
              <h4>単発レポート（即時閲覧）</h4>
              <div class="price-val">¥980 <span>/ 買い切り</span></div>
              <ul class="feature-list">
                <li>✓ 本記事のアーキテクチャ完全解説</li>
                <li>✓ 商用利用・ライセンスリスク評価</li>
                <li>✓ 受託・自社開発マネタイズ手順書</li>
              </ul>
            </div>
            <a href="https://buy.stripe.com/aFaeVd8GV1CYgQG0NY00000" target="_blank" class="cta-btn cta-primary">💳 Stripeで単発購入（¥980）</a>
          </div>

          <div class="price-card featured">
            <span class="badge-rec">おすすめ・全記事読み放題</span>
            <div>
              <h4>note メンバーシップ（定期購読）</h4>
              <div class="price-val">¥1,980 <span>/ 月額（初月無料/更新自由）</span></div>
              <ul class="feature-list">
                <li>✓ 毎朝配信される全有料記事が読み放題</li>
                <li>✓ 過去アーカイブ全技術レポート閲覧</li>
                <li>✓ noteアプリで通勤・スキマ時間に通知読込</li>
              </ul>
            </div>
            <a href="https://note.com/vast_ixora7005" target="_blank" class="cta-btn cta-note">📗 noteでメンバーシップ購読</a>
          </div>

          <div class="price-card">
            <div>
              <h4>B2B 協賛・開発コンサルティング</h4>
              <div class="price-val">¥100,000〜 <span>/ 案件・スポンサー</span></div>
              <ul class="feature-list">
                <li>✓ 当メディア・XでのOSS活用プロダクト掲載</li>
                <li>✓ レポート対象OSSの受託開発・導入支援</li>
                <li>✓ 自社SaaS開発の技術顧問・アーキテクチャ設計</li>
              </ul>
            </div>
            <div style="display: flex; gap: 0.4rem; flex-direction: column;">
              <a href="https://x.com/AutoTechRadar" target="_blank" class="cta-btn" style="background: #000; color: #fff !important; border: 1px solid #374151;">💬 公式𝕏のDMで相談</a>
              <a href="https://github.com/ssk0224/auto-tech-radar/issues" target="_blank" class="cta-btn" style="background: #1f2937; color: #94a3b8 !important; border: 1px solid #374151; font-size: 0.8rem; padding: 0.4rem;">GitHub Issuesで問い合わせ</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- Floating Sticky Action Bar (読者が50%スクロールした際にフワッと出現する高成約バー) -->
    <div id="sticky-bar" style="position: fixed; bottom: -80px; left: 0; right: 0; background: rgba(15, 23, 42, 0.95); backdrop-filter: blur(12px); border-top: 1px solid #312e81; padding: 0.75rem 1.2rem; display: flex; justify-content: center; align-items: center; gap: 1rem; z-index: 9998; transition: bottom 0.3s ease; box-shadow: 0 -4px 20px rgba(0,0,0,0.5);">
      <div style="font-size: 0.88rem; color: #cbd5e1; font-weight: 600;" class="sticky-text">
        ⚡ <span style="color: #60a5fa;">毎朝の最新OSS解体新書</span> を全編読み放題（月額1,980円）
      </div>
      <div style="display: flex; gap: 0.5rem; align-items: center;">
        <a href="https://note.com/vast_ixora7005" target="_blank" style="background: #2cb696; color: #fff !important; font-size: 0.82rem; font-weight: 700; padding: 0.45rem 0.9rem; border-radius: 6px; text-decoration: none;">noteで定期購読</a>
        <a href="https://buy.stripe.com/aFaeVd8GV1CYgQG0NY00000" target="_blank" style="background: #635bff; color: #fff !important; font-size: 0.82rem; font-weight: 700; padding: 0.45rem 0.9rem; border-radius: 6px; text-decoration: none;">Stripe単発(¥980)</a>
      </div>
    </div>

    <footer>
      <p style="margin-bottom: 0.8rem;">
        <a href="https://x.com/AutoTechRadar" target="_blank" style="margin: 0 0.6rem;">公式 𝕏 (@AutoTechRadar)</a> |
        <a href="https://note.com/vast_ixora7005" target="_blank" style="margin: 0 0.6rem;">公式 note (vast_ixora7005)</a> |
        <a href="https://github.com/ssk0224/auto-tech-radar" target="_blank" style="margin: 0 0.6rem;">GitHub リポジトリ</a>
      </p>
      <p>© 2026 Auto Tech Radar. Powered by Gemini 3.8 & GitHub Actions.</p>
    </footer>

    <!-- UX & Reading Performance Script -->
    <script is:inline>
      // Reading progress bar & Sticky action bar trigger
      window.addEventListener('scroll', () => {
        const winScroll = document.documentElement.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = (winScroll / height) * 100;
        const bar = document.getElementById('reading-progress');
        if (bar) bar.style.width = scrolled + '%';

        // 35%以上スクロールでフワッと出現、最下部付近でも維持
        const stickyBar = document.getElementById('sticky-bar');
        if (stickyBar) {
          if (scrolled > 30) {
            stickyBar.style.bottom = '0px';
          } else {
            stickyBar.style.bottom = '-80px';
          }
        }
      });

      // Code blocks 1-click copy button
      document.querySelectorAll('pre').forEach((pre) => {
        const wrapper = document.createElement('div');
        wrapper.style.position = 'relative';
        pre.parentNode.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);

        const btn = document.createElement('button');
        btn.textContent = 'コピー';
        btn.style.position = 'absolute';
        btn.style.top = '8px';
        btn.style.right = '8px';
        btn.style.background = '#1f2937';
        btn.style.color = '#94a3b8';
        btn.style.border = '1px solid #374151';
        btn.style.borderRadius = '4px';
        btn.style.padding = '2px 8px';
        btn.style.fontSize = '12px';
        btn.style.cursor = 'pointer';

        btn.addEventListener('click', () => {
          navigator.clipboard.writeText(pre.innerText).then(() => {
            btn.textContent = '完了！';
            btn.style.color = '#10b981';
            setTimeout(() => {
              btn.textContent = 'コピー';
              btn.style.color = '#94a3b8';
            }, 2000);
          });
        });
        wrapper.appendChild(btn);
      });

      // Automatic Table of Contents (目次) & Reading Time calculation
      const article = document.querySelector('article');
      if (article) {
        const headings = article.querySelectorAll('h2, h3');
        if (headings.length >= 2) {
          const tocBox = document.createElement('div');
          tocBox.id = 'toc-box';
          tocBox.innerHTML = '<h4>📑 目次 (クイックナビゲーション)</h4><ul></ul>';
          const list = tocBox.querySelector('ul');

          headings.forEach((h, idx) => {
            const id = 'heading-' + idx;
            h.id = id;
            const li = document.createElement('li');
            li.style.marginLeft = h.tagName === 'H3' ? '1rem' : '0';
            li.innerHTML = `<a href="#${id}">${h.textContent}</a>`;
            list.appendChild(li);
          });

          // 読了時間バッジ
          const textLength = article.innerText.length;
          const readMinutes = Math.max(1, Math.ceil(textLength / 600)); // 日本語約600字/分
          const metaBar = document.createElement('div');
          metaBar.className = 'reading-meta-bar';
          metaBar.innerHTML = `
            <span class="reading-badge">⏱️ 読了目安: 約 ${readMinutes} 分</span>
            <span>文字数: 約 ${textLength.toLocaleString()} 文字</span>
            <span>商用・マネタイズ分析付き</span>
          `;

          const firstH1 = article.querySelector('h1');
          if (firstH1) {
            firstH1.insertAdjacentElement('afterend', metaBar);
            metaBar.insertAdjacentElement('afterend', tocBox);
          } else {
            article.insertBefore(metaBar, article.firstChild);
            metaBar.insertAdjacentElement('afterend', tocBox);
          }
        }
      }
    </script>
  </body>
</html>
