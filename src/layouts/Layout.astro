---
import { siteConfig } from "../config/site.js";
import { isNoise } from "../../scripts/utils/noise_filter.mjs";
import { getArticles, hrefOf, starTier, STAR_TIER_NOTE } from "../utils/articles.js";
// note 有料版の案内・構造化データの更新日（updatedDate が無ければ公開日。固定の日付は入れない）を決める関数
import { noteOfferFor, splitAfterIntro, dateModifiedOf, datePublishedOf, tagsOf, jsonLdText, ellipsis } from "../utils/article_page.js";
import { dateLabel } from "../utils/dates.js";
import { ogpPathFor } from "../utils/ogp.js";
import noteUrls from "../../scripts/note_urls.json";
import TrackRecord from "../components/TrackRecord.astro"; // 掲載時→現在のスター数（Radar Ledger）
import Cadence from "../components/Cadence.astro"; // 掲載本数（掲載データから数える）
import { SITE_DESCRIPTION } from "../utils/site_copy.js";
import { googleVerificationContent, cloudflareBeaconConfig } from "../utils/site_tags.js";
const googleVerification = googleVerificationContent(siteConfig.googleSiteVerification);
const cloudflareBeacon = cloudflareBeaconConfig(siteConfig.cloudflareAnalyticsToken);
const { title, description, frontmatter } = Astro.props;
const pageTitle = title || frontmatter?.title || "Auto Tech Radar | 海外急上昇OSS徹底解剖メディア";
const pageDesc = description || frontmatter?.description || SITE_DESCRIPTION;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

// 関連記事（Read Next）の推薦ロジック
// 質問応答の構造化データは出さない: 全OSSに同じ回答（商用利用可否・成熟度）を返す形では根拠データが無いため
const isArticle = !!frontmatter;
let relatedPosts: any[] = [];
if (isArticle) {
  const allPosts = getArticles() as any[];
  const currentTags = tagsOf(frontmatter).map((t: string) => t.toLowerCase());
  const currentTitle = (frontmatter.title || "").toLowerCase();

  // 自記事を除外し、タグ一致スコアまたは最新順でスコアリング
  relatedPosts = allPosts
    .filter(p => p.frontmatter && (p.frontmatter.title || "") !== frontmatter.title)
    .map(p => {
      const pTags = tagsOf(p.frontmatter).map((t: string) => t.toLowerCase());
      let score = 0;
      currentTags.forEach(ct => {
        if (pTags.includes(ct)) score += 2;
      });
      return { post: p, score };
    })
    .sort((a, b) => b.score - a.score)
    .slice(0, 3)
    .map(item => item.post);
}

// 動的OGP画像（Twitter/SNSクローラーの100%描画のためPNGを完全指定）。記事の PNG がまだ無ければサイト共通のカード
const currentSlug = Astro.url.pathname.split('/').filter(Boolean).pop() || '';
const ogImage = `https://ssk0224.github.io/auto-tech-radar${isArticle && currentSlug !== 'auto-tech-radar' ? ogpPathFor(currentSlug) : "/og-card.png"}`;

const starsCount = Number(frontmatter?.stars) || 0;
// 有料版に実際に含まれる項目（暗号化時に有料部分の見出しから作る。本文は含まない）
const paidSummaries = import.meta.glob("../../note_drafts/*_note.paid.json", { eager: true, import: "default" }) as Record<string, { chars: number; features: string[] }>;
const paidSummary = paidSummaries[`../../note_drafts/${currentSlug}_note.paid.json`];
// この記事の有料版（note）の案内。note に公開済みで対応が取れた記事（scripts/note_urls.json）だけに出す（scripts/sync_note_urls.mjs）
const noteOffer = isArticle ? noteOfferFor(currentSlug, noteUrls, paidSummary) : null;
// 案内は記事末尾ではなく導入部の直後に置くため、本文を HTML として受け取り最初の h2 の手前で分ける
const articleHtml = isArticle ? await Astro.slots.render("default") : "";
const [introHtml, restHtml] = noteOffer ? splitAfterIntro(articleHtml) : [articleHtml, ""];
// GitHub スター数による区分（共通定義: src/utils/articles.js）
const tier = starTier(starsCount);
const ringLabel = tier.label;
const ringBadgeColor = tier.color;
const ringBadgeBg = tier.bg;
const ringBadgeBorder = tier.border;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content={isArticle ? "article" : "website"} />
    <meta property="og:site_name" content="Auto Tech Radar" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={`https://ssk0224.github.io${Astro.url.pathname}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@AutoTechRadar" />
    <meta name="twitter:creator" content="@AutoTechRadar" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={`https://ssk0224.github.io${Astro.url.pathname}`} />
    <link rel="alternate" type="application/rss+xml" title="Auto Tech Radar RSS Feed" href="https://ssk0224.github.io/auto-tech-radar/rss.xml" />
    <link rel="manifest" href={`${baseUrl}/manifest.json`} />
    <meta name="theme-color" content="#030712" />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {cloudflareBeacon && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={cloudflareBeacon}></script>}
    {isArticle && isNoise(currentSlug) && <meta name="robots" content="noindex" />}
    {isArticle ? (
      <script type="application/ld+json" set:html={jsonLdText({
        "@context": "https://schema.org",
        "@type": "TechArticle",
        "headline": pageTitle,
        "description": pageDesc,
        "image": ogImage,
        "url": `https://ssk0224.github.io${Astro.url.pathname}`,
        "datePublished": datePublishedOf(frontmatter),
        "dateModified": dateModifiedOf(frontmatter),
        "isAccessibleForFree": true,
        "author": {
          "@type": "Organization",
          "name": "Auto Tech Radar",
          "url": "https://ssk0224.github.io/auto-tech-radar/"
        },
        "publisher": {
          "@type": "Organization",
          "name": "Auto Tech Radar",
          "logo": {
            "@type": "ImageObject",
            "url": "https://ssk0224.github.io/auto-tech-radar/og-card.png"
          }
        },
        "keywords": (tagsOf(frontmatter).length ? tagsOf(frontmatter) : ["OSS", "Tech"]).join(", ")
      })} />
    ) : (
      <script type="application/ld+json" set:html={jsonLdText({
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Auto Tech Radar",
        "url": "https://ssk0224.github.io/auto-tech-radar/",
        "sameAs": [
          "https://x.com/AutoTechRadar",
          "https://note.com/vast_ixora7005",
          "https://github.com/ssk0224/auto-tech-radar"
        ],
        "description": SITE_DESCRIPTION
      })} />
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=JetBrains+Mono:wght@400;600&family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet">
    <!-- is:global が必要: ここのスタイルは Markdown の本文（set:html で入れるため Astro のスコープ属性が付かない）、
         スクリプトが作る目次・メタバー、各ページの .post-card などに当てるもの。スコープ付きだと本文の表が画面幅を超えて横スクロールになる -->
    <style is:global>
      :root {
        --color-primary: #3b82f6;
        --color-primary-hover: #2563eb;
        --color-accent: #10b981;
        --color-purple: #8b5cf6;
        --color-bg: #0b0f19;
        --color-card: #111827;
        --color-card-border: #1f2937;
        --color-text: #f3f4f6;
        --color-text-muted: #9ca3af;
        --color-border: #1f2937;
      }
      * { box-sizing: border-box; }
      body {
        font-family: 'Inter', 'Noto Sans JP', -apple-system, BlinkMacSystemFont, sans-serif;
        line-height: 1.75;
        max-width: 920px;
        margin: 0 auto;
        padding: 1.5rem 1.2rem;
        color: var(--color-text);
        background: var(--color-bg);
      }
      a { color: var(--color-primary); text-decoration: none; transition: color 0.15s; }
      a:hover { color: #60a5fa; text-decoration: underline; }

      /* Global Header */
      header {
        border-bottom: 1px solid var(--color-border);
        margin-bottom: 2rem;
        padding-bottom: 1.2rem;
      }
      .brand-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        background: rgba(59, 130, 246, 0.15);
        color: #60a5fa;
        padding: 0.2rem 0.6rem;
        border-radius: 9999px;
        border: 1px solid rgba(59, 130, 246, 0.3);
        margin-bottom: 0.4rem;
      }
      header .site-title {
        margin: 0;
        font-size: 1.85rem;
        font-weight: 900;
        letter-spacing: -0.02em;
        background: linear-gradient(135deg, #ffffff 40%, #93c5fd 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      header p { margin: 0.3rem 0 0; color: var(--color-text-muted); font-size: 0.92rem; }
      .nav-links { display: flex; gap: 0.5rem; align-items: center; margin-top: 0.5rem; flex-wrap: wrap; }
      .pill-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.4rem 0.85rem;
        border-radius: 8px;
        font-size: 0.82rem;
        font-weight: 600;
        text-decoration: none !important;
        transition: transform 0.1s, opacity 0.15s;
      }
      .pill-btn:hover { transform: translateY(-1px); opacity: 0.9; }
      .btn-x { background: #000; color: #fff !important; border: 1px solid #374151; }
      .btn-note { background: #2cb696; color: #fff !important; }
      .btn-gh { background: #1f2937; color: #e5e7eb !important; border: 1px solid #374151; }

      /* Post Card & Feed (ByteByteGo / TLDR / Substack High-CTR Design) */
      .post-card {
        background: var(--color-card);
        padding: 1.3rem;
        border-radius: 14px;
        border: 1px solid var(--color-card-border);
        margin-bottom: 1.4rem;
        transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s, box-shadow 0.2s;
      }
      .post-card:hover {
        transform: translateY(-2px);
        border-color: rgba(59, 130, 246, 0.5);
        box-shadow: 0 10px 30px -10px rgba(37, 99, 235, 0.2);
      }
      .post-card-inner {
        display: flex;
        gap: 1.4rem;
        align-items: stretch;
      }
      .post-card-thumb {
        flex-shrink: 0;
        width: 250px;
        position: relative;
        border-radius: 10px;
        overflow: hidden;
        background: #0b0f19;
        border: 1px solid rgba(255, 255, 255, 0.08);
      }
      .post-thumb-img {
        width: 100%;
        height: 100%;
        min-height: 135px;
        object-fit: cover;
        display: block;
        transition: transform 0.3s ease;
      }
      .post-card:hover .post-thumb-img {
        transform: scale(1.04);
      }
      .post-card-content {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      @media (max-width: 720px) {
        .post-card-inner {
          flex-direction: column;
          gap: 1rem;
        }
        .post-card-thumb {
          width: 100%;
          max-height: 200px;
        }
      }
      .post-card h3 { margin-top: 0; font-size: 1.25rem; font-weight: 700; margin-bottom: 0.4rem; line-height: 1.4; }
      .post-card h3 a { color: #f9fafb; text-decoration: none; }
      .post-card h3 a:hover { color: #60a5fa; text-decoration: underline; }
      .post-card p { margin: 0 0 0.6rem; color: #9ca3af; font-size: 0.92rem; line-height: 1.6; }
      .meta-tag {
        font-size: 0.78rem;
        background: #1f2937;
        color: #cbd5e1;
        padding: 0.2rem 0.5rem;
        border-radius: 6px;
        font-family: 'JetBrains Mono', monospace;
      }

      /* Article Markdown Content */
      article {
        background: var(--color-card);
        border: 1px solid var(--color-card-border);
        border-radius: 14px;
        padding: 2.2rem;
        margin-bottom: 2.5rem;
        /* 長い URL・パス・インラインコードで画面幅を超えないように（スマホで横スクロールさせない） */
        overflow-wrap: anywhere;
      }
      @media (max-width: 640px) {
        article { padding: 1.2rem 1rem; }
      }
      article h1 { font-size: 1.85rem; font-weight: 800; border-bottom: 1px solid var(--color-border); padding-bottom: 0.8rem; margin-top: 0; color: #fff; }
      article h2 { font-size: 1.4rem; font-weight: 700; border-left: 4px solid var(--color-primary); padding-left: 0.8rem; margin-top: 2rem; color: #e2e8f0; }
      article h3 { font-size: 1.18rem; font-weight: 700; margin-top: 1.5rem; color: #cbd5e1; }
      article p { color: #d1d5db; font-size: 1rem; line-height: 1.8; }
      article pre {
        background: #030712;
        color: #e5e7eb;
        padding: 1.2rem;
        border-radius: 8px;
        overflow-x: auto;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.88rem;
        border: 1px solid #1f2937;
      }
      article code {
        background: #1f2937;
        color: #93c5fd;
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.88em;
      }
      article pre code { background: transparent; padding: 0; color: inherit; }
      article blockquote {
        border-left: 4px solid #3b82f6;
        background: rgba(59, 130, 246, 0.05);
        margin: 1.5rem 0;
        padding: 0.8rem 1.2rem;
        color: #93c5fd;
        border-radius: 0 8px 8px 0;
      }
      article table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5rem 0;
        font-size: 0.92rem;
        display: block;
        overflow-x: auto;
        max-width: 100%;
        -webkit-overflow-scrolling: touch;
      }
      article th, article td {
        border: 1px solid var(--color-card-border);
        padding: 0.7rem 0.9rem;
        text-align: left;
      }
      article th { background: #1e293b; color: #f1f5f9; white-space: nowrap; }
      article td { background: #0f172a; }

      /* note 有料版の案内（記事の導入部の直後に 1 か所だけ）。
         本文の `article p` などより優先させるため、子要素は .note-offer から指定する */
      .note-offer {
        background: linear-gradient(135deg, rgba(30, 27, 75, 0.85) 0%, rgba(15, 23, 42, 0.95) 100%);
        border: 1px solid #4338ca;
        border-radius: 12px;
        padding: 1.3rem 1.5rem;
        margin: 2rem 0;
      }
      .note-offer .note-offer-title { margin: 0 0 0.7rem; font-size: 1.08rem; font-weight: 800; color: #e0e7ff; line-height: 1.5; }
      .note-offer .note-offer-list { margin: 0 0 0.6rem; padding-left: 1.3rem; font-size: 0.92rem; color: #cbd5e1; line-height: 1.7; }
      .note-offer .note-offer-meta { margin: 0 0 1rem; font-size: 0.85rem; color: #a5b4fc; line-height: 1.6; }
      .note-offer .note-offer-btn {
        display: inline-block;
        background: #2cb696;
        color: #fff !important;
        font-weight: 700;
        font-size: 0.95rem;
        padding: 0.7rem 1.3rem;
        border-radius: 8px;
        text-decoration: none !important;
        transition: filter 0.15s;
      }
      .note-offer .note-offer-btn:hover { filter: brightness(1.08); }
      .note-offer .note-offer-sub { margin: 0.9rem 0 0; font-size: 0.82rem; color: #94a3b8; line-height: 1.6; }
      .note-offer .note-offer-sub a { color: #93c5fd; text-decoration: underline; }
      @media (max-width: 640px) {
        .note-offer { padding: 1.1rem 1rem; }
        .note-offer .note-offer-btn { display: block; text-align: center; min-height: 44px; }
      }

      footer {
        margin-top: 4rem;
        font-size: 0.88rem;
        color: var(--color-text-muted);
        border-top: 1px solid var(--color-border);
        padding-top: 1.8rem;
        text-align: center;
      }
      /* Reading progress bar */
      #reading-progress {
        position: fixed;
        top: 0;
        left: 0;
        height: 3px;
        background: linear-gradient(90deg, #3b82f6, #10b981);
        width: 0%;
        z-index: 9999;
        transition: width 0.1s ease;
      }
      /* Reading time badge & Table of Contents */
      .reading-meta-bar {
        display: flex;
        gap: 0.8rem;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 0.8rem;
        border-bottom: 1px solid var(--color-border);
        font-size: 0.82rem;
        color: var(--color-text-muted);
        flex-wrap: wrap;
      }
      .reading-badge {
        background: rgba(59, 130, 246, 0.15);
        color: #93c5fd;
        padding: 0.2rem 0.5rem;
        border-radius: 6px;
        font-weight: 600;
      }
      #toc-box {
        background: rgba(17, 24, 39, 0.7);
        border: 1px solid #1f2937;
        border-radius: 10px;
        padding: 1.2rem 1.4rem;
        margin: 1.5rem 0 2rem;
      }
      #toc-box h4 {
        margin: 0 0 0.8rem;
        font-size: 0.95rem;
        color: #e2e8f0;
        display: flex;
        align-items: center;
        gap: 0.4rem;
      }
      #toc-box ul {
        margin: 0;
        padding-left: 1.2rem;
        font-size: 0.88rem;
        color: #94a3b8;
      }
      #toc-box li { margin-bottom: 0.35rem; }
      #toc-box a { color: #93c5fd; text-decoration: none; }
      #toc-box a:hover { text-decoration: underline; color: #60a5fa; }

      /* A4資料・PDF保存用の完全印刷スタイル（ByteByteGoホワイトペーパースタイル） */
      @media print {
        body { background: #fff !important; color: #000 !important; font-size: 11pt; }
        header, .nav-links, footer, .reading-meta-bar button, .reading-meta-bar a,
        #reading-progress, .note-offer,
        .btn-gh, .btn-x, .btn-note, #copy-cheatsheet-url, #copy-cheatsheet-md,
        #export-cheatsheet-csv, #filter-search, #print-pdf-btn {
          display: none !important;
        }
        main { max-width: 100% !important; margin: 0 !important; padding: 0 !important; }
        article { background: #fff !important; border: none !important; padding: 0 !important; color: #111 !important; }
        article h1, article h2, article h3 { color: #000 !important; page-break-after: avoid; }
        article p, article li, article td { color: #222 !important; }
        article pre { background: #f8fafc !important; color: #0f172a !important; border: 1px solid #cbd5e1 !important; page-break-inside: avoid; }
        table { border-collapse: collapse !important; width: 100% !important; page-break-inside: avoid; }
        th, td { border: 1px solid #94a3b8 !important; padding: 6px 10px !important; color: #000 !important; }
        th { background: #e2e8f0 !important; }
        a { color: #000 !important; text-decoration: underline !important; }
      }
    </style>
  </head>
  <body>
    <div id="reading-progress"></div>
    <header>
      <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
        <div>
          <div class="brand-badge">⚡ Global OSS Intelligence</div>
          <div class="site-title"><a href={`${baseUrl}/`}>📡 Auto Tech Radar</a></div>
          <p>GitHub でスター数が伸びている OSS の日本語解説（README などの公開情報をもとに AI が下書き）</p>
        </div>
        <div class="nav-links">
          <a href={`${baseUrl}/weekly/`} class="pill-btn" style="background: rgba(99, 102, 241, 0.2); color: #c7d2fe !important; border: 1px solid rgba(99, 102, 241, 0.5);">📑 週間白書</a>
          <a href={`${baseUrl}/radar-map/`} class="pill-btn" style="background: rgba(139, 92, 246, 0.2); color: #c4b5fd !important; border: 1px solid rgba(139, 92, 246, 0.5);">🎯 4象限レーダーマップ</a>
          <a href={`${baseUrl}/cheatsheet/`} class="pill-btn" style="background: rgba(16, 185, 129, 0.15); color: #34d399 !important; border: 1px solid rgba(16, 185, 129, 0.4);">📊 OSS比較チートシート</a>
          <a href={`${baseUrl}/estimate/`} class="pill-btn" style="background: rgba(16, 185, 129, 0.25); color: #6ee7b7 !important; border: 1px solid rgba(16, 185, 129, 0.5);">⚡ 開発見積もり試算</a>
          <a href={`${baseUrl}/expense/`} class="pill-btn" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24 !important; border: 1px solid rgba(245, 158, 11, 0.4);">💼 経費精算ガイド</a>
          {/* 受託相談・協賛のページはフッターからのみ案内する（記事ページに B2B の案内を出さない） */}
          <a href={`${baseUrl}/api/radar.json`} target="_blank" rel="noopener noreferrer" class="pill-btn" style="background: rgba(168, 85, 247, 0.2); color: #c084fc !important; border: 1px solid rgba(168, 85, 247, 0.5);">🤖 AI Agent API</a>
          <a href="https://x.com/AutoTechRadar" target="_blank" rel="noopener noreferrer" class="pill-btn btn-x">𝕏 @AutoTechRadar</a>
          <a href="https://note.com/vast_ixora7005" target="_blank" rel="noopener noreferrer" class="pill-btn btn-note">note 公式ページ</a>
          <a href={`${baseUrl}/rss.xml`} target="_blank" rel="noopener noreferrer" class="pill-btn" style="background: #f97316; color: #fff !important;">📡 RSS購読</a>
          <a href="https://github.com/ssk0224/auto-tech-radar" target="_blank" rel="noopener noreferrer" class="pill-btn btn-gh">GitHub</a>
        </div>
      </div>
    </header>

    <main data-repo-url={frontmatter?.repoUrl || ""} data-stars={starsCount} data-ring={ringLabel} data-ring-color={ringBadgeColor} data-ring-bg={ringBadgeBg} data-ring-border={ringBadgeBorder} data-ring-note={STAR_TIER_NOTE}>
      {isArticle && (
        <div class="article-hero-banner" style="margin-bottom: 2rem; border-radius: 12px; overflow: hidden; border: 1px solid rgba(59, 130, 246, 0.3); box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.6); background: #0b0f19;">
          <img 
            src={ogImage} 
            alt={pageTitle} 
            style="width: 100%; height: auto; display: block; aspect-ratio: 1200 / 630; object-fit: cover;" 
            loading="eager"
            onerror="this.style.display='none'"
          />
        </div>
      )}
      {isArticle ? (
        <article id="article-body">
          <Fragment set:html={introHtml} />
          {/* note 有料版の案内（導入部の直後に 1 か所だけ）。atr-paywall-gate は購入導線の目印（scripts/audit_quality.mjs が確認する） */}
          {noteOffer && (
            <aside class="note-offer atr-paywall-gate" aria-labelledby="note-offer-title">
              <p class="note-offer-title" id="note-offer-title">{noteOffer.heading}</p>
              {noteOffer.features.length > 0 ? (
                <ul class="note-offer-list">
                  {noteOffer.features.map((f) => <li>{f}</li>)}
                </ul>
              ) : (
                <p class="note-offer-meta">含まれる内容は note の記事ページに記載しています。</p>
              )}
              {noteOffer.charsLabel && <p class="note-offer-meta">有料部分の分量: {noteOffer.charsLabel}</p>}
              <a href={noteOffer.url} target="_blank" rel="noopener" class="note-offer-btn" id="note-buy-btn">
                note で有料版を見る{noteOffer.priceLabel ? `（${noteOffer.priceLabel}）` : ""}
              </a>
              <p class="note-offer-sub">
                定期購読の <a href={siteConfig.noteMembershipUrl} target="_blank" rel="noopener noreferrer">note メンバーシップ（{siteConfig.membershipMonthlyPrice}/月）</a> もあります。特典の対象記事はメンバーシップページでご確認ください。
              </p>
            </aside>
          )}
          <Fragment set:html={restHtml} />
        </article>
      ) : <slot />}
      {isArticle && <TrackRecord frontmatter={frontmatter} />}

      <!-- AI 生成であることの表示（読者が一次情報を確認できるように） -->
      {isArticle && (
        <p class="ai-disclosure" style="margin: 1.5rem 0 0; padding: 0.8rem 1rem; border: 1px solid #1f2937; border-radius: 8px; font-size: 0.82rem; color: #94a3b8; line-height: 1.6;">
          この記事は、GitHub の公開情報（README・リポジトリ情報）をもとに AI（Google Gemini）が下書きし、自動検査を通して公開しています。導入前に、公式リポジトリで最新の内容・ライセンスをご確認ください。
        </p>
      )}
      {/* 訂正の記録（記事の frontmatter の corrections）。一覧は /about/ の訂正履歴 */}
      {isArticle && Array.isArray(frontmatter?.corrections) && frontmatter.corrections.length > 0 && (
        <div class="article-corrections" style="margin: 0.8rem 0 0; padding: 0.8rem 1rem; border: 1px solid #78350f; border-radius: 8px; font-size: 0.82rem; color: #fcd34d; line-height: 1.6;">
          <strong>訂正</strong>
          <ul style="margin: 0.3rem 0 0; padding-left: 1.2rem;">
            {frontmatter.corrections.map((c: any) => <li>{dateLabel(c?.date) || String(c?.date ?? "")}: {c?.note}</li>)}
          </ul>
          <a href={`${baseUrl}/about/#corrections`} style="color: #fcd34d; text-decoration: underline;">訂正履歴の一覧</a>
        </div>
      )}

      {/* 有料版の案内は本文の導入部の直後（上の .note-offer）の 1 か所だけ。
          記事末尾の購入カード・追従バーや、B2B（協賛・導入支援）の案内は置かない（/sponsor/・/contact/ はフッターから案内する） */}

      <!-- Substack/TLDRモデル: 読者リテンション・エンゲージメントボックス -->
      {isArticle && (
        <section style="background: linear-gradient(135deg, rgba(30, 41, 59, 0.7) 0%, rgba(15, 23, 42, 0.9) 100%); border: 1px solid #334155; border-radius: 12px; padding: 1.8rem; margin: 3rem 0; text-align: center;">
          <div style="display: inline-block; background: rgba(59, 130, 246, 0.2); color: #93c5fd; padding: 0.2rem 0.7rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 700; margin-bottom: 0.6rem;">
            🔔 <Cadence />
          </div>
          <h3 style="font-size: 1.25rem; font-weight: 800; color: #fff; margin: 0 0 0.5rem;">
            新しい記事を受け取る
          </h3>
          <p style="font-size: 0.9rem; color: #94a3b8; max-width: 580px; margin: 0 auto 1.3rem; line-height: 1.6;">
            新しい記事は RSS フィードで受け取れます。掲載中の記事の一覧はチートシートにまとめています。
          </p>
          <div style="display: flex; gap: 0.6rem; justify-content: center; flex-wrap: wrap;">
            <a href={`${baseUrl}/rss.xml`} target="_blank" rel="noopener noreferrer" style="background: #ea580c; color: #fff; padding: 0.55rem 1.1rem; border-radius: 8px; font-size: 0.85rem; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem;">
              📡 RSSリーダーに追加
            </a>
            <a href={`${baseUrl}/cheatsheet/`} style="background: #1e293b; border: 1px solid #475569; color: #38bdf8; padding: 0.55rem 1.1rem; border-radius: 8px; font-size: 0.85rem; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem;">
              📊 全OSS比較チートシート
            </a>
          </div>
        </section>
      )}

      <!-- 📢 ソーシャルシェア ＆ はてブ拡散バー -->
      {isArticle && (
        <div style="margin: 2rem 0; padding: 1.1rem 1.4rem; background: #0f172a; border: 1px solid #1e293b; border-radius: 12px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
          <div style="font-size: 0.9rem; font-weight: 700; color: #cbd5e1; display: flex; align-items: center; gap: 0.5rem;">
            <span>📢</span>
            <span>この記事をシェア・ブックマークする</span>
          </div>
          <div style="display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap;">
            <a 
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(`${pageTitle} | Auto Tech Radar`)}&url=${encodeURIComponent(`https://ssk0224.github.io${Astro.url.pathname}`)}&via=AutoTechRadar`} 
              target="_blank" 
              rel="noopener noreferrer"
              style="background: #000; border: 1px solid #334155; color: #fff; padding: 0.45rem 0.9rem; border-radius: 6px; font-size: 0.82rem; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem;"
            >
              𝕏 でポスト
            </a>
            <a 
              href={`https://b.hatena.ne.jp/entry/s/ssk0224.github.io${Astro.url.pathname}`} 
              target="_blank" 
              rel="noopener noreferrer"
              style="background: #00a4de; color: #fff; padding: 0.45rem 0.9rem; border-radius: 6px; font-size: 0.82rem; font-weight: 800; text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem;"
            >
              B! はてブ
            </a>
            <button 
              id="copy-article-url-btn" 
              style="background: #1e293b; border: 1px solid #334155; color: #94a3b8; padding: 0.45rem 0.9rem; border-radius: 6px; font-size: 0.82rem; font-weight: 700; cursor: pointer;"
              onclick="navigator.clipboard.writeText(window.location.href); this.textContent='✓ コピー完了'; setTimeout(() => this.textContent='🔗 リンクコピー', 2000);"
            >
              🔗 リンクコピー
            </button>
          </div>
        </div>
      )}

      {isArticle && relatedPosts.length > 0 && (
        <section style="margin-top: 3.5rem; padding-top: 2rem; border-top: 1px solid var(--color-border);">
          <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1.2rem;">
            <h3 style="margin: 0; font-size: 1.25rem; font-weight: 800; color: #f3f4f6; display: flex; align-items: center; gap: 0.5rem;">
              <span>🧭 あわせて読みたい関連レポート</span>
              <span style="font-size: 0.75rem; background: rgba(59, 130, 246, 0.2); color: #93c5fd; padding: 0.15rem 0.5rem; border-radius: 9999px;">タグの一致・新しい順</span>
            </h3>
            <a href={`${baseUrl}/`} style="font-size: 0.85rem; color: #60a5fa; text-decoration: none;">全記事一覧を見る →</a>
          </div>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem;">
            {relatedPosts.map(rp => (
              <div style="background: var(--color-card); border: 1px solid var(--color-card-border); border-radius: 10px; padding: 1.2rem; display: flex; flex-direction: column; justify-content: space-between; transition: transform 0.15s, border-color 0.15s;" onmouseover="this.style.borderColor='#3b82f6'; this.style.transform='translateY(-2px)';" onmouseout="this.style.borderColor='var(--color-card-border)'; this.style.transform='none';">
                <div>
                  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                    <span style="font-size: 0.72rem; color: #64748b; font-family: 'JetBrains Mono', monospace;">{dateLabel(rp.frontmatter?.pubDate) || ""}</span>
                    {tagsOf(rp.frontmatter).length > 0 && (
                      <span style="font-size: 0.7rem; background: #1f2937; color: #93c5fd; padding: 0.1rem 0.4rem; border-radius: 4px;">{tagsOf(rp.frontmatter)[0]}</span>
                    )}
                  </div>
                  <h4 style="margin: 0 0 0.5rem; font-size: 0.98rem; font-weight: 700; line-height: 1.4;">
                    <a href={hrefOf(rp)} style="color: #f1f5f9; text-decoration: none;">{ellipsis(rp.frontmatter?.title || rp.file, 50)}</a>
                  </h4>
                  <p style="margin: 0; font-size: 0.82rem; color: #94a3b8; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                    {rp.frontmatter?.description}
                  </p>
                </div>
                <a href={hrefOf(rp)} style="margin-top: 0.8rem; font-size: 0.82rem; font-weight: 600; color: #38bdf8; display: inline-flex; align-items: center; gap: 0.2rem;">
                  レポートを読む →
                </a>
              </div>
            ))}
          </div>
        </section>
      )}
    </main>

    <footer>
      <p style="margin-bottom: 0.8rem;">
        <a href={`${baseUrl}/contact/`} style="margin: 0 0.6rem; color: #60a5fa; font-weight: 700;">📩 受託・導入相談窓口</a> |
        <a href={`${baseUrl}/api/radar.json`} target="_blank" rel="noopener noreferrer" style="margin: 0 0.6rem; color: #c084fc; font-weight: 700;">🤖 AI Agent API (JSON)</a> |
        <a href={`${baseUrl}/sponsor/`} style="margin: 0 0.6rem;">📢 広告・協賛</a> |
        <a href={`${baseUrl}/about/`} style="margin: 0 0.6rem;">運営方針・訂正履歴</a> |
        <a href={`${baseUrl}/privacy/`} style="margin: 0 0.6rem;">プライバシーポリシー</a> |
        <a href={`${baseUrl}/criteria/`} style="margin: 0 0.6rem;">選定基準</a> |
        <a href={siteConfig.xAccountUrl} target="_blank" rel="noopener noreferrer" style="margin: 0 0.6rem;">公式 𝕏 ({siteConfig.xHandle})</a> |
        <a href={siteConfig.noteMembershipUrl} target="_blank" rel="noopener noreferrer" style="margin: 0 0.6rem;">公式 note</a> |
        <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer" style="margin: 0 0.6rem;">GitHub リポジトリ</a>
      </p>
      <p>© 2026 Auto Tech Radar. Global Open Source Intelligence & Monetization Architecture. All rights reserved.</p>
    </footer>

    <!-- UX & Reading Performance Script -->
    <script is:inline>
      // Runtime URL & Path Helpers (Zero ReferenceError guarantee)
      const baseUrl = window.location.pathname.startsWith('/auto-tech-radar') ? '/auto-tech-radar' : '';
      const currentSlug = window.location.pathname.replace(/\/index\.html$/, '').split('/').filter(Boolean).pop() || '';

      // innerHTML のテンプレートに入れる文字列は必ずエスケープする
      const esc = (v) => String(v).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

      // Reading progress bar
      window.addEventListener('scroll', () => {
        const winScroll = document.documentElement.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
        const bar = document.getElementById('reading-progress');
        if (bar) bar.style.width = scrolled + '%';
      });

      // Code blocks 1-click copy button
      document.querySelectorAll('pre').forEach((pre) => {
        if (
          pre.querySelector('code.language-mermaid') || 
          pre.classList.contains('mermaid') || 
          pre.classList.contains('mermaid-container') ||
          pre.getAttribute('data-language') === 'mermaid'
        ) return;
        const wrapper = document.createElement('div');
        wrapper.style.position = 'relative';
        pre.parentNode.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);

        const btn = document.createElement('button');
        btn.textContent = 'コピー';
        btn.style.position = 'absolute';
        btn.style.top = '8px';
        btn.style.right = '8px';
        btn.style.background = '#1f2937';
        btn.style.color = '#94a3b8';
        btn.style.border = '1px solid #374151';
        btn.style.borderRadius = '4px';
        btn.style.padding = '2px 8px';
        btn.style.fontSize = '12px';
        btn.style.cursor = 'pointer';
        btn.style.zIndex = '5';

        btn.addEventListener('click', () => {
          const codeEl = pre.querySelector('code');
          const codeText = codeEl ? codeEl.innerText : pre.innerText;
          navigator.clipboard.writeText(codeText.trim()).then(() => {
            btn.textContent = '完了！';
            btn.style.color = '#10b981';
            setTimeout(() => {
              btn.textContent = 'コピー';
              btn.style.color = '#94a3b8';
            }, 2000);
          });
        });
        wrapper.appendChild(btn);
      });

      // Automatic Table of Contents (目次) & Reading Time calculation
      // 記事本文のコンテナ（Layout が isArticle のときだけ #article-body を出力する）
      const article = document.getElementById('article-body');
      if (article) {
        const headings = article.querySelectorAll('h2, h3');
        if (headings.length >= 2) {
          const tocBox = document.createElement('div');
          tocBox.id = 'toc-box';
          const tocTitle = document.createElement('h4');
          tocTitle.textContent = '📑 目次 (クイックナビゲーション)';
          const list = document.createElement('ul');
          tocBox.appendChild(tocTitle);
          tocBox.appendChild(list);

          headings.forEach((h, idx) => {
            const id = h.id || ('heading-' + idx);
            h.id = id;
            const li = document.createElement('li');
            li.style.marginLeft = h.tagName === 'H3' ? '1rem' : '0';
            const link = document.createElement('a');
            link.setAttribute('href', '#' + id);
            link.textContent = h.textContent;
            li.appendChild(link);
            list.appendChild(li);
          });

          // 読了時間バッジ & クイック共有バー（note 有料版の案内 .note-offer は本文の文字数に数えない）
          const offerBox = article.querySelector('.note-offer');
          const textLength = article.innerText.length - (offerBox ? offerBox.innerText.length : 0);
          const readMinutes = Math.max(1, Math.ceil(textLength / 600)); // 日本語約600字/分
          const articleTitle = document.title.split('|')[0].trim();
          const pageUrl = window.location.href;
          const mainEl = document.querySelector('main');
          const ringLabel = esc(mainEl ? (mainEl.getAttribute('data-ring') || '') : '');
          const ringNote = mainEl ? (mainEl.getAttribute('data-ring-note') || '') : '';
          const ringColor = esc(mainEl ? (mainEl.getAttribute('data-ring-color') || '#60a5fa') : '#60a5fa');
          const ringBg = esc(mainEl ? (mainEl.getAttribute('data-ring-bg') || 'rgba(59, 130, 246, 0.18)') : 'rgba(59, 130, 246, 0.18)');
          const ringBorder = esc(mainEl ? (mainEl.getAttribute('data-ring-border') || 'rgba(59, 130, 246, 0.4)') : 'rgba(59, 130, 246, 0.4)');
          // 「商用・マネタイズ分析付き」「活用領域」「ライセンス考察を参照」は、本文にその見出しがある記事だけに出す
          // （2026-10-21 以降の記事にはマネタイズの節が無い。無い節を「付き」と書かない）
          const hasHeading = (word) => Array.from(headings).some((h) => h.tagName === 'H2' && (h.textContent || '').includes(word));
          const hasMonetization = hasHeading('マネタイズ');
          const hasLicenseSection = hasHeading('ライセンス考察');

          // はてなブックマークの https ページ用 URL 形式: /entry/s/<host+path>
          const hatenaUrl = 'https://b.hatena.ne.jp/entry/' + (window.location.protocol === 'https:' ? 's/' : '') + window.location.host + window.location.pathname;

          const metaBar = document.createElement('div');
          metaBar.className = 'reading-meta-bar';
          metaBar.innerHTML = `
            <div style="display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap;">
              <a href="${esc(baseUrl)}/radar-map/" title="${esc(ringNote)}" style="text-decoration: none; display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.76rem; font-weight: 800; color: ${ringColor}; background: ${ringBg}; border: 1px solid ${ringBorder}; padding: 0.18rem 0.55rem; border-radius: 9999px;">
                <span>●</span>
                <span>スター数区分 ${ringLabel}</span>
              </a>
              <span class="reading-badge">⏱️ 読了目安: 約 ${readMinutes} 分</span>
              <span>文字数: 約 ${textLength.toLocaleString()} 文字</span>
              ${hasMonetization ? '<span style="color: #10b981; font-weight: 600;">✓ 商用・マネタイズ分析付き</span>' : ''}
            </div>
            <div style="margin-left: auto; display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap;">
              <button id="print-article-btn" onclick="window.print()" style="background: rgba(168, 85, 247, 0.15); border: 1px solid rgba(168, 85, 247, 0.4); color: #c084fc; padding: 0.2rem 0.55rem; border-radius: 6px; font-size: 0.76rem; cursor: pointer; font-weight: 700;">
                🖨️ A4印刷/PDF
              </button>
              <button id="copy-proposal-btn" style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); color: #34d399; padding: 0.2rem 0.55rem; border-radius: 6px; font-size: 0.76rem; cursor: pointer; font-weight: 700;">
                📋 提案書ドラフトをコピー
              </button>
              <button id="copy-url-btn" style="background: #1f2937; border: 1px solid #374151; color: #94a3b8; padding: 0.2rem 0.55rem; border-radius: 6px; font-size: 0.76rem; cursor: pointer;">
                🔗 URLコピー
              </button>
              <a href="${esc(hatenaUrl)}" target="_blank" rel="noopener" style="background: rgba(0, 164, 222, 0.15); border: 1px solid rgba(0, 164, 222, 0.4); color: #38bdf8; padding: 0.2rem 0.55rem; border-radius: 6px; font-size: 0.76rem; text-decoration: none; display: inline-flex; align-items: center; font-weight: 700;">
                🅱️ はてブ
              </a>
              <a href="https://twitter.com/intent/tweet?text=${encodeURIComponent(articleTitle + '\n' + pageUrl + '\n#OSS #AutoTechRadar')}" target="_blank" rel="noopener" style="background: #000; border: 1px solid #374151; color: #fff; padding: 0.2rem 0.55rem; border-radius: 6px; font-size: 0.76rem; text-decoration: none; display: inline-flex; align-items: center;">
                𝕏 ポスト
              </a>
            </div>
          `;

          const copyBtn = metaBar.querySelector('#copy-url-btn');
          if (copyBtn) {
            copyBtn.addEventListener('click', () => {
              navigator.clipboard.writeText(pageUrl).then(() => {
                copyBtn.textContent = '完了！';
                copyBtn.style.color = '#10b981';
                setTimeout(() => {
                  copyBtn.textContent = '🔗 URLコピー';
                  copyBtn.style.color = '#94a3b8';
                }, 2000);
              });
            });
          }

          // 1クリック提案書・稟議ドラフト生成
          const copyPropBtn = metaBar.querySelector('#copy-proposal-btn');
          if (copyPropBtn) {
            copyPropBtn.addEventListener('click', () => {
              const proposalText = `# 【社内稟議・提案書】${articleTitle} の導入および商用活用について\n\n` +
                `■ 案件名: ${articleTitle} を活用した業務自動化・DX基盤構築\n` +
                `■ 提案目的: 海外で注目されているOSSを活用し、商用SaaSへの依存を減らしながら自社基盤/顧客システムを構築する。\n` +
                `■ 想定予算規模: （要件定義後に工数から算出して記入）\n` +
                `■ 期待される効果（導入前に自社環境で検証して記入）:\n` +
                `  1. 既存商用SaaSのライセンス費用の削減\n` +
                `  2. ベンダーロックインの低減とオンプレミス/プライベートクラウド運用\n` +
                `  3. AI/エージェント技術の内製化による業務工数の削減\n\n` +
                `■ 参考（README などの公開情報をもとにした日本語解説）:\n` +
                `  ${pageUrl}\n`;
              navigator.clipboard.writeText(proposalText).then(() => {
                copyPropBtn.textContent = '✓ 提案書コピー完了！';
                copyPropBtn.style.background = '#065f46';
                setTimeout(() => {
                  copyPropBtn.textContent = '📋 提案書ドラフトをコピー';
                  copyPropBtn.style.background = 'rgba(16, 185, 129, 0.15)';
                }, 2500);
              });
            });
          }

          const firstH1 = article.querySelector('h1');
          
          // ⚡ 30秒エグゼクティブ・サマリー（Executive Summary Box）
          // 要約は本文の最初の段落から作る（導入部に段落が無い記事で note の案内の文面を拾わないように除外する）
          const firstP = Array.from(article.querySelectorAll('p')).find((p) => !p.closest('.note-offer'));
          const firstText = firstP ? firstP.textContent.trim() : '';
          const summaryText = esc(firstText.length > 240 ? firstText.slice(0, 240) + '...' : firstText);
          // 記事のリポジトリURL（frontmatter の repoUrl）。タイトルからは所有者名が分からないため使わない
          const cloneUrlRaw = document.querySelector('main')?.dataset.repoUrl || '';
          const cloneUrl = esc(cloneUrlRaw);
          const summaryBox = document.createElement('div');
          summaryBox.style.cssText = 'background: rgba(30, 41, 59, 0.7); border: 1px solid #3b82f6; border-left: 4px solid #3b82f6; border-radius: 8px; padding: 1.1rem 1.3rem; margin: 1.5rem 0;';
          summaryBox.innerHTML = `
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem; color: #60a5fa; font-weight: 700; font-size: 0.92rem;">
              <span>⚡ 30秒エグゼクティブ・サマリー（結論 ＆ 商用要点）</span>
            </div>
            <p style="margin: 0; font-size: 0.92rem; color: #e2e8f0; line-height: 1.65;">
              ${summaryText}
            </p>
            <div style="display: flex; gap: 1rem; margin-top: 0.8rem; font-size: 0.8rem; color: #94a3b8; flex-wrap: wrap;">
              ${hasMonetization ? '<span>🎯 活用領域: 受託開発 / 自社SaaS基盤</span>' : ''}
              ${hasLicenseSection ? '<span>💡 ライセンス: 本文の「商用利用可否 &amp; ライセンス考察」参照</span>' : ''}
            </div>
            <div style="margin-top: 0.9rem; display: flex; flex-direction: column; gap: 0.5rem;">
              <div style="padding: 0.55rem 0.8rem; background: #030712; border: 1px solid #1e293b; border-radius: 6px; display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; font-family: 'JetBrains Mono', monospace; font-size: 0.78rem; flex-wrap: wrap;">
                <div style="color: #cbd5e1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                  <span style="color: #10b981; font-weight: 700;">⚡ 3秒検証:</span> <span style="color: #93c5fd;">git clone ${cloneUrl}</span>
                </div>
                <div style="display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap;">
                  <button id="quick-run-copy-btn" style="background: #1f2937; border: 1px solid #374151; color: #94a3b8; padding: 0.2rem 0.55rem; border-radius: 4px; cursor: pointer; white-space: nowrap; font-size: 0.74rem;">
                    コピー
                  </button>
                  <a rel="noopener" href="https://twitter.com/intent/tweet?text=${encodeURIComponent('【海外急上昇OSS解体新書】' + (document.title.split(' - ')[0] || '').trim() + ' のアーキテクチャ解説👇\n')}&url=${encodeURIComponent(window.location.href)}&via=AutoTechRadar" target="_blank" style="background: #000; border: 1px solid #38bdf8; color: #38bdf8; padding: 0.2rem 0.6rem; border-radius: 4px; text-decoration: none; font-size: 0.74rem; font-weight: 700; display: inline-flex; align-items: center; gap: 0.25rem;">
                    🐦 𝕏 でシェア
                  </a>
                </div>
              </div>

              <div style="padding: 0.55rem 0.8rem; background: rgba(30, 27, 75, 0.45); border: 1px solid rgba(139, 92, 246, 0.35); border-radius: 6px; display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; font-family: 'JetBrains Mono', monospace; font-size: 0.78rem; flex-wrap: wrap;">
                <div style="color: #c4b5fd; display: flex; align-items: center; gap: 0.4rem;">
                  <span style="color: #a78bfa; font-weight: 700;">⚡ AI コーディング用:</span>
                  <span>Claude / Cursor / Windsurf 向けの .cursorrules（この記事の要約）</span>
                </div>
                <div style="display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap;">
                  <button id="copy-cursor-btn" style="background: rgba(56, 189, 248, 0.2); border: 1px solid #38bdf8; color: #bae6fd; padding: 0.2rem 0.6rem; border-radius: 4px; cursor: pointer; font-size: 0.74rem; font-weight: 700; display: inline-flex; align-items: center; gap: 0.3rem;">
                    🤖 .cursorrules コピー
                  </button>
                </div>
              </div>
            </div>
          `;

          const quickRunBtn = summaryBox.querySelector('#quick-run-copy-btn');
          if (quickRunBtn) {
            quickRunBtn.addEventListener('click', () => {
              const cmd = `git clone ${cloneUrlRaw}`;
              navigator.clipboard.writeText(cmd).then(() => {
                quickRunBtn.textContent = '完了！';
                quickRunBtn.style.color = '#10b981';
                setTimeout(() => {
                  quickRunBtn.textContent = 'コピー';
                  quickRunBtn.style.color = '#94a3b8';
                }, 2000);
              });
            });
          }

          const copyCursorBtn = summaryBox.querySelector('#copy-cursor-btn');
          if (copyCursorBtn) {
            let copyCursorTimer = null;
            copyCursorBtn.addEventListener('click', () => {
              const slug = window.location.pathname.replace(/\/index\.html$/, '').split('/').filter(Boolean).pop() || 'oss';
              const cursorRules = `# Cursor Rules & AI Agent System Prompt: ${articleTitle}\n\n` +
                `## Role & Objective\n` +
                `You are a Senior Solutions Architect specialized in production integration of ${slug}.\n\n` +
                `## Implementation Guidelines\n` +
                `- Strictly adhere to official clean-room architecture and zero-trust standards.\n` +
                `- Implement robust error boundaries, structured logging, and containerized deployment (Docker/Compose).\n` +
                `- Avoid hardcoded credentials; enforce environment variables (.env.example).\n` +
                `- Optimize for low-latency, deterministic execution, and enterprise security compliance.\n`;
              navigator.clipboard.writeText(cursorRules).then(() => {
                if (copyCursorTimer) clearTimeout(copyCursorTimer);
                copyCursorBtn.textContent = '✓ Rulesコピー完了！';
                copyCursorBtn.style.color = '#38bdf8';
                copyCursorBtn.style.borderColor = '#38bdf8';
                copyCursorTimer = setTimeout(() => {
                  copyCursorBtn.textContent = '🤖 .cursorrules コピー';
                  copyCursorBtn.style.color = '#bae6fd';
                  copyCursorBtn.style.borderColor = '#38bdf8';
                }, 2500);
              }).catch(() => {
                prompt('以下のテキストをコピーしてください:', cursorRules);
              });
            });
          }

          if (firstH1) {
            // 動的インフォグラフィック・アイキャッチカード（ByteByteGoスタイル）
            const slug = window.location.pathname.replace(/\/index\.html$/, '').split('/').filter(Boolean).pop();
            if (slug && slug !== 'auto-tech-radar' && !slug.includes('.')) {
              const infographDiv = document.createElement('div');
              infographDiv.style.cssText = 'margin: 1.5rem 0 2rem; border-radius: 12px; overflow: hidden; border: 1px solid #1e293b; background: #030712; box-shadow: 0 10px 30px -10px rgba(0,0,0,0.7); text-align: center;';
              infographDiv.innerHTML = `
                <img src="${esc(baseUrl)}/ogp/${esc(slug)}.svg" 
                     alt="${esc(articleTitle)} アーキテクチャ・商用分析インフォグラフィック" 
                     style="width: 100%; max-height: 420px; object-fit: cover; display: block;" 
                     onerror="this.parentElement.style.display='none';" />
                <div style="padding: 0.5rem 1rem; background: rgba(15, 23, 42, 0.95); font-size: 0.76rem; color: #94a3b8; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #1e293b;">
                  <span>📐 システム構成・商用指標インフォグラフィック</span>
                  <span style="color: #38bdf8; font-weight: 600;">Auto Tech Radar Intelligence</span>
                </div>
              `;
              firstH1.insertAdjacentElement('afterend', infographDiv);
              infographDiv.insertAdjacentElement('afterend', metaBar);
            } else {
              firstH1.insertAdjacentElement('afterend', metaBar);
            }
            metaBar.insertAdjacentElement('afterend', summaryBox);
            summaryBox.insertAdjacentElement('afterend', tocBox);
          } else {
            article.insertBefore(metaBar, article.firstChild);
            metaBar.insertAdjacentElement('afterend', summaryBox);
            summaryBox.insertAdjacentElement('afterend', tocBox);
          }
        }

      }
    </script>

    <!-- ByteByteGoモデル: Mermaid.js 動的アーキテクチャ図解レンダラー -->
    <script type="module" is:inline>
      import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10.9.8/dist/mermaid.esm.min.mjs';
      try {
        mermaid.initialize({
          startOnLoad: false,
          theme: 'dark',
          themeVariables: {
            darkMode: true,
            background: '#0f172a',
            primaryColor: '#3b82f6',
            primaryTextColor: '#f8fafc',
            primaryBorderColor: '#60a5fa',
            lineColor: '#93c5fd',
            secondaryColor: '#1e293b',
            tertiaryColor: '#111827'
          }
        });

        // pre code.language-mermaid および pre[data-language="mermaid"] を検出してSVGダイアグラムに変換
        const mermaidBlocks = document.querySelectorAll('pre code.language-mermaid, pre.mermaid, pre[data-language="mermaid"]');
        if (mermaidBlocks.length > 0) {
          for (let i = 0; i < mermaidBlocks.length; i++) {
            try {
              const block = mermaidBlocks[i];
              const pre = block.tagName === 'PRE' ? block : block.closest('pre');
              const code = block.textContent;
              const container = document.createElement('div');
              container.className = 'mermaid-container';
              container.style.cssText = 'background: #0f172a; border: 1px solid #1e293b; border-radius: 10px; padding: 1.5rem; margin: 1.8rem 0; overflow-x: auto; text-align: center;';
              const { svg } = await mermaid.render('mermaid-svg-' + i, code);
              container.innerHTML = svg;
              if (pre && pre.parentNode) {
                pre.parentNode.replaceChild(container, pre);
              }
            } catch (blockErr) {
              console.warn(`Mermaid rendering notice for block ${i}:`, blockErr);
            }
          }
        }
      } catch (err) {
        console.warn('Mermaid rendering notice:', err);
      }
    </script>
  </body>
