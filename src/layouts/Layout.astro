        background: #1f2937;
        color: #cbd5e1;
        padding: 0.2rem 0.5rem;
        border-radius: 6px;
        font-family: 'JetBrains Mono', monospace;
      }

      /* Article Markdown Content */
      article {
        background: var(--color-card);
        border: 1px solid var(--color-card-border);
        border-radius: 14px;
        padding: 2.2rem;
        margin-bottom: 2.5rem;
