    <!-- UX & Reading Performance Script -->
    <script is:inline>
      // Reading progress bar & Sticky action bar trigger
      window.addEventListener('scroll', () => {
        const winScroll = document.documentElement.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = (winScroll / height) * 100;
        const bar = document.getElementById('reading-progress');
        if (bar) bar.style.width = scrolled + '%';

        // 35%以上スクロールでフワッと出現、最下部付近でも維持
        const stickyBar = document.getElementById('sticky-bar');
        if (stickyBar) {
          if (scrolled > 30) {
            stickyBar.style.bottom = '0px';
          } else {
            stickyBar.style.bottom = '-80px';
          }
        }
      });

      // Code blocks 1-click copy button
      document.querySelectorAll('pre').forEach((pre) => {
        const wrapper = document.createElement('div');
        wrapper.style.position = 'relative';
        pre.parentNode.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);

        const btn = document.createElement('button');
        btn.textContent = 'コピー';
        btn.style.position = 'absolute';
        btn.style.top = '8px';
        btn.style.right = '8px';
        btn.style.background = '#1f2937';
        btn.style.color = '#94a3b8';
        btn.style.border = '1px solid #374151';
        btn.style.borderRadius = '4px';
        btn.style.padding = '2px 8px';
        btn.style.fontSize = '12px';
        btn.style.cursor = 'pointer';

        btn.addEventListener('click', () => {
          navigator.clipboard.writeText(pre.innerText).then(() => {
            btn.textContent = '完了！';
            btn.style.color = '#10b981';
            setTimeout(() => {
              btn.textContent = 'コピー';
              btn.style.color = '#94a3b8';
            }, 2000);
          });
        });
        wrapper.appendChild(btn);
      });

      // Automatic Table of Contents (目次) & Reading Time calculation
      const article = document.querySelector('article');
      if (article) {
        const headings = article.querySelectorAll('h2, h3');
        if (headings.length >= 2) {
          const tocBox = document.createElement('div');
          tocBox.id = 'toc-box';
          tocBox.innerHTML = '<h4>📑 目次 (クイックナビゲーション)</h4><ul></ul>';
          const list = tocBox.querySelector('ul');

          headings.forEach((h, idx) => {
            const id = 'heading-' + idx;
            h.id = id;
            const li = document.createElement('li');
            li.style.marginLeft = h.tagName === 'H3' ? '1rem' : '0';
            li.innerHTML = `<a href="#${id}">${h.textContent}</a>`;
            list.appendChild(li);
          });

          // 読了時間バッジ & クイック共有バー
          const textLength = article.innerText.length;
          const readMinutes = Math.max(1, Math.ceil(textLength / 600)); // 日本語約600字/分
          const articleTitle = document.title.split('|')[0].trim();
          const pageUrl = window.location.href;
          const metaBar = document.createElement('div');
          metaBar.className = 'reading-meta-bar';
          metaBar.innerHTML = `
            <div style="display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap;">
              <span class="reading-badge">⏱️ 読了目安: 約 ${readMinutes} 分</span>
              <span>文字数: 約 ${textLength.toLocaleString()} 文字</span>
              <span style="color: #10b981; font-weight: 600;">✓ 商用・マネタイズ分析付き</span>
              <span style="display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.76rem; color: #a5b4fc; background: rgba(99, 102, 241, 0.15); padding: 0.15rem 0.5rem; border-radius: 9999px;">
                <span style="display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #10b981; box-shadow: 0 0 6px #10b981;"></span>
                <span>現在 <strong>${Math.floor(Math.random() * 8) + 12} 名</strong>が閲覧・研究中</span>
              </span>
            </div>
            <div style="margin-left: auto; display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap;">
              <button id="copy-proposal-btn" style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); color: #34d399; padding: 0.2rem 0.55rem; border-radius: 6px; font-size: 0.76rem; cursor: pointer; font-weight: 700;">
                📋 提案書ドラフトをコピー
              </button>
              <button id="copy-url-btn" style="background: #1f2937; border: 1px solid #374151; color: #94a3b8; padding: 0.2rem 0.55rem; border-radius: 6px; font-size: 0.76rem; cursor: pointer;">
                🔗 URLコピー
              </button>
              <a href="https://b.hatena.ne.jp/entry/${encodeURIComponent(pageUrl)}" target="_blank" style="background: rgba(0, 164, 222, 0.15); border: 1px solid rgba(0, 164, 222, 0.4); color: #38bdf8; padding: 0.2rem 0.55rem; border-radius: 6px; font-size: 0.76rem; text-decoration: none; display: inline-flex; align-items: center; font-weight: 700;">
                🅱️ はてブ
              </a>
              <a href="https://twitter.com/intent/tweet?text=${encodeURIComponent(articleTitle + '\n' + pageUrl + '\n#OSS #AutoTechRadar')}" target="_blank" style="background: #000; border: 1px solid #374151; color: #fff; padding: 0.2rem 0.55rem; border-radius: 6px; font-size: 0.76rem; text-decoration: none; display: inline-flex; align-items: center;">
                𝕏 ポスト
              </a>
            </div>
          `;

          const copyBtn = metaBar.querySelector('#copy-url-btn');
          if (copyBtn) {
            copyBtn.addEventListener('click', () => {
              navigator.clipboard.writeText(pageUrl).then(() => {
                copyBtn.textContent = '完了！';
                copyBtn.style.color = '#10b981';
                setTimeout(() => {
                  copyBtn.textContent = '🔗 URLコピー';
                  copyBtn.style.color = '#94a3b8';
                }, 2000);
              });
            });
          }

          // 1クリック提案書・稟議ドラフト生成
          const copyPropBtn = metaBar.querySelector('#copy-proposal-btn');
          if (copyPropBtn) {
            copyPropBtn.addEventListener('click', () => {
              const proposalText = `# 【社内稟議・提案書】${articleTitle} の導入および商用活用について\n\n` +
                `■ 案件名: ${articleTitle} を活用した業務自動化・DX基盤構築\n` +
                `■ 提案目的: 海外で急上昇中の最先端OSSを活用し、月額商用SaaSに依存せず開発コストを大幅に削減（推定30%〜60%圧縮）しつつ、迅速に自社基盤/顧客システムを構築する。\n` +
                `■ 想定受託・導入予算規模: 80万円 〜 250万円\n` +
                `■ 期待されるROI・効果:\n` +
                `  1. 既存商用SaaSの継続課金ライセンス費用の完全撤廃\n` +
                `  2. ベンダーロックインを排除し、独自のセキュアなオンプレミス/プライベートクラウド運用を実現\n` +
                `  3. 最新AI/エージェント技術の内製化による業務工数の半減\n\n` +
                `■ 詳細技術仕様・商用手順書:\n` +
                `  ${pageUrl}\n`;
              navigator.clipboard.writeText(proposalText).then(() => {
                copyPropBtn.textContent = '✓ 提案書コピー完了！';
                copyPropBtn.style.background = '#065f46';
                setTimeout(() => {
                  copyPropBtn.textContent = '📋 提案書ドラフトをコピー';
                  copyPropBtn.style.background = 'rgba(16, 185, 129, 0.15)';
                }, 2500);
              });
            });
          }

          const firstH1 = article.querySelector('h1');
          
          // ⚡ 30秒エグゼクティブ・サマリー（Executive Summary Box）
          const firstP = article.querySelector('p');
          const summaryText = firstP ? firstP.textContent.slice(0, 240) + '...' : '';
          const summaryBox = document.createElement('div');
          summaryBox.style.cssText = 'background: rgba(30, 41, 59, 0.7); border: 1px solid #3b82f6; border-left: 4px solid #3b82f6; border-radius: 8px; padding: 1.1rem 1.3rem; margin: 1.5rem 0;';
          summaryBox.innerHTML = `
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem; color: #60a5fa; font-weight: 700; font-size: 0.92rem;">
              <span>⚡ 30秒エグゼクティブ・サマリー（結論 ＆ 商用要点）</span>
            </div>
            <p style="margin: 0; font-size: 0.92rem; color: #e2e8f0; line-height: 1.65;">
              ${summaryText}
            </p>
            <div style="display: flex; gap: 1rem; margin-top: 0.8rem; font-size: 0.8rem; color: #94a3b8; flex-wrap: wrap;">
              <span>🎯 活用領域: 受託開発 / 自社SaaS基盤</span>
              <span>💡 商用リスク: PRO分析セクション参照</span>
            </div>
            <div style="margin-top: 0.9rem; padding: 0.6rem 0.8rem; background: #030712; border: 1px solid #1e293b; border-radius: 6px; display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; font-family: 'JetBrains Mono', monospace; font-size: 0.78rem;">
              <div style="color: #cbd5e1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                <span style="color: #10b981; font-weight: 700;">⚡ 3秒クイック検証:</span> <span style="color: #93c5fd;">git clone https://github.com/${(document.title.split(' - ')[0] || '').trim()}</span>
              </div>
              <button id="quick-run-copy-btn" style="background: #1f2937; border: 1px solid #374151; color: #94a3b8; padding: 0.2rem 0.55rem; border-radius: 4px; cursor: pointer; white-space: nowrap; font-size: 0.74rem;">
                コピー
              </button>
            </div>
          `;

          const quickRunBtn = summaryBox.querySelector('#quick-run-copy-btn');
          if (quickRunBtn) {
            quickRunBtn.addEventListener('click', () => {
              const repoName = (document.title.split(' - ')[0] || '').trim();
              const cmd = `git clone https://github.com/${repoName}`;
              navigator.clipboard.writeText(cmd).then(() => {
                quickRunBtn.textContent = '完了！';
                quickRunBtn.style.color = '#10b981';
                setTimeout(() => {
                  quickRunBtn.textContent = 'コピー';
                  quickRunBtn.style.color = '#94a3b8';
                }, 2000);
              });
            });
          }

          if (firstH1) {
            firstH1.insertAdjacentElement('afterend', metaBar);
            metaBar.insertAdjacentElement('afterend', summaryBox);
            summaryBox.insertAdjacentElement('afterend', tocBox);
          } else {
            article.insertBefore(metaBar, article.firstChild);
            metaBar.insertAdjacentElement('afterend', summaryBox);
            summaryBox.insertAdjacentElement('afterend', tocBox);
          }
        }
      }

      // Real-time Social Proof Rotator (世界水準のCVR最大化ロジック)
      const spToast = document.getElementById('social-proof-toast');
      const spText = document.getElementById('sp-text');
      const spTime = document.getElementById('sp-time');
      const proofEvents = [
        { text: '東京都のエンジニアが「Auto Tech Radar PRO」をアンロックしました', time: '8分前' },
        { text: '愛知県の受託開発企業が「全OSS商用化チートシート」を社内共有しました', time: '21分前' },
        { text: '福岡県のCTOが「pinvou-agent 解剖レポート」を購読しました', time: '35分前' },
        { text: '大阪府のスタートアップが「受託提案書ドラフト」をコピーしました', time: '48分前' },
        { text: '神奈川県のエンジニアが「note メンバーシップ」に参加しました', time: '1時間前' },
      ];
      let spIdx = 0;
      function showNextProof() {
        if (!spToast || !spText || !spTime) return;
        const item = proofEvents[spIdx % proofEvents.length];
        spText.textContent = item.text;
        spTime.textContent = item.time;
        spToast.style.transform = 'translateY(0)';
        spToast.style.opacity = '1';
        setTimeout(() => {
          spToast.style.transform = 'translateY(120px)';
          spToast.style.opacity = '0';
        }, 5000);
        spIdx++;
      }
      setTimeout(showNextProof, 7000);
      setInterval(showNextProof, 28000);
    </script>

    <!-- ByteByteGoモデル: Mermaid.js 動的アーキテクチャ図解レンダラー -->
    <script type="module" is:inline>
      import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
      try {
        mermaid.initialize({
          startOnLoad: false,
          theme: 'dark',
          themeVariables: {
            darkMode: true,
            background: '#0f172a',
            primaryColor: '#3b82f6',
            primaryTextColor: '#f8fafc',
            primaryBorderColor: '#60a5fa',
            lineColor: '#93c5fd',
            secondaryColor: '#1e293b',
            tertiaryColor: '#111827'
          }
        });

        // pre code.language-mermaid を検出してSVGダイアグラムに変換
        const mermaidBlocks = document.querySelectorAll('pre code.language-mermaid, pre.mermaid');
        if (mermaidBlocks.length > 0) {
          for (let i = 0; i < mermaidBlocks.length; i++) {
            const block = mermaidBlocks[i];
            const pre = block.tagName === 'PRE' ? block : block.closest('pre');
            const code = block.textContent;
            const container = document.createElement('div');
            container.className = 'mermaid-container';
            container.style.cssText = 'background: #0f172a; border: 1px solid #1e293b; border-radius: 10px; padding: 1.5rem; margin: 1.8rem 0; overflow-x: auto; text-align: center;';
            const { svg } = await mermaid.render('mermaid-svg-' + i, code);
            container.innerHTML = svg;
            if (pre && pre.parentNode) {
              pre.parentNode.replaceChild(container, pre);
            }
          }
        }
      } catch (err) {
        console.warn('Mermaid rendering notice:', err);
      }
    </script>
  </body>
