---
const { title, description, frontmatter } = Astro.props;
const pageTitle = title || frontmatter?.title || "Auto Tech Radar | 海外急上昇OSS徹底解剖メディア";
const pageDesc = description || frontmatter?.description || "世界のGitHubトレンドから急上昇OSSを毎朝AIが自動検出し、日本語技術アーキテクチャ解説と受託・SaaSマネタイズ実践法をお届けします。";
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

// 関連記事（Read Next）の推薦ロジック
const isArticle = !!frontmatter;
let relatedPosts: any[] = [];
if (isArticle) {
  const allModules = import.meta.glob("../pages/radar/*.md", { eager: true });
  const allPosts = Object.values(allModules) as any[];
  const currentTags = Array.isArray(frontmatter.tags) ? frontmatter.tags.map((t: string) => t.toLowerCase()) : [];
  const currentTitle = (frontmatter.title || "").toLowerCase();

  // 自記事を除外し、タグ一致スコアまたは最新順でスコアリング
  relatedPosts = allPosts
    .filter(p => p.frontmatter && (p.frontmatter.title || "") !== frontmatter.title)
    .map(p => {
      const pTags = Array.isArray(p.frontmatter?.tags) ? p.frontmatter.tags.map((t: string) => t.toLowerCase()) : [];
      let score = 0;
      currentTags.forEach(ct => {
        if (pTags.includes(ct)) score += 2;
      });
      return { post: p, score };
    })
    .sort((a, b) => b.score - a.score)
    .slice(0, 3)
    .map(item => item.post);
}

// 動的OGP画像
const currentSlug = Astro.url.pathname.split('/').filter(Boolean).pop() || '';
const ogImage = (isArticle && currentSlug && currentSlug !== 'auto-tech-radar') 
  ? `https://ssk0224.github.io/auto-tech-radar/ogp/${currentSlug}.svg` 
  : "https://ssk0224.github.io/auto-tech-radar/og-card.svg";
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
