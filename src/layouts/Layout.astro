        border-color: #6366f1;
        background: rgba(30, 27, 75, 0.6);
        position: relative;
      }
      .badge-rec {
        position: absolute;
        top: -10px;
        right: 12px;
        background: #6366f1;
        color: #fff;
        font-size: 0.7rem;
        padding: 0.15rem 0.5rem;
        border-radius: 9999px;
        font-weight: 700;
      }
      .price-card h4 { margin: 0 0 0.4rem; font-size: 1.05rem; color: #fff; }
      .price-val { font-size: 1.6rem; font-weight: 800; color: #38bdf8; margin-bottom: 0.6rem; }
      .price-val span { font-size: 0.85rem; color: #94a3b8; font-weight: normal; }
      .feature-list { list-style: none; padding: 0; margin: 0 0 1.2rem; font-size: 0.85rem; color: #cbd5e1; }
      .feature-list li { margin-bottom: 0.4rem; display: flex; align-items: center; gap: 0.4rem; }
      .cta-btn {
        display: block;
        text-align: center;
        padding: 0.75rem 1rem;
        border-radius: 8px;
        font-weight: 700;
        font-size: 0.92rem;
        text-decoration: none !important;
        transition: transform 0.1s, filter 0.15s;
      }
      .cta-btn:hover { transform: translateY(-1px); filter: brightness(1.1); }
      .cta-primary { background: #635bff; color: #fff !important; }
      .cta-note { background: #2cb696; color: #fff !important; }

      footer {
        margin-top: 4rem;
        font-size: 0.88rem;
        color: var(--color-text-muted);
        border-top: 1px solid var(--color-border);
        padding-top: 1.8rem;
        text-align: center;
      }
      /* Reading progress bar */
      #reading-progress {
        position: fixed;
        top: 0;
        left: 0;
        height: 3px;
        background: linear-gradient(90deg, #3b82f6, #10b981);
        width: 0%;
        z-index: 9999;
        transition: width 0.1s ease;
      }
      /* Reading time badge & Table of Contents */
      .reading-meta-bar {
        display: flex;
        gap: 0.8rem;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 0.8rem;
        border-bottom: 1px solid var(--color-border);
        font-size: 0.82rem;
        color: var(--color-text-muted);
        flex-wrap: wrap;
      }
      .reading-badge {
        background: rgba(59, 130, 246, 0.15);
        color: #93c5fd;
        padding: 0.2rem 0.5rem;
        border-radius: 6px;
        font-weight: 600;
      }
      #toc-box {
        background: rgba(17, 24, 39, 0.7);
        border: 1px solid #1f2937;
        border-radius: 10px;
        padding: 1.2rem 1.4rem;
        margin: 1.5rem 0 2rem;
      }
      #toc-box h4 {
        margin: 0 0 0.8rem;
        font-size: 0.95rem;
        color: #e2e8f0;
        display: flex;
        align-items: center;
