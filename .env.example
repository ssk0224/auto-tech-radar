# ==========================================
# Auto Tech Radar Environment Configuration
# ==========================================

# Google Gemini API Key (Required for crawler & content generation)
# Get your API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Personal Access Token (Optional: avoids GitHub Search API rate limits)
# Required scopes: repo / public_repo
GH_PAT=your_github_pat_token_here

# X (Twitter) API v2 Credentials (Optional: for automated tweeting in CI)
# Apply at https://developer.x.com/
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here
