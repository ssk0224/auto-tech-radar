{
  "name": "auto-tech-radar",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/audit_quality.mjs && astro build && node scripts/audit_dist.mjs",
    "crawl": "node scripts/crawl_and_generate.mjs",
    "audit": "node scripts/audit_quality.mjs && node scripts/audit_dist.mjs",
    "vault:open": "node scripts/note_vault.mjs open-all",
    "vault:seal": "node scripts/note_vault.mjs seal-all",
    "vault:rotate": "node scripts/note_vault.mjs rotate",
    "vault:reseal": "node scripts/note_vault.mjs reseal",
    "note:sync": "node scripts/sync_note_urls.mjs",
    "note:serve": "node scripts/note_api_server.mjs",
    "test": "node --import ./tests/helpers/test_env.mjs --test-reporter ./tests/helpers/skip_gate_reporter.mjs --test tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@google/genai": "^2.28.0",
    "astro": "^7.3.8",
    "dotenv": "^16.4.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "mermaid": "10.9.8",
    "playwright-core": "1.56.1"
  }
}
