  "install_blocks": [
    {
      "lang": "sh",
      "code": "git clone https://github.com/storytold/photocraft\ncd photocraft\ncargo run --release -p photocraft -- image.psd   # the desktop app\ncargo test --workspace                           # the test suite"
    },
    {
      "lang": "sh",
      "code": "git clone https://github.com/storytold/craft-fonts ../craft-fonts\nCRAFT_FONTS_DIR=\"$PWD/../craft-fonts\" cargo run --release -p photocraft"
    },
    {
      "lang": "sh",
      "code": "flatpak install --user photocraft-<version>-linux-x86_64.flatpak   # or -linux-aarch64\nflatpak run ai.storyteller.photocraft"
    },
    {
      "lang": "sh",
      "code": "ditto -x -k photocraft-cli-<version>-macos-universal.zip .\nspctl --assess --type install -vv photocraft-cli-<version>-macos-universal/photocraft-cli\n# ... accepted, source=Notarized Developer ID"
    }
  ]
}
