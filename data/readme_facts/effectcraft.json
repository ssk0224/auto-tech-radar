  "install_blocks": [
    {
      "lang": "sh",
      "code": "eselect repository add snakebyte git https://github.com/switch87/snakebyte-overlay.git\nemaint sync -r snakebyte\necho 'media-video/effectcraft-bin ~amd64' >> /etc/portage/package.accept_keywords/effectcraft\nemerge --ask media-video/effectcraft-bin"
    },
    {
      "lang": "sh",
      "code": "git clone https://github.com/storytold/effectcraft\ncd effectcraft\ncargo run --release -p effectcraft          # the app (add `-- --demo` to open the demo project)\ncargo run --release -p effectcraft-cli -- render --out intro.mp4    # render the demo headless\ncargo xtask web --serve 8765                # the browser build on http://127.0.0.1:8765/ (docs/web.md)"
    }
  ]
