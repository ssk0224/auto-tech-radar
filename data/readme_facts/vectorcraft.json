  "install_blocks": [
    {
      "lang": "sh",
      "code": "git clone https://github.com/storytold/vectorcraft\ncd vectorcraft\n\ncargo run --release -p vectorcraft                          # desktop app\ncargo run --release -p vectorcraft -- examples/dusk-poster.vectorcraft\ncargo run --release -p vectorcraft -- --control 7979        # + JSON control channel\ncargo run --release -p vectorcraft-cli -- mcp               # MCP server (stdio)\ncargo run --release -p vectorcraft-cli -- run --in examples/ribbons.vectorcraft --export out.pdf   # headless batch\ncargo run --release -p vectorcraft-cli -- bench examples/neon-drive.vectorcraft                   # render timing\ncargo xtask bundle                                        # dist/VectorCraft.app (macOS)\ncd apps/vectorcraft-web && trunk build --release            # web build → dist/web\ncargo xtask ci                                            # fmt, clippy, tests, layering, wasm, vendor names"
    },
    {
      "lang": "sh",
      "code": "claude mcp add vectorcraft -- /path/to/vectorcraft-cli mcp"
    },
    {
      "lang": "sh",
      "code": "claude mcp add vectorcraft -- /path/to/vectorcraft-cli mcp --automation-read-root /work/project --automation-write-root /work/project"
