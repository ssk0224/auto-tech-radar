  "install_blocks": [
    {
      "lang": "sh",
      "code": "git clone https://github.com/storytold/lightcraft && cd lightcraft\ncargo run --release -p lightcraft                       # opens your library (~/Pictures/LightCraft Library; a new one starts with demo photos)\ncargo run --release -p lightcraft -- ~/Pictures/trip    # import your photos (folders are scanned, duplicates skipped)\ncargo run --release -p lightcraft -- --memory           # a throwaway in-memory demo session (writes nothing)\ncargo run --release -p lightcraft -- --control 7980     # with the automation channel\ncargo xtask web --serve                                 # the same app in the browser: http://127.0.0.1:8080/\ncargo run --release -p lightcraft-cli -- render photo.jpg -o out.jpg --set light.exposure=0.5\ncargo xtask ci                                          # fmt, clippy, HEIF, tests, parity, layers, assets, WASM"
    },
    {
      "lang": "sh",
      "code": "CARGO_BUILD_JOBS=1 cargo build --release -p lightcraft -p lightcraft-cli\n# Alternatively: CARGO_BUILD_JOBS=2 cargo build --release -p lightcraft -p lightcraft-cli"
    },
    {
      "lang": "sh",
      "code": "CARGO_BUILD_JOBS=1 CARGO_PROFILE_RELEASE_DEBUG=0 CARGO_PROFILE_RELEASE_LTO=false CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16 cargo build --release -p lightcraft -p lightcraft-cli"
    },
    {
      "lang": "sh",
      "code": "git clone https://github.com/storytold/craft-fonts ../craft-fonts\nCRAFT_FONTS_DIR=../craft-fonts cargo run --release -p lightcraft"
    }
  ]
