  "install_blocks": [
    {
      "lang": "sh",
      "code": "git clone https://github.com/storytold/pdfcraft\ncd pdfcraft\ncargo xtask models                                # fetch the OCR models Scan & OCR needs (release builds include them)\ncargo run --release -p pdfcraft -- some.pdf     # desktop app\ncargo xtask demo-pdf                              # build the showcase PDF used in these screenshots\ncargo xtask screenshots                           # regenerate every screenshot in this README"
    },
    {
      "lang": "sh",
      "code": "git clone https://github.com/storytold/craft-fonts ../craft-fonts\nCRAFT_FONTS_DIR=../craft-fonts cargo run --release -p pdfcraft -- some.pdf"
    },
    {
      "lang": "sh",
      "code": "eselect repository add snakebyte git https://github.com/switch87/snakebyte-overlay.git\nemaint sync -r snakebyte\necho 'app-text/pdfcraft-bin ~amd64' >> /etc/portage/package.accept_keywords/pdfcraft\nemerge --ask app-text/pdfcraft-bin"
    }
  ]
}
