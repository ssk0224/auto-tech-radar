  "install_blocks": [
    {
      "lang": "sh",
      "code": "git clone https://github.com/storytold/wordcraft\ncd wordcraft\ncargo run --release -p wordcraft -- --sample        # the desktop app with the sample document\ncargo run --release -p wordcraft -- report.docx     # open a document"
    },
    {
      "lang": "sh",
      "code": "wordcraft-cli convert report.docx report.pdf        # docx, pdf, odt, rtf, html, md, tex, txt, png\nwordcraft-cli text report.docx                      # plain text\nwordcraft-cli inspect report.docx                   # structure as JSON\nwordcraft-cli run --template sample \\\n  --cmd 'select.text={\"text\":\"Membership\"}' --cmd format.bold --save out.docx\nwordcraft-cli run --script job.json                 # the same from a file: commands, then save to docx and pdf"
    }
  ],
